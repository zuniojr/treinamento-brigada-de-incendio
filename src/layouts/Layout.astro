---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
  canonicalURL?: string;
}

const {
  title = "Treinamento de Brigada de Incêndio para Empresas | NR-23 & NBR 14276",
  description = "Especialistas em Treinamento de Brigada de Incêndio corporativo para empresas de todos os portes. Atenda a NR-23 com instrutores qualificados, simulação prática e certificação válida em todo Brasil.",
  keywords = "treinamento de brigada de incendio, brigada de incendio, curso brigada de incendio, treinamento NR-23, combate a incendio, prevencao contra incendio, brigadista, treinamento corporativo, empresa de brigada de incendio, curso de prevencao e combate a incendio, treinamento de emergencia, plano de abandono, primeiros socorros para empresas",
  image = "https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?auto=format&fit=crop&w=1200&q=80",
  canonicalURL = "https://treinamentobrigadadeincendio.com.br"
} = Astro.props;

// Schema.org JSON-LD Structured Data
const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "EducationalOrganization",
      "@id": "https://treinamentobrigadadeincendio.com.br/#organization",
      "name": "Treinamento de Brigada de Incêndio Corporativo",
      "url": "https://treinamentobrigadadeincendio.com.br",
      "logo": "https://treinamentobrigadadeincendio.com.br/favicon.svg",
      "description": "Empresa especializada em treinamento corporativo de prevenção e combate a incêndio, formação de brigadistas e primeiros socorros conforme a NR-23.",
      "telephone": "+5511999999999",
      "priceRange": "$$$",
      "address": {
        "@type": "PostalAddress",
        "addressCountry": "BR"
      },
      "areaServed": "BR",
      "sameAs": [
        "https://instagram.com",
        "https://linkedin.com"
      ]
    },
    {
      "@type": "Course",
      "@id": "https://treinamentobrigadadeincendio.com.br/#course",
      "name": "Treinamento de Formação e Atualização de Brigada de Incêndio (NR-23)",
      "description": "Curso prático e teórico de prevenção e combate a incêndio, evacuação de emergência e primeiros socorros corporativos.",
      "provider": {
        "@type": "Organization",
        "name": "Treinamento de Brigada de Incêndio",
        "sameAs": "https://treinamentobrigadadeincendio.com.br"
      },
      "hasCourseInstance": {
        "@type": "CourseInstance",
        "courseMode": "InPerson",
        "courseWorkload": "PT8H"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Início",
          "item": "https://treinamentobrigadadeincendio.com.br"
        }
      ]
    }
  ]
};
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Treinamento de Brigada de Incêndio Corporativo" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="pt_BR" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Pular para o conteúdo principal</a>
    
    <slot />

    <!-- Global Scroll Animation Observer -->
    <script is:inline>
      (function () {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );

        function observe() {
          document.querySelectorAll('[data-animate]').forEach((el) => {
            observer.observe(el);
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', observe);
        } else {
          observe();
        }
      })();
    </script>

    <style>
      .skip-link {
        position: absolute;
        top: -40px;
        left: 0;
        background: #0EA5E9;
        color: white;
        padding: 8px;
        z-index: 10000;
        transition: top 0.3s;
      }
      .skip-link:focus {
        top: 0;
      }
    </style>
  </body>
</html>
