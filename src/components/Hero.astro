---
---

<section class="hero">
  <!-- Hero Background Overlay & Realistic Firefighter Training Image -->
  <div class="hero-bg">
    <img 
      src="https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?auto=format&fit=crop&w=1920&q=85" 
      alt="Brigada de incêndio corporativa em treinamento prático com equipamentos de combate" 
      class="hero-img"
      loading="eager"
      width="1920"
      height="1080"
    />
    <div class="hero-overlay"></div>
    <div class="hero-glow"></div>
  </div>

  <div class="container hero-container">
    <div class="hero-content">
      <!-- Yellow Alert Badge (Strictly for NR-23 Norms) -->
      <div class="badge-alert hero-badge" data-animate="fade-down" data-delay="100">
        <span class="dot"></span>
        <span>Atendimento às Normas NR-23 & NBR 14276</span>
      </div>

      <h1 class="hero-title" data-animate="fade-up" data-delay="150">
        Treinamento de Brigada de Incêndio <span class="highlight-blue">para Empresas</span>
      </h1>

      <p class="hero-subtitle" data-animate="fade-up" data-delay="200">
        Capacite sua equipe com treinamentos teóricos e práticos de alto nível. Proteja vidas, garanta a conformidade legal do seu estabelecimento e preserve o patrimônio corporativo contra emergências.
      </p>

      <div class="hero-actions" data-animate="fade-up" data-delay="280">
        <button onclick="openQuoteModal()" class="btn btn-primary btn-hero">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
          <span>Solicitar Orçamento</span>
        </button>

        <a 
          href="https://wa.me/5511999999999?text=Ol%C3%A1!%20Gostaria%20de%20um%20or%C3%A7amento%20para%20Treinamento%20de%20Brigada%20de%20Inc%C3%AAndio%20para%20minha%20empresa." 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn btn-whatsapp btn-hero"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
          <span>Falar pelo WhatsApp</span>
        </a>
      </div>

      <!-- Trust Metrics Grid -->
      <div class="hero-stats" data-animate="fade-up" data-delay="400">
        <div class="stat-item">
          <div class="stat-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#E61919" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          </div>
          <div>
            <span class="stat-value">100%</span>
            <span class="stat-label">Conformidade NR-23</span>
          </div>
        </div>

        <div class="stat-item">
          <div class="stat-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#E61919" stroke-width="2.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          </div>
          <div>
            <span class="stat-value"><span class="hero-counter" data-counter-target="1500" data-counter-prefix="+" data-counter-suffix="">+0</span></span>
            <span class="stat-label">Empresas Treinadas</span>
          </div>
        </div>

        <div class="stat-item">
          <div class="stat-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#E61919" stroke-width="2.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
          </div>
          <div>
            <span class="stat-value"><span class="hero-counter" data-counter-target="15" data-counter-prefix="" data-counter-suffix=" anos">0 anos</span></span>
            <span class="stat-label">de Experiência</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    function easeOutExpo(t) { return t === 1 ? 1 : 1 - Math.pow(2, -10 * t); }

    function runCounter(el) {
      var target = parseInt(el.dataset.counterTarget, 10);
      var prefix = el.dataset.counterPrefix || '';
      var suffix = el.dataset.counterSuffix || '';
      var duration = 1600;
      var start = performance.now();

      function tick(now) {
        var p = Math.min((now - start) / duration, 1);
        var val = Math.round(easeOutExpo(p) * target);
        var fmt = val >= 1000 ? val.toLocaleString('pt-BR') : String(val);
        el.textContent = prefix + fmt + suffix;
        if (p < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }

    var els = document.querySelectorAll('.hero-counter');
    if (!els.length) return;
    var obs = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { runCounter(e.target); obs.unobserve(e.target); }
      });
    }, { threshold: 0.5 });
    els.forEach(function (el) { obs.observe(el); });
  })();
</script>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 8rem;
    padding-bottom: 5rem;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: brightness(0.65) contrast(1.1);
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      180deg, 
      rgba(11, 17, 32, 0.85) 0%, 
      rgba(11, 17, 32, 0.75) 50%, 
      rgba(11, 17, 32, 1) 100%
    );
  }

  .hero-glow {
    position: absolute;
    top: 20%;
    left: 10%;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(230, 25, 25, 0.25) 0%, rgba(0, 0, 0, 0) 70%);
    filter: blur(60px);
    pointer-events: none;
  }

  .hero-container {
    position: relative;
    z-index: 2;
  }

  .hero-content {
    max-width: 860px;
  }

  .hero-badge {
    margin-bottom: 1.5rem;
  }

  .hero-title {
    font-size: 3.5rem;
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 1.5rem;
    color: #FFFFFF;
    letter-spacing: -0.03em;
  }

  .highlight-blue {
    background: linear-gradient(135deg, #FF4D4D 0%, #991B1B 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 2.5rem;
    max-width: 760px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-bottom: 3.5rem;
  }

  .btn-hero {
    padding: 1.1rem 2.2rem;
    font-size: 1.05rem;
  }

  /* Stats Grid */
  .hero-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-light);
  }

  .stat-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: rgba(15, 23, 42, 0.6);
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    backdrop-filter: blur(10px);
  }

  .stat-icon {
    width: 48px;
    height: 48px;
    background: rgba(230, 25, 25, 0.12);
    border: 1px solid rgba(230, 25, 25, 0.25);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .stat-value {
    display: block;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-main);
    line-height: 1.2;
  }

  .stat-label {
    display: block;
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  @media (max-width: 992px) {
    .hero-title {
      font-size: 2.6rem;
    }
    .hero-subtitle {
      font-size: 1.1rem;
    }
  }

  @media (max-width: 576px) {
    .hero {
      padding-top: 6.5rem;
    }
    .hero-title {
      font-size: 2.1rem;
    }
    .hero-actions {
      flex-direction: column;
      width: 100%;
    }
    .btn-hero {
      width: 100%;
    }
  }
</style>
