---
interface Props {
  badge?: string;
  titleSolid?: string;
  titleStroke?: string;
  titleSub?: string;
  subtitle?: string;
  image?: string;
  primaryCtaText?: string;
  secondaryCtaText?: string;
  secondaryCtaLink?: string;
  showStats?: boolean;
}

const {
  badge = "CAPACITAÇÃO · NR-23 & NBR 14276",
  titleSolid = "TREINAMENTO DE",
  titleStroke = "BRIGADA DE INCÊNDIO",
  titleSub = "PREVENÇÃO, COMBATE & EMERGÊNCIA CORPORATIVA",
  subtitle = "Capacite sua equipe com treinamentos teóricos e práticos de alto nível. Proteja vidas, garanta a conformidade legal e preserve o patrimônio corporativo contra emergências.",
  image = "/banner-bombeiros-hero.png",
  primaryCtaText = "Solicitar Orçamento",
  secondaryCtaText = "Falar no WhatsApp",
  secondaryCtaLink = "https://bitlybr.net/TreinamentoBrigada",
  showStats = true
} = Astro.props;
---

<section class="hero">
  <!-- Background -->
  <div class="hero-bg">
    <!-- Main overlay gradient -->
    <div class="hero-overlay"></div>
    <!-- Diagonal flame accent (signature element) -->
    <div class="hero-diagonal"></div>
    <!-- Ambient glow -->
    <div class="hero-glow"></div>
  </div>

  <div class="container hero-container">
    <div class="hero-grid">
      <div class="hero-image-wrapper" data-animate="fade-right" data-delay="300">
        <div class="hero-image-glow"></div>
        <img
          src="/brigadadeincendio.png"
          alt="Treinamento de Brigada de Incêndio"
          class="hero-poster-img"
          width="500"
          height="500"
        />
      </div>

      <div class="hero-content">
        <!-- Selo Pílula estilo Regê Engenharia -->
        <div class="pill-badge hero-badge" data-animate="fade-down" data-delay="100">
          <span class="pill-dot"></span>
          <span>{badge}</span>
        </div>

        <!-- Main title estilo Regê Engenharia -->
        <h1 class="hero-title" data-animate="fade-up" data-delay="150">
          <span class="hero-title-solid">{titleSolid}</span>
          <span class="hero-title-stroke">{titleStroke}</span>
          {titleSub && <span class="hero-title-sub">{titleSub}</span>}
        </h1>

        <p class="hero-subtitle" data-animate="fade-up" data-delay="220">
          {subtitle}
        </p>

        <div class="hero-actions" data-animate="fade-up" data-delay="300">
          <button onclick="openQuoteModal()" class="btn btn-primary btn-hero" id="hero-cta-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
            <span>{primaryCtaText}</span>
          </button>

          <a
            href={secondaryCtaLink}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-whatsapp btn-hero"
            id="hero-cta-whatsapp"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
            <span>{secondaryCtaText}</span>
          </a>
        </div>

        {showStats && (
          <div class="hero-stats" data-animate="fade-up" data-delay="420">
            <div class="stat-item">
              <div class="stat-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
              </div>
              <div>
                <span class="stat-value">100%</span>
                <span class="stat-label">Conformidade NR-23</span>
              </div>
            </div>

            <div class="stat-sep"></div>

            <div class="stat-item">
              <div class="stat-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
              </div>
              <div>
                <span class="stat-value">
                  <span class="hero-counter" data-counter-target="1500" data-counter-prefix="+" data-counter-suffix="">+0</span>
                </span>
                <span class="stat-label">Empresas Treinadas</span>
              </div>
            </div>

            <div class="stat-sep"></div>

            <div class="stat-item">
              <div class="stat-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
              </div>
              <div>
                <span class="stat-value">
                  <span class="hero-counter" data-counter-target="15" data-counter-prefix="" data-counter-suffix=" anos">0 anos</span>
                </span>
                <span class="stat-label">de Experiência</span>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="hero-scroll-indicator" aria-hidden="true">
    <span class="scroll-label">Role para explorar</span>
    <div class="scroll-chevrons">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    function easeOutExpo(t) { return t === 1 ? 1 : 1 - Math.pow(2, -10 * t); }
    function runCounter(el) {
      var target = parseInt(el.dataset.counterTarget, 10);
      var prefix = el.dataset.counterPrefix || '';
      var suffix = el.dataset.counterSuffix || '';
      var duration = 1800;
      var start = performance.now();
      function tick(now) {
        var p = Math.min((now - start) / duration, 1);
        var val = Math.round(easeOutExpo(p) * target);
        var fmt = val >= 1000 ? val.toLocaleString('pt-BR') : String(val);
        el.textContent = prefix + fmt + suffix;
        if (p < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }
    var els = document.querySelectorAll('.hero-counter');
    if (!els.length) return;
    var obs = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { runCounter(e.target); obs.unobserve(e.target); }
      });
    }, { threshold: 0.5 });
    els.forEach(function (el) { obs.observe(el); });
  })();
</script>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 5.5rem;
    padding-bottom: 7rem;
    overflow: hidden;
    background-color: #000000;
  }

  /* ---- Background ---- */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-color: #000000;
  }

  .hero-img {
    display: none;
  }

  /* Main gradient overlay — clean black ambient */
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 70% 50%, rgba(20, 20, 20, 0.8) 0%, rgba(0, 0, 0, 1) 70%);
  }

  /* Diagonal flame accent — signature element */
  .hero-diagonal {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      108deg,
      transparent 50%,
      rgba(230, 48, 0, 0.10) 50%,
      rgba(230, 48, 0, 0.05) 65%,
      transparent 80%
    );
    pointer-events: none;
  }

  .hero-glow {
    position: absolute;
    top: 15%;
    right: 5%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(230, 48, 0, 0.15) 0%, transparent 65%);
    filter: blur(70px);
    pointer-events: none;
  }

  /* ---- Content ---- */
  .hero-container {
    position: relative;
    z-index: 2;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 3rem;
    align-items: center;
  }

  .hero-content {
    width: 100%;
  }

  .hero-image-wrapper {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    max-width: 450px;
    margin-right: auto;
    margin-left: 0;
  }

  .hero-image-glow {
    position: absolute;
    inset: -20px;
    background: radial-gradient(circle, rgba(230, 48, 0, 0.25) 0%, transparent 70%);
    filter: blur(30px);
    z-index: 1;
    pointer-events: none;
    animation: pulse-glow 4s ease-in-out infinite;
  }

  .hero-poster-img {
    position: relative;
    z-index: 2;
    width: 100%;
    height: auto;
    max-height: 550px;
    object-fit: contain;
    filter: drop-shadow(0 15px 35px rgba(0, 0, 0, 0.9)) drop-shadow(0 0 20px rgba(230, 48, 0, 0.25));
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), filter 0.6s ease;
  }

  .hero-poster-img:hover {
    transform: translateY(-8px) scale(1.03);
    filter: drop-shadow(0 25px 45px rgba(0, 0, 0, 0.95)) drop-shadow(0 0 30px rgba(230, 48, 0, 0.4));
  }

  @keyframes pulse-glow {
    0%, 100% { opacity: 0.7; transform: scale(0.98); }
    50% { opacity: 1; transform: scale(1.04); }
  }

  /* Selo Pílula estilo Regê Engenharia */
  .pill-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 1.1rem;
    background: rgba(197, 164, 103, 0.12);
    border: 1px solid rgba(197, 164, 103, 0.35);
    border-radius: var(--radius-full);
    color: #D4AF37;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    backdrop-filter: blur(8px);
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #D4AF37;
    box-shadow: 0 0 10px #D4AF37;
  }

  /* Title — Regê Engenharia Style (Solid + Outlined Stroke) */
  .hero-title {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin-bottom: 1.75rem;
    line-height: 0.92;
  }

  .hero-title-solid {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(2.5rem, 5.5vw, 5.2rem);
    font-weight: 900;
    color: #FFFFFF;
    letter-spacing: -0.03em;
    line-height: 1;
    text-transform: uppercase;
  }

  .hero-title-stroke {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(2.5rem, 5.5vw, 5.2rem);
    font-weight: 900;
    color: transparent;
    -webkit-text-stroke: 1.5px #D4AF37;
    letter-spacing: -0.02em;
    line-height: 1;
    text-transform: uppercase;
  }

  .hero-title-sub {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(0.85rem, 1.8vw, 1.15rem);
    font-weight: 700;
    color: #E63000;
    letter-spacing: 0.12em;
    line-height: 1.4;
    margin-top: 0.8rem;
    text-transform: uppercase;
  }

  .hero-subtitle {
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    color: #D1D5DB;
    line-height: 1.7;
    margin-bottom: 2.5rem;
    max-width: 640px;
  }

  /* ---- Buttons ---- */
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 4rem;
  }

  .btn-hero {
    padding: 1.05rem 2rem;
    font-size: 1rem;
  }

  /* ---- Stats ---- */
  .hero-stats {
    display: flex;
    align-items: center;
    gap: 0;
    padding: 1.5rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.10);
    flex-wrap: wrap;
    gap: 1rem;
  }

  .stat-sep {
    width: 1px;
    height: 36px;
    background: rgba(255, 255, 255, 0.12);
    flex-shrink: 0;
  }

  .stat-item {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0 1.5rem;
  }

  .stat-item:first-child {
    padding-left: 0;
  }

  .stat-icon {
    width: 44px;
    height: 44px;
    background: var(--primary-dim);
    border: 1px solid var(--primary-border);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--primary-light);
    flex-shrink: 0;
  }

  .stat-value {
    display: block;
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--text-main);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .stat-label {
    display: block;
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 500;
    margin-top: 1px;
  }

  /* ---- Scroll indicator ---- */
  .hero-scroll-indicator {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    animation: float-indicator 2.5s ease-in-out infinite;
    opacity: 0.5;
  }

  .scroll-label {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .scroll-chevrons svg {
    display: block;
    color: var(--text-muted);
  }

  @keyframes float-indicator {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50%       { transform: translateX(-50%) translateY(6px); }
  }

  /* ---- Responsive ---- */
  @media (max-width: 992px) {
    .hero-title-display { font-size: clamp(3.5rem, 9vw, 6rem); }
    .stat-sep { display: none; }
    .stat-item { padding: 0; }
    .hero-stats { gap: 1.25rem; }
  }

  @media (max-width: 576px) {
    .hero {
      padding-top: 7rem;
      padding-bottom: 5rem;
    }
    .hero-actions {
      flex-direction: column;
      width: 100%;
    }
    .btn-hero {
      width: 100%;
      justify-content: center;
    }
    .hero-scroll-indicator { display: none; }
  }
</style>
