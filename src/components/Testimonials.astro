---
const testimonials = [
  {
    name: "Eng. Roberto Fonseca",
    role: "Gerente de EHS & Segurança",
    company: "Indústria Metalúrgica Sul",
    text: "O treinamento prático superou todas as nossas expectativas. Os instrutores trouxeram simulações reais de combate e a emissão do certificado foi extremamente ágil. Nota 10 em profissionalismo!",
    stars: 5,
    initial: "R"
  },
  {
    name: "Fernanda Silveira",
    role: "Coordenadora de RH",
    company: "Rede de Supermercados",
    text: "Treinar mais de 120 colaboradores em múltiplos turnos parecia um desafio gigante. A equipe organizou tudo com maestria no formato In-Company sem interromper nossas operações.",
    stars: 5,
    initial: "F"
  },
  {
    name: "Carlos Eduardo Mendes",
    role: "Síndico Profissional",
    company: "Condomínio Edifício Horizon",
    text: "Conseguimos a renovação do AVCB do condomínio sem qualquer pendência após a formação da brigada de incêndio. Excelente didática e total atendimento às exigências do Corpo de Bombeiros.",
    stars: 5,
    initial: "C"
  },
  {
    name: "Dra. Patrícia Lemos",
    role: "Diretora Administrativa",
    company: "Clínica São Lucas",
    text: "A metodologia aplicada foi perfeita para nossa equipe de saúde. Os instrutores adaptaram o conteúdo às nossas especificidades e todos saíram muito mais preparados para emergências.",
    stars: 5,
    initial: "P"
  },
  {
    name: "Marcelo Rodrigues",
    role: "Gerente de Facilities",
    company: "Shopping Metrópolis",
    text: "Com mais de 3.000 pessoas circulando diariamente, precisávamos de uma brigada robusta. O treinamento foi de altíssimo nível e toda a equipe ficou muito confiante para atuar em emergências.",
    stars: 5,
    initial: "M"
  }
];
---

<section class="section-padding testimonials-section">
  <div class="container">
    <div class="section-header" data-animate="fade-up">
      <span class="section-subtitle">Avaliação dos Clientes</span>
      <h2 class="section-title">Quem Contratou e Comprova Nossa Qualidade</h2>
      <p class="section-desc">Depoimentos reais de profissionais de Engenharia de Segurança, RH e Gestores Corporativos.</p>
    </div>

    <!-- Desktop: 3-column grid | Mobile: carousel -->
    <div class="testimonials-grid">
      {testimonials.slice(0, 3).map((item, i) => (
        <div class="testimonial-card glass-card" data-animate="fade-up" data-delay={String(i * 120)}>
          <div class="card-top">
            <div class="quote-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="var(--primary)" opacity="0.35"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"/></svg>
            </div>
            <div class="stars-row">
              {Array.from({ length: item.stars }).map(() => (
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="#F59E0B" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
              ))}
            </div>
          </div>

          <p class="testimonial-quote">"{item.text}"</p>

          <div class="author-box">
            <div class="avatar">{item.initial}</div>
            <div class="author-info">
              <span class="author-name">{item.name}</span>
              <span class="author-role">{item.role}</span>
              <span class="author-company">{item.company}</span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Remaining 2 testimonials below, centered -->
    <div class="testimonials-row" style="margin-top: 1.5rem;">
      {testimonials.slice(3).map((item, i) => (
        <div class="testimonial-card glass-card" data-animate="fade-up" data-delay={String((i + 3) * 120)}>
          <div class="card-top">
            <div class="quote-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="var(--primary)" opacity="0.35"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"/></svg>
            </div>
            <div class="stars-row">
              {Array.from({ length: item.stars }).map(() => (
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="#F59E0B" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
              ))}
            </div>
          </div>

          <p class="testimonial-quote">"{item.text}"</p>

          <div class="author-box">
            <div class="avatar">{item.initial}</div>
            <div class="author-info">
              <span class="author-name">{item.name}</span>
              <span class="author-role">{item.role}</span>
              <span class="author-company">{item.company}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .testimonials-section {
    background: var(--bg-elevated);
    overflow: hidden;
  }

  /* ---- Grid layouts ---- */
  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .testimonials-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    max-width: 860px;
    margin-left: auto;
    margin-right: auto;
  }

  /* ---- Card ---- */
  .testimonial-card {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    padding: 2rem;
  }

  .testimonial-card:hover {
    transform: translateY(-5px);
    border-color: var(--primary-border);
    box-shadow: var(--shadow-card), 0 0 24px var(--primary-glow);
  }

  /* ---- Top row ---- */
  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .quote-icon {
    flex-shrink: 0;
  }

  .stars-row {
    display: flex;
    gap: 0.2rem;
  }

  /* ---- Quote ---- */
  .testimonial-quote {
    color: var(--text-main);
    font-size: 0.95rem;
    line-height: 1.75;
    font-style: italic;
    flex-grow: 1;
    opacity: 0.9;
  }

  /* ---- Author ---- */
  .author-box {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    margin-top: auto;
  }

  .avatar {
    width: 46px;
    height: 46px;
    background: var(--gradient-fire);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    color: #FFFFFF;
    font-size: 1.1rem;
    flex-shrink: 0;
    box-shadow: 0 0 16px var(--primary-glow);
    border: 2px solid rgba(230, 48, 0, 0.35);
  }

  .author-info {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .author-name {
    display: block;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .author-role {
    display: block;
    font-size: 0.76rem;
    color: var(--text-muted);
  }

  .author-company {
    display: block;
    font-size: 0.76rem;
    color: var(--primary-light);
    font-weight: 600;
  }

  /* ---- Responsive ---- */
  @media (max-width: 992px) {
    .testimonials-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .testimonials-row {
      grid-template-columns: 1fr;
      max-width: 100%;
    }
  }

  @media (max-width: 576px) {
    .testimonials-grid {
      grid-template-columns: 1fr;
    }
    .testimonials-row {
      grid-template-columns: 1fr;
    }
  }
</style>
