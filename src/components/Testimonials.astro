---
const testimonials = [
  {
    name: "Eng. Roberto Fonseca",
    role: "Gerente de EHS & Segurança",
    company: "Indústria Metalúrgica Sul",
    text: "O treinamento prático superou todas as nossas expectativas. Os instrutores trouxeram simulações reais de combate e a emissão do certificado foi extremamente ágil. Nota 10 em profissionalismo!",
    stars: 5
  },
  {
    name: "Fernanda Silveira",
    role: "Coordenadora de Recursos Humanos",
    company: "Rede de Supermercados",
    text: "Treinar mais de 120 colaboradores em múltiplos turnos parecia um desafio gigante. A equipe organizou tudo com maestria no formato In-Company sem interromper nossas operações.",
    stars: 5
  },
  {
    name: "Carlos Eduardo Mendes",
    role: "Síndico Profissional",
    company: "Condomínio Edifício Horizon",
    text: "Conseguimos a renovação do AVCB do condomínio sem qualquer pendência após a formação da brigada de incêndio. Excelente didática e total atendimento às exigências do Corpo de Bombeiros.",
    stars: 5
  },
  {
    name: "Dra. Patrícia Lemos",
    role: "Diretora Administrativa",
    company: "Clínica São Lucas",
    text: "A metodologia aplicada foi perfeita para nossa equipe de saúde. Os instrutores adaptaram o conteúdo às nossas especificidades e todos saíram muito mais preparados para emergências.",
    stars: 5
  },
  {
    name: "Marcelo Rodrigues",
    role: "Gerente de Facilities",
    company: "Shopping Metrópolis",
    text: "Com mais de 3.000 pessoas circulando diariamente, precisávamos de uma brigada robusta. O treinamento foi de altíssimo nível e toda a equipe ficou muito confiante para atuar em emergências.",
    stars: 5
  }
];
---

<section class="section-padding testimonials-section">
  <div class="container">
    <div class="section-header" data-animate="fade-up">
      <span class="section-subtitle">Avaliação dos Clientes</span>
      <h2 class="section-title">Quem Contratou e Comprova Nossa Qualidade</h2>
      <p class="section-desc">Depoimentos reais de profissionais de Engenharia de Segurança, RH e Gestores Corporativos.</p>
    </div>

    <div class="carousel-wrapper" data-animate="fade-up" data-delay="150">
      <div class="carousel-track" id="testimonials-track">
        {testimonials.map((item, i) => (
          <div class={`testimonial-card glass-card ${i === 0 ? 'active' : ''}`} data-index={i}>
            <div class="quote-mark">"</div>

            <div class="stars-row">
              {Array.from({ length: item.stars }).map(() => (
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="#F59E0B" stroke="#F59E0B" stroke-width="1"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
              ))}
            </div>

            <p class="testimonial-quote">{item.text}</p>

            <div class="author-box">
              <div class="avatar">
                <span>{item.name.charAt(0)}</span>
              </div>
              <div>
                <span class="author-name">{item.name}</span>
                <span class="author-role">{item.role} • <strong class="author-company">{item.company}</strong></span>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Navigation -->
      <div class="carousel-nav">
        <button class="carousel-btn prev" id="testimonials-prev" aria-label="Depoimento anterior">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>

        <div class="carousel-dots" id="testimonials-dots">
          {testimonials.map((_, i) => (
            <button class={`dot ${i === 0 ? 'active' : ''}`} data-dot={i} aria-label={`Ir para depoimento ${i + 1}`}></button>
          ))}
        </div>

        <button class="carousel-btn next" id="testimonials-next" aria-label="Próximo depoimento">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var track = document.getElementById('testimonials-track');
    var dotsContainer = document.getElementById('testimonials-dots');
    var prevBtn = document.getElementById('testimonials-prev');
    var nextBtn = document.getElementById('testimonials-next');

    if (!track) return;

    var cards = track.querySelectorAll('.testimonial-card');
    var dots = dotsContainer ? dotsContainer.querySelectorAll('.dot') : [];
    var current = 0;
    var total = cards.length;
    var autoplayTimer = null;

    function goTo(index) {
      cards[current].classList.remove('active', 'exit-left', 'exit-right');
      var direction = index > current ? 1 : -1;

      cards[current].classList.add(direction > 0 ? 'exit-left' : 'exit-right');
      dots[current] && dots[current].classList.remove('active');

      current = (index + total) % total;

      // Force reflow
      cards[current].classList.remove('enter-right', 'enter-left');
      void cards[current].offsetWidth;
      cards[current].classList.add(direction > 0 ? 'enter-right' : 'enter-left');

      requestAnimationFrame(function () {
        cards[current].classList.add('active');
        cards[current].classList.remove('enter-right', 'enter-left');
        dots[current] && dots[current].classList.add('active');
      });

      // Clean exit classes after animation
      setTimeout(function () {
        cards.forEach(function (c) {
          c.classList.remove('exit-left', 'exit-right', 'enter-right', 'enter-left');
        });
      }, 500);
    }

    function startAutoplay() {
      stopAutoplay();
      autoplayTimer = setInterval(function () {
        goTo(current + 1);
      }, 5000);
    }

    function stopAutoplay() {
      if (autoplayTimer) clearInterval(autoplayTimer);
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', function () {
        stopAutoplay();
        goTo(current + 1);
        startAutoplay();
      });
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', function () {
        stopAutoplay();
        goTo(current - 1);
        startAutoplay();
      });
    }

    dots.forEach(function (dot) {
      dot.addEventListener('click', function () {
        stopAutoplay();
        goTo(parseInt(dot.dataset.dot, 10));
        startAutoplay();
      });
    });

    // Touch / swipe support
    var touchStartX = 0;
    track.addEventListener('touchstart', function (e) {
      touchStartX = e.changedTouches[0].clientX;
    }, { passive: true });
    track.addEventListener('touchend', function (e) {
      var diff = touchStartX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 50) {
        stopAutoplay();
        goTo(diff > 0 ? current + 1 : current - 1);
        startAutoplay();
      }
    }, { passive: true });

    startAutoplay();
  })();
</script>

<style>
  .testimonials-section {
    background: var(--bg-main);
    overflow: hidden;
  }

  .carousel-wrapper {
    position: relative;
    max-width: 860px;
    margin: 0 auto;
  }

  .carousel-track {
    position: relative;
    min-height: 320px;
  }

  .testimonial-card {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    transform: translateX(60px);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .testimonial-card.active {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(0);
    position: relative;
  }

  .testimonial-card.exit-left {
    opacity: 0;
    transform: translateX(-60px);
    position: absolute;
  }

  .testimonial-card.exit-right {
    opacity: 0;
    transform: translateX(60px);
    position: absolute;
  }

  .testimonial-card.enter-right {
    opacity: 0;
    transform: translateX(60px);
  }

  .testimonial-card.enter-left {
    opacity: 0;
    transform: translateX(-60px);
  }

  .quote-mark {
    font-size: 5rem;
    line-height: 0.6;
    color: var(--primary);
    opacity: 0.3;
    font-family: Georgia, serif;
    font-weight: 700;
    user-select: none;
  }

  .stars-row {
    display: flex;
    gap: 0.25rem;
  }

  .testimonial-quote {
    color: var(--text-main);
    font-size: 1.05rem;
    line-height: 1.7;
    font-style: italic;
    flex-grow: 1;
  }

  .author-box {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    margin-top: auto;
  }

  .avatar {
    width: 48px;
    height: 48px;
    background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    color: #FFFFFF;
    font-size: 1.15rem;
    flex-shrink: 0;
    box-shadow: 0 0 15px var(--primary-glow);
  }

  .author-name {
    display: block;
    font-size: 0.98rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .author-role {
    display: block;
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 0.1rem;
  }

  .author-company {
    color: var(--primary);
    font-weight: 600;
  }

  /* Navigation */
  .carousel-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .carousel-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-light);
    color: var(--text-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: var(--transition);
  }

  .carousel-btn:hover {
    background: var(--primary);
    border-color: var(--primary);
    color: #fff;
    transform: scale(1.1);
    box-shadow: 0 0 15px var(--primary-glow);
  }

  .carousel-dots {
    display: flex;
    gap: 0.6rem;
    align-items: center;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--border-light);
    border: none;
    cursor: pointer;
    transition: var(--transition);
  }

  .dot.active {
    width: 24px;
    border-radius: 4px;
    background: var(--primary);
  }

  @media (max-width: 576px) {
    .carousel-track {
      min-height: 380px;
    }
    .testimonial-quote {
      font-size: 0.95rem;
    }
  }
</style>
