---
const stats = [
  {
    value: 1500,
    suffix: "+",
    label: "Empresas Treinadas",
    desc: "em toda a região",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>`
  },
  {
    value: 18000,
    suffix: "+",
    label: "Colaboradores Certificados",
    desc: "com documentação válida",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>`
  },
  {
    value: 15,
    suffix: " anos",
    label: "de Experiência",
    desc: "formando brigadistas",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>`
  },
  {
    value: 100,
    suffix: "%",
    label: "Aprovação no AVCB",
    desc: "sem pendências ou retrabalho",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>`
  }
];
---

<section class="stats-section">
  <div class="stats-glow"></div>
  <div class="container">
    <div class="stats-inner">
      {stats.map((stat, i) => (
        <div
          class="stat-block"
          data-animate="fade-up"
          data-delay={String(i * 120)}
        >
          <div class="stat-icon-wrap" set:html={stat.icon} />
          <div class="stat-body">
            <span
              class="stat-number"
              data-counter-target={String(stat.value)}
              data-counter-suffix={stat.suffix}
            >{stat.value >= 1000 ? stat.value.toLocaleString('pt-BR') : stat.value}{stat.suffix}</span>
            <span class="stat-label">{stat.label}</span>
            <span class="stat-desc">{stat.desc}</span>
          </div>
          {i < stats.length - 1 && <div class="stat-divider" aria-hidden="true"></div>}
        </div>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    function easeOutQuart(t) {
      return 1 - Math.pow(1 - t, 4);
    }
    function animateCounter(el) {
      var target = parseInt(el.dataset.counterTarget, 10);
      var suffix = el.dataset.counterSuffix || '';
      var duration = 1800;
      var startTime = performance.now();
      function update(now) {
        var elapsed = now - startTime;
        var progress = Math.min(elapsed / duration, 1);
        var value = Math.round(easeOutQuart(progress) * target);
        var formatted = value >= 1000 ? value.toLocaleString('pt-BR') : String(value);
        el.textContent = formatted + suffix;
        if (progress < 1) requestAnimationFrame(update);
      }
      requestAnimationFrame(update);
    }
    var counters = document.querySelectorAll('[data-counter-target]');
    if (!counters.length) return;
    var obs = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          animateCounter(entry.target);
          obs.unobserve(entry.target);
        }
      });
    }, { threshold: 0.5 });
    counters.forEach(function (el) { obs.observe(el); });
  })();
</script>

<style>
  .stats-section {
    padding: 5.5rem 0;
    position: relative;
    overflow: hidden;
    background: #FAFAFA;
    border-top: 1px solid #E5E7EB;
    border-bottom: 1px solid #E5E7EB;
  }

  .stats-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 800px;
    height: 250px;
    background: radial-gradient(ellipse, rgba(230, 48, 0, 0.07) 0%, transparent 70%);
    filter: blur(70px);
    pointer-events: none;
  }

  .stats-inner {
    display: flex;
    align-items: stretch;
    justify-content: center;
    position: relative;
    flex-wrap: wrap;
    gap: 0;
  }

  .stat-block {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex: 1;
    min-width: 200px;
    padding: 2rem 2.5rem;
    position: relative;
    transition: var(--transition);
  }

  .stat-divider {
    width: 1px;
    background: #D1D5DB;
    align-self: stretch;
    margin: 1rem 0;
    flex-shrink: 0;
  }

  .stat-icon-wrap {
    width: 56px;
    height: 56px;
    background: rgba(230, 48, 0, 0.08);
    border: 1px solid rgba(230, 48, 0, 0.20);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--primary);
    flex-shrink: 0;
    transition: var(--transition);
  }

  .stat-block:hover .stat-icon-wrap {
    background: var(--primary);
    border-color: var(--primary);
    color: #fff;
    box-shadow: 0 0 24px rgba(230, 48, 0, 0.25);
  }

  .stat-body {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .stat-number {
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 800;
    line-height: 1;
    background: linear-gradient(135deg, #1A1A1A 0%, var(--primary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -0.03em;
  }

  .stat-label {
    font-size: 0.95rem;
    font-weight: 700;
    color: #111827;
  }

  .stat-desc {
    font-size: 0.78rem;
    color: #6B7280;
  }

  @media (max-width: 768px) {
    .stat-block {
      padding: 1.5rem;
      flex: 0 0 calc(50% - 1px);
    }
    .stat-divider:nth-of-type(2) {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .stat-block {
      flex: 0 0 100%;
    }
    .stat-divider {
      display: none;
    }
  }
</style>
