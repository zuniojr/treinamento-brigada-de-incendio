---
const stats = [
  {
    value: 1500,
    suffix: "+",
    label: "Empresas Treinadas",
    desc: "em toda a região",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>`
  },
  {
    value: 18000,
    suffix: "+",
    label: "Colaboradores Certificados",
    desc: "com documentação válida",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>`
  },
  {
    value: 15,
    suffix: " anos",
    label: "de Experiência",
    desc: "formando brigadistas",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>`
  },
  {
    value: 100,
    suffix: "%",
    label: "Aprovação no AVCB",
    desc: "sem pendências ou retrabalho",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>`
  }
];
---

<section class="stats-section">
  <div class="stats-bg-glow"></div>
  <div class="container">
    <div class="stats-header" data-animate="fade-up">
      <span class="section-subtitle">Resultados que Comprovam</span>
      <h2 class="section-title">Números que Falam por Si</h2>
    </div>

    <div class="stats-grid">
      {stats.map((stat, i) => (
        <div
          class="stat-card glass-card"
          data-animate="fade-up"
          data-delay={String(i * 100 + 100)}
        >
          <div class="stat-icon-wrap" set:html={stat.icon} />
          <div class="stat-body">
            <span
              class="stat-number"
              data-counter-target={String(stat.value)}
              data-counter-suffix={stat.suffix}
            >0{stat.suffix}</span>
            <span class="stat-label">{stat.label}</span>
            <span class="stat-desc">{stat.desc}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    function easeOutQuart(t) {
      return 1 - Math.pow(1 - t, 4);
    }

    function animateCounter(el) {
      var target = parseInt(el.dataset.counterTarget, 10);
      var suffix = el.dataset.counterSuffix || '';
      var duration = 1800;
      var startTime = performance.now();

      function update(now) {
        var elapsed = now - startTime;
        var progress = Math.min(elapsed / duration, 1);
        var value = Math.round(easeOutQuart(progress) * target);
        var formatted = value >= 1000 ? value.toLocaleString('pt-BR') : String(value);
        el.textContent = formatted + suffix;
        if (progress < 1) requestAnimationFrame(update);
      }
      requestAnimationFrame(update);
    }

    var counters = document.querySelectorAll('[data-counter-target]');
    if (!counters.length) return;

    var obs = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          animateCounter(entry.target);
          obs.unobserve(entry.target);
        }
      });
    }, { threshold: 0.5 });

    counters.forEach(function (el) { obs.observe(el); });
  })();
</script>

<style>
  .stats-section {
    padding: 5rem 0;
    position: relative;
    overflow: hidden;
    background: linear-gradient(
      180deg,
      var(--bg-main) 0%,
      rgba(230, 25, 25, 0.04) 50%,
      var(--bg-main) 100%
    );
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .stats-bg-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 700px;
    height: 300px;
    background: radial-gradient(ellipse, rgba(230, 25, 25, 0.12) 0%, transparent 70%);
    filter: blur(60px);
    pointer-events: none;
  }

  .stats-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .stats-header .section-title {
    margin-bottom: 0;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .stat-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 2rem 1.75rem;
    position: relative;
    overflow: hidden;
  }

  .stat-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, var(--primary), var(--secondary));
    opacity: 0;
    transition: var(--transition);
  }

  .stat-card:hover::before {
    opacity: 1;
  }

  .stat-icon-wrap {
    width: 56px;
    height: 56px;
    background: rgba(230, 25, 25, 0.1);
    border: 1px solid rgba(230, 25, 25, 0.2);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--primary);
    flex-shrink: 0;
    transition: var(--transition);
  }

  .stat-card:hover .stat-icon-wrap {
    background: var(--primary);
    color: #fff;
    box-shadow: 0 0 20px var(--primary-glow);
    transform: scale(1.05);
  }

  .stat-body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .stat-number {
    font-size: 2.6rem;
    font-weight: 800;
    line-height: 1;
    background: linear-gradient(135deg, #FFFFFF 0%, var(--primary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    letter-spacing: -0.03em;
  }

  .stat-label {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-main);
    margin-top: 0.35rem;
  }

  .stat-desc {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  @media (max-width: 992px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 576px) {
    .stats-grid {
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
    .stat-card {
      padding: 1.5rem 1.25rem;
    }
    .stat-number {
      font-size: 2rem;
    }
  }
</style>
