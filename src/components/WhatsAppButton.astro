<style>
  .whatsapp-float-container {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 9999;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* Tooltip */
  .whatsapp-tooltip {
    position: relative;
    background: rgba(15, 23, 42, 0.96);
    border: 1px solid rgba(37, 211, 102, 0.25);
    border-radius: var(--radius-md);
    padding: 0.6rem 1rem;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.6), 0 0 20px rgba(37, 211, 102, 0.1);
    backdrop-filter: blur(12px);
    white-space: nowrap;
    opacity: 0;
    transform: translateX(12px);
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .whatsapp-float-container:hover .whatsapp-tooltip {
    opacity: 1;
    transform: translateX(0);
  }

  .tooltip-inner {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .tooltip-title {
    font-size: 0.82rem;
    font-weight: 700;
    color: #25D366;
    line-height: 1.2;
  }

  .tooltip-sub {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  /* Arrow */
  .tooltip-arrow {
    position: absolute;
    right: -7px;
    top: 50%;
    transform: translateY(-50%);
    width: 0;
    height: 0;
    border-top: 7px solid transparent;
    border-bottom: 7px solid transparent;
    border-left: 7px solid rgba(15, 23, 42, 0.96);
  }

  /* Main button */
  .whatsapp-btn {
    position: relative;
    width: 62px;
    height: 62px;
    background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);
    color: #FFFFFF;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 25px rgba(37, 211, 102, 0.45);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    flex-shrink: 0;
  }

  .whatsapp-btn:hover {
    transform: scale(1.12) translateY(-2px);
    box-shadow: 0 14px 35px rgba(37, 211, 102, 0.65);
  }

  /* Pulse rings */
  .pulse-ring {
    position: absolute;
    border-radius: 50%;
    border: 2px solid rgba(37, 211, 102, 0.6);
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    animation: wa-pulse 2.4s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    pointer-events: none;
  }

  .ring-2 {
    animation-delay: 0.8s;
    border-color: rgba(37, 211, 102, 0.35);
  }

  @keyframes wa-pulse {
    0% {
      transform: scale(1);
      opacity: 1;
    }
    100% {
      transform: scale(1.75);
      opacity: 0;
    }
  }

  @media (max-width: 576px) {
    .whatsapp-float-container {
      bottom: 1.25rem;
      right: 1.25rem;
    }
    .whatsapp-tooltip {
      display: none;
    }
    .whatsapp-btn {
      width: 56px;
      height: 56px;
    }
  }
</style>
