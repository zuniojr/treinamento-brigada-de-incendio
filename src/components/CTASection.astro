<section class="cta-section" id="cta-orcamento">
  <div class="container">
    <div class="cta-card" data-animate="scale-up">

      <!-- Glow ring (signature element) -->
      <div class="cta-ring"></div>

      <!-- Content -->
      <div class="cta-content">
        <div class="cta-eyebrow">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
          <span>Atendimento Prioritário para Empresas</span>
        </div>

        <h2 class="cta-heading">
          Proteja Vidas.<br />
          <span class="cta-heading-accent">Prepare sua Equipe.</span>
        </h2>

        <p class="cta-text">
          Não espere por uma fiscalização ou emergência. Solicite um orçamento sem compromisso e receba uma proposta técnica sob medida em até 2 horas.
        </p>

        <div class="cta-actions">
          <button onclick="openQuoteModal()" class="cta-btn cta-btn-primary" id="cta-section-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
            <span>Solicitar Orçamento Agora</span>
          </button>

          <a 
            href="https://wa.me/5547999292900?text=Ol%C3%A1!%20Vim%20pelo%20site%20e%20preciso%20de%20um%20or%C3%A7amento%20para%20Brigada%20de%20Inc%C3%AAndio." 
            target="_blank" 
            rel="noopener noreferrer" 
            class="cta-btn cta-btn-whatsapp"
            id="cta-section-whatsapp"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
            <span>Cotar via WhatsApp</span>
          </a>
        </div>

        <div class="cta-trust">
          <div class="cta-trust-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Proposta em até 2h</span>
          </div>
          <div class="cta-trust-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Certificação NR-23 Válida</span>
          </div>
          <div class="cta-trust-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>In-Company ou Externo</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* ============================================
     CTA Section — Redesigned Banner
     ============================================ */
  .cta-section {
    padding: 5rem 0;
    position: relative;
    background: #F5F4F0;
  }

  /* ---- The Card ---- */
  .cta-card {
    position: relative;
    text-align: center;
    padding: 4.5rem 3rem;
    border-radius: 20px;
    background:
      radial-gradient(ellipse at 30% 0%, rgba(255, 120, 50, 0.18) 0%, transparent 55%),
      radial-gradient(ellipse at 80% 100%, rgba(180, 30, 0, 0.12) 0%, transparent 50%),
      linear-gradient(160deg, #1A1A1A 0%, #111111 40%, #0D0D0D 100%);
    box-shadow:
      0 1px 0 0 rgba(255,255,255,0.06) inset,
      0 32px 64px -16px rgba(0, 0, 0, 0.50);
    overflow: hidden;
    z-index: 1;
  }

  /* Noise texture overlay for depth */
  .cta-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
    background-size: 180px;
    border-radius: inherit;
    pointer-events: none;
    z-index: 0;
  }

  /* ---- Signature: animated glow ring ---- */
  .cta-ring {
    position: absolute;
    inset: -1px;
    border-radius: 21px;
    z-index: -1;
    background: conic-gradient(
      from 0deg,
      transparent 0deg,
      rgba(230, 48, 0, 0.7) 60deg,
      rgba(255, 140, 50, 0.5) 120deg,
      transparent 180deg,
      rgba(230, 48, 0, 0.4) 270deg,
      transparent 360deg
    );
    animation: ringRotate 6s linear infinite;
    filter: blur(2px);
  }

  @keyframes ringRotate {
    to { transform: rotate(360deg); }
  }

  /* ---- Content ---- */
  .cta-content {
    position: relative;
    z-index: 2;
  }

  .cta-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #FFFFFF;
    background: rgba(230, 48, 0, 0.35);
    border: 1px solid rgba(230, 48, 0, 0.55);
    border-radius: 999px;
    margin-bottom: 2rem;
  }

  .cta-heading {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    font-weight: 900;
    color: #FFFFFF;
    line-height: 1.12;
    letter-spacing: -0.03em;
    margin-bottom: 1.25rem;
  }

  .cta-heading-accent {
    background: linear-gradient(90deg, #FF6B35 0%, #FFB347 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .cta-text {
    color: rgba(255, 255, 255, 0.65);
    font-size: 1.05rem;
    line-height: 1.7;
    max-width: 600px;
    margin: 0 auto 2.5rem auto;
  }

  /* ---- Buttons ---- */
  .cta-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1rem 2rem;
    font-size: 0.95rem;
    font-weight: 700;
    border-radius: 12px;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  .cta-btn:hover {
    transform: translateY(-2px);
  }

  .cta-btn-primary {
    background: linear-gradient(135deg, #E63000 0%, #FF6B35 100%);
    color: #FFFFFF;
    box-shadow: 0 8px 28px rgba(230, 48, 0, 0.40);
  }

  .cta-btn-primary:hover {
    box-shadow: 0 12px 36px rgba(230, 48, 0, 0.55);
  }

  .cta-btn-whatsapp {
    background: rgba(255, 255, 255, 0.08);
    color: #FFFFFF;
    border: 1.5px solid rgba(255, 255, 255, 0.20);
    backdrop-filter: blur(6px);
  }

  .cta-btn-whatsapp:hover {
    background: rgba(37, 211, 102, 0.15);
    border-color: rgba(37, 211, 102, 0.45);
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.15);
  }

  /* ---- Trust Badges ---- */
  .cta-trust {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    flex-wrap: wrap;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .cta-trust-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .cta-trust-item svg {
    color: #FF6B35;
  }

  /* ---- Responsive ---- */
  @media (max-width: 768px) {
    .cta-card {
      padding: 3rem 1.5rem;
    }

    .cta-actions {
      flex-direction: column;
      width: 100%;
    }

    .cta-btn {
      width: 100%;
      justify-content: center;
    }

    .cta-trust {
      flex-direction: column;
      gap: 0.65rem;
      align-items: center;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .cta-ring {
      animation: none;
    }
  }
</style>
