---
const segments = [
  { name: "Indústrias & Fábricas", icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8l-7 5V8l-7 5V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"></path></svg>` },
  { name: "Construção Civil", icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"></path><path d="M6 12h12"></path><path d="M6 7h12"></path><path d="M6 17h12"></path></svg>` },
  { name: "Condomínios Residenc. e Comerciais", icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>` },
  { name: "Hotéis & Pousadas", icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 4v16"></path><path d="M2 8h18a2 2 0 0 1 2 2v10"></path><path d="M2 17h20"></path><path d="M6 8v9"></path></svg>` },
  { name: "Escolas & Universidades", icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"></path><path d="M6 12v5c3 3 9 3 12 0v-5"></path></svg>` },
  { name: "Clínicas & Hospitais", icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 6v12M6 12h12"></path></svg>` },
  { name: "Shoppings & Varejo", icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path><path d="M3 6h18"></path><path d="M16 10a4 4 0 0 1-8 0"></path></svg>` },
  { name: "Centros Logísticos", icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path></svg>` },
  { name: "Supermercados & Atacados", icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>` },
  { name: "Escritórios Corporativos", icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2"></rect><line x1="9" y1="6" x2="15" y2="6"></line><line x1="9" y1="10" x2="15" y2="10"></line><line x1="9" y1="14" x2="15" y2="14"></line></svg>` },
  { name: "Órgãos Públicos", icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M4 18h16M6 18v-7M10 18v-7M14 18v-7M18 18v-7M12 2L2 7h20L12 2z"></path></svg>` }
];
---

<section class="section-padding segments-section">
  <div class="container">
    <div class="section-header" data-animate="fade-up">
      <span class="section-subtitle">Setores Atendidos</span>
      <h2 class="section-title">Soluções Adaptadas para Todos os Segmentos</h2>
      <p class="section-desc">Atendemos empresas de pequeno, médio e grande porte, com conteúdo ajustado ao tipo de edificação e atividade econômica.</p>
    </div>

    <!-- Segments chip list -->
    <div class="segments-wrap" data-animate="fade-up" data-delay="100">
      {segments.map((item, i) => (
        <div class="segment-chip" data-animate="fade-up" data-delay={String((i % 5) * 60)}>
          <div class="chip-icon" set:html={item.icon} />
          <span class="chip-name">{item.name}</span>
        </div>
      ))}
    </div>

    <!-- Quote CTA -->
    <div class="quote-cta-card" data-animate="scale-up" data-delay="150">
      <div class="cta-fire-bg" aria-hidden="true"></div>

      <div class="quote-cta-inner">
        <div class="quote-cta-content">
          <div class="badge-alert" style="margin-bottom: 1rem;">
            <span class="dot"></span>
            <span>Orçamento Sob Medida</span>
          </div>
          <h3 class="quote-cta-title">Solicite uma Proposta Personalizada para Sua Empresa</h3>
          <p class="quote-cta-desc">
            Dimensionamos o treinamento ideal de acordo com a sua edificação, número de brigadistas e requisitos da NR-23 / NBR 14276. Receba uma cotação sem compromisso em minutos.
          </p>
          <div class="quote-cta-badges">
            <span>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              Resposta Rápida Corporativa
            </span>
            <span>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              Certificação NR-23 Válida
            </span>
            <span>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              In-Company ou Externo
            </span>
          </div>
        </div>

        <div class="quote-cta-actions">
          <button onclick="openQuoteModal()" class="btn btn-primary btn-cta-action" id="segments-cta-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
            <span>Solicitar Orçamento Agora</span>
          </button>
          <a
            href="https://bitlybr.net/TreinamentoBrigada"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-whatsapp btn-cta-action"
            id="segments-cta-whatsapp"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
            <span>Cotar via WhatsApp</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .segments-section {
    background: #F3F4F6;
  }

  /* Override section header colors for light background */
  .segments-section .section-subtitle {
    color: var(--primary);
    background: rgba(230, 48, 0, 0.08);
    border-color: rgba(230, 48, 0, 0.20);
  }

  .segments-section .section-title {
    color: #111827;
    background: none;
    -webkit-background-clip: unset;
    -webkit-text-fill-color: #111827;
    background-clip: unset;
  }

  .segments-section .section-desc {
    color: #4B5563;
  }

  /* ---- Chips ---- */
  .segments-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    justify-content: center;
    margin-bottom: 4.5rem;
  }

  .segment-chip {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.6rem 1.1rem;
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: var(--radius-full);
    transition: var(--transition);
    cursor: default;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
  }

  .segment-chip:hover {
    background: #FFF5F3;
    border-color: rgba(230, 48, 0, 0.30);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(230, 48, 0, 0.12);
  }

  .chip-icon {
    color: var(--primary);
    display: flex;
    align-items: center;
    transition: color 0.2s;
    flex-shrink: 0;
  }

  .segment-chip:hover .chip-icon {
    color: var(--primary-hover);
  }

  .chip-name {
    font-size: 0.88rem;
    font-weight: 600;
    color: #374151;
    white-space: nowrap;
    transition: color 0.2s;
  }

  .segment-chip:hover .chip-name {
    color: #111827;
  }

  /* ---- Quote CTA Card ---- */
  .quote-cta-card {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: var(--radius-xl);
    padding: 3.5rem;
    position: relative;
    overflow: hidden;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.05), 0 0 30px rgba(230, 48, 0, 0.05);
  }

  .cta-fire-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background:
      radial-gradient(circle at 10% 50%, rgba(230, 48, 0, 0.12) 0%, transparent 50%),
      radial-gradient(circle at 90% 50%, rgba(230, 48, 0, 0.06) 0%, transparent 40%);
    pointer-events: none;
  }

  .quote-cta-inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
  }

  .quote-cta-content {
    flex: 1;
    max-width: 700px;
  }

  .quote-cta-title {
    font-size: clamp(1.4rem, 2.5vw, 1.8rem);
    font-weight: 800;
    color: #111827;
    margin: 0.75rem 0 0.85rem;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .quote-cta-desc {
    color: #4B5563;
    font-size: 0.95rem;
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }

  .quote-cta-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .quote-cta-badges span {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.83rem;
    font-weight: 600;
    color: #374151;
  }

  .quote-cta-badges svg {
    color: var(--primary-light);
    flex-shrink: 0;
  }

  /* ---- CTA actions ---- */
  .quote-cta-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 260px;
    flex-shrink: 0;
  }

  .btn-cta-action {
    width: 100%;
    justify-content: center;
    padding: 0.95rem 1.5rem;
  }

  /* ---- Responsive ---- */
  @media (max-width: 992px) {
    .quote-cta-inner {
      flex-direction: column;
      align-items: flex-start;
    }
    .quote-cta-actions {
      width: 100%;
      min-width: unset;
      flex-direction: row;
      flex-wrap: wrap;
    }
    .btn-cta-action {
      flex: 1;
      min-width: 200px;
    }
    .quote-cta-card {
      padding: 2.5rem;
    }
  }

  @media (max-width: 576px) {
    .quote-cta-actions {
      flex-direction: column;
    }
    .quote-cta-card {
      padding: 2rem 1.5rem;
    }
  }
</style>
