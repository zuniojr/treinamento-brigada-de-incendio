---
const segments = [
  { name: "Indústrias & Fábricas", icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8l-7 5V8l-7 5V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"></path></svg>` },
  { name: "Construção Civil", icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"></path><path d="M6 12h12"></path><path d="M6 7h12"></path><path d="M6 17h12"></path></svg>` },
  { name: "Condomínios Residenc. e Comerciais", icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>` },
  { name: "Hotéis & Pousadas", icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 4v16"></path><path d="M2 8h18a2 2 0 0 1 2 2v10"></path><path d="M2 17h20"></path><path d="M6 8v9"></path></svg>` },
  { name: "Escolas & Universidades", icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"></path><path d="M6 12v5c3 3 9 3 12 0v-5"></path></svg>` },
  { name: "Clínicas & Hospitais", icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 6v12M6 12h12"></path></svg>` },
  { name: "Shoppings & Varejo", icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path><path d="M3 6h18"></path><path d="M16 10a4 4 0 0 1-8 0"></path></svg>` },
  { name: "Centros Logísticos", icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path></svg>` },
  { name: "Supermercados & Atacados", icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>` },
  { name: "Escritórios Corporativos", icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2"></rect><line x1="9" y1="6" x2="15" y2="6"></line><line x1="9" y1="10" x2="15" y2="10"></line><line x1="9" y1="14" x2="15" y2="14"></line></svg>` },
  { name: "Órgãos Públicos", icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M4 18h16M6 18v-7M10 18v-7M14 18v-7M18 18v-7M12 2L2 7h20L12 2z"></path></svg>` }
];
---

<section class="section-padding segments-section">
  <div class="container">
    <div class="section-header" data-animate="fade-up">
      <span class="section-subtitle">Setores Atendidos</span>
      <h2 class="section-title">Soluções Adaptadas para Todos os Segmentos</h2>
      <p class="section-desc">Atendemos empresas de pequeno, médio e grande porte, com conteúdo ajustado ao tipo de edificação e atividade econômica.</p>
    </div>

    <div class="segments-grid">
      {segments.map((item, i) => (
        <div class="segment-card glass-card" data-animate="fade-up" data-delay={String((i % 4) * 80)}>
          <div class="segment-icon" set:html={item.icon} />
          <span class="segment-name">{item.name}</span>
        </div>
      ))}
    </div>

    <!-- Corporate Logos Banner -->
    <div class="client-logos-box" data-animate="fade-up" data-delay="200">
      <span class="logos-title">Empresas e Condomínios que Confiam no Nosso Treinamento:</span>
      <div class="logos-grid">
        <div class="logo-placeholder"><span>GRUPO LOGÍSTICO SP</span></div>
        <div class="logo-placeholder"><span>CONSTRUTORA ALFA</span></div>
        <div class="logo-placeholder"><span>REDE HOTELARIA MASTER</span></div>
        <div class="logo-placeholder"><span>SHOPPING METRÓPOLE</span></div>
        <div class="logo-placeholder"><span>HOSPITAL SANTA LUZIA</span></div>
      </div>
    </div>
  </div>
</section>

<style>
  .segments-section {
    background: linear-gradient(180deg, var(--bg-main) 0%, rgba(15, 23, 42, 0.6) 100%);
  }

  .segments-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
    margin-bottom: 4rem;
  }

  .segment-card {
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .segment-icon {
    width: 54px;
    height: 54px;
    background: rgba(230, 25, 25, 0.1);
    width: 40px;
    height: 40px;
    color: var(--primary);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .segment-name {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-main);
  }

  /* Logos Banner */
  .client-logos-box {
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 2.5rem 2rem;
    text-align: center;
  }

  .logos-title {
    font-size: 0.88rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-subtle);
    display: block;
    margin-bottom: 2rem;
  }

  .logos-grid {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2.5rem;
    flex-wrap: wrap;
  }

  .logo-placeholder {
    padding: 0.75rem 1.5rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px dashed var(--border-light);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    opacity: 0.7;
    transition: var(--transition);
  }

  .logo-placeholder:hover {
    opacity: 1;
    border-color: var(--primary);
    color: var(--primary);
  }
</style>
