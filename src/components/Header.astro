---
<!-- Top Bar -->
<header class="top-bar">
  <div class="container top-bar-inner">
    <span class="top-bar-item">
      <svg viewBox="0 0 24 24" fill="currentColor" width="13" height="13" aria-hidden="true">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
      </svg>
      <span>Treinamento de Brigada de Incêndio · NR-23 e NBR 14276</span>
    </span>
    <span class="top-bar-sep">|</span>
    <span class="top-bar-item">
      <svg viewBox="0 0 24 24" fill="currentColor" width="13" height="13" aria-hidden="true">
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
      </svg>
      <a href="https://bitlybr.net/TreinamentoBrigada" target="_blank" rel="noopener noreferrer">Fale com um especialista agora no WhatsApp</a>
    </span>
  </div>
</header>


<!-- Main Header (glassmorphism navy, sticky) -->
<header class="main-header">
  <div class="container nav-bar-inner">
    <a href="/" class="nav-logo" aria-label="Página Inicial - Treinamento de Brigada de Incêndio">
      <img src="/logotipo_brigada_incendio_transparente.svg" alt="Treinamento Brigada de Incêndio" class="nav-logo-img" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
      <div class="logo-fallback" style="display:none;">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="var(--white)">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        <span class="logo-fallback-text" style="color:var(--white);">BRIGADA DE <span style="color:var(--sand);">INCÊNDIO</span></span>
      </div>
    </a>
    <nav class="nav-menu" aria-label="Menu principal">
      <a href="/sobre">Sobre</a>
      <a href="/diferenciais">Diferenciais</a>
      <a href="/#treinamentos">Treinamentos</a>
      <a href="/blog">Blog</a>
      <button onclick="openQuoteModal()" class="nav-cta-btn">Solicitar Orçamento</button>
    </nav>
    <button class="mobile-menu-toggle" aria-label="Abrir menu" aria-expanded="false">
      <svg class="hamburger" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line class="line-top" x1="4" y1="6" x2="20" y2="6"></line>
        <line class="line-mid" x1="4" y1="12" x2="20" y2="12"></line>
        <line class="line-bot" x1="4" y1="18" x2="20" y2="18"></line>
      </svg>
    </button>
  </div>
</header>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;700;800&display=swap');

  :root {
    --navy: #1b2430;
    --sand: #e7ded0;
    --sand-2: #d8cbb4;
    --white: #f7f5f1;
    --line: rgba(255, 255, 255, 0.12);
    --spacing-sm: 1rem;
    --transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    --font-body: 'Archivo', sans-serif;
  }

  /* Containers */
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--spacing-sm);
    width: 100%;
    box-sizing: border-box;
  }

  /* Top Bar */
  .top-bar {
    background: var(--white);
    color: var(--navy);
    border-bottom: 1px solid rgba(27, 36, 48, 0.08);
    font-family: var(--font-body);
    font-size: 0.82rem;
  }
  .top-bar-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding: 0.4rem var(--spacing-sm);
  }
  .top-bar-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
  }
  .top-bar-item a {
    color: var(--navy);
    text-decoration: none;
    transition: var(--transition);
  }
  .top-bar-item a:hover { color: var(--sand-2); }
  .top-bar-item svg { color: var(--navy); flex-shrink: 0; opacity: 0.8; }
  .top-bar-sep { color: rgba(27, 36, 48, 0.2); font-size: 0.9rem; }

  /* Main Header */
  .main-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(27, 36, 48, 0.96);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
    padding: 0.6rem 0;
  }
  .nav-bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  
  .nav-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    gap: 0.6rem;
  }
  .nav-logo-img {
    height: 45px;
    width: auto;
    display: block;
  }
  .logo-fallback {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .logo-fallback-text {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.5rem;
    letter-spacing: 0.05em;
    line-height: 1;
  }

  .nav-menu {
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .nav-menu a {
    color: var(--white);
    text-decoration: none;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.88rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding-bottom: 2px;
    border-bottom: 2px solid transparent;
    transition: var(--transition);
  }
  .nav-menu a:hover { 
    color: var(--sand); 
    border-bottom-color: var(--sand); 
  }
  
  .nav-cta-btn {
    background-color: var(--sand);
    color: var(--navy) !important;
    padding: 0.5rem 1.2rem;
    border-radius: 3px;
    font-family: var(--font-body);
    font-size: 0.88rem;
    font-weight: 700 !important;
    text-transform: uppercase;
    letter-spacing: 1px;
    border: 1px solid transparent !important;
    cursor: pointer;
    transition: var(--transition);
  }
  .nav-cta-btn:hover {
    background-color: transparent !important;
    color: var(--sand) !important;
    border-color: var(--sand) !important;
    transform: translateY(-1px);
  }

  /* Hambúrguer */
  .mobile-menu-toggle {
    display: none;
    background: none;
    border: none;
    color: var(--white);
    cursor: pointer;
    padding: 0.5rem;
    z-index: 1100;
  }
  .mobile-menu-toggle svg {
    width: 28px;
    height: 28px;
    transition: transform 0.3s ease;
  }
  .mobile-menu-toggle line {
    transition: transform 0.3s ease, opacity 0.3s ease;
    transform-origin: center;
  }

  /* Hamburger animado */
  .mobile-menu-toggle.is-active .line-top {
    transform: translateY(6px) rotate(45deg);
  }
  .mobile-menu-toggle.is-active .line-mid {
    opacity: 0;
  }
  .mobile-menu-toggle.is-active .line-bot {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* Mobile */
  @media (max-width: 768px) {
    .mobile-menu-toggle {
      display: block;
    }

    .nav-logo-img {
      height: 25px;
    }
    
    .nav-bar-inner {
      justify-content: space-between;
    }

    .nav-menu {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(27, 36, 48, 0.98);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      z-index: 1050;
      gap: 2.5rem;
      transform: translateX(100%);
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .nav-menu.is-active {
      transform: translateX(0);
    }

    .nav-menu a, .nav-cta-btn {
      font-size: 1.25rem;
      letter-spacing: 2px;
    }

    .top-bar-sep { display: none; }
    .top-bar-inner { 
      flex-direction: column; 
      gap: 0.4rem; 
      justify-content: center;
      align-items: center;
      text-align: center; 
    }
  }
</style>

<script>
  const toggleBtn = document.querySelector('.mobile-menu-toggle');
  const navMenu = document.querySelector('.nav-menu');
  const menuLinks = document.querySelectorAll('.nav-menu a, .nav-cta-btn');

  if (toggleBtn && navMenu) {
    const toggleMenu = () => {
      const isActive = toggleBtn.classList.toggle('is-active');
      navMenu.classList.toggle('is-active');
      toggleBtn.setAttribute('aria-expanded', isActive.toString());
      document.body.style.overflow = isActive ? 'hidden' : '';
    };

    toggleBtn.addEventListener('click', toggleMenu);

    menuLinks.forEach(link => {
      link.addEventListener('click', () => {
        toggleBtn.classList.remove('is-active');
        navMenu.classList.remove('is-active');
        toggleBtn.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      });
    });
  }
</script>

