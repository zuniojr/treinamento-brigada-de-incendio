---
const steps = [
  {
    step: "01",
    title: "Solicitação & Cotação",
    desc: "A empresa entra em contato via WhatsApp, telefone ou formulário e nos informa a necessidade da equipe."
  },
  {
    step: "02",
    title: "Levantamento de Necessidades",
    desc: "Analisamos a ocupação da edificação, o grau de risco (Leve, Médio ou Alto) e a quantidade mínima de brigadistas."
  },
  {
    step: "03",
    title: "Planejamento Customizado",
    desc: "Definição das datas, local (In-Company ou Centro de Treinamento) e montagem do plano didático sob medida."
  },
  {
    step: "04",
    title: "Execução do Treinamento",
    desc: "Aplicação das aulas teóricas e simulação prática intensiva com equipamentos reais e controle de pânico."
  },
  {
    step: "05",
    title: "Certificação Homologada",
    desc: "Entrega imediata dos certificados individuais dos brigadistas e do atestado de formação para o Corpo de Bombeiros."
  }
];
---

<section id="como-funciona" class="section-padding timeline-section">
  <div class="container">
    <div class="section-header" data-animate="fade-up">
      <span class="section-subtitle">Passo a Passo Transparente</span>
      <h2 class="section-title">Como Funciona a Contratação e Execução do Treinamento</h2>
      <p class="section-desc">Fluxo descomplicado e eficiente para regularizar sua empresa com agilidade máxima.</p>
    </div>

    <div class="timeline-wrapper" id="timeline-container">
      <!-- Vertical track -->
      <div class="timeline-track">
        <div class="timeline-fill" id="timeline-fill"></div>
      </div>

      <div class="timeline-steps">
        {steps.map((item, index) => (
          <div
            class={`timeline-item ${index % 2 === 0 ? 'left' : 'right'}`}
            data-animate={index % 2 === 0 ? 'fade-right' : 'fade-left'}
            data-delay={String(index * 110)}
          >
            <!-- Number badge -->
            <div class="step-node">
              <span class="step-num">{item.step}</span>
            </div>

            <!-- Card -->
            <div class="step-card">
              <!-- Large decorative number -->
              <span class="step-bg-num" aria-hidden="true">{item.step}</span>
              <div class="step-tag-label">Etapa {item.step}</div>
              <h3 class="step-title">{item.title}</h3>
              <p class="step-desc">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="timeline-cta" data-animate="fade-up" data-delay="200">
      <button onclick="openQuoteModal()" class="btn btn-primary" id="timeline-cta-btn">
        <span>Iniciar Etapa 01 — Solicitar Orçamento</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
      </button>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var fill = document.getElementById('timeline-fill');
    var container = document.getElementById('timeline-container');
    if (!fill || !container) return;
    var done = false;
    var obs = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting && !done) {
          done = true;
          fill.style.transition = 'height 1.8s cubic-bezier(0.16, 1, 0.3, 1) 0.3s';
          fill.style.height = '100%';
          obs.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    obs.observe(container);
  })();
</script>

<style>
  .timeline-section {
    background: var(--bg-main);
    position: relative;
  }

  /* ---- Wrapper ---- */
  .timeline-wrapper {
    position: relative;
    max-width: 960px;
    margin: 0 auto 4rem auto;
  }

  /* ---- Vertical line ---- */
  .timeline-track {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    background: rgba(255, 255, 255, 0.06);
    transform: translateX(-50%);
    border-radius: 2px;
    overflow: hidden;
  }

  .timeline-fill {
    width: 100%;
    height: 0%;
    background: linear-gradient(180deg, var(--primary) 0%, var(--secondary) 100%);
    border-radius: 2px;
    box-shadow: 0 0 16px var(--primary-glow);
  }

  /* ---- Steps ---- */
  .timeline-steps {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .timeline-item {
    display: flex;
    align-items: center;
    width: 100%;
    position: relative;
  }

  .timeline-item.left {
    flex-direction: row-reverse;
  }

  .timeline-item.right {
    flex-direction: row;
    justify-content: flex-end;
  }

  /* ---- Node ---- */
  .step-node {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    width: 60px;
    height: 60px;
    background: var(--bg-card);
    border: 2px solid var(--primary);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 0 6px rgba(230, 48, 0, 0.08), 0 0 24px var(--primary-glow);
    transition: var(--transition);
    flex-shrink: 0;
  }

  .timeline-item:hover .step-node {
    background: var(--primary);
    box-shadow: 0 0 0 8px rgba(230, 48, 0, 0.12), 0 0 36px var(--primary-glow);
    transform: translateX(-50%) scale(1.12);
  }

  .step-num {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.15rem;
    color: var(--primary-light);
    letter-spacing: 0.05em;
    transition: color 0.25s;
  }

  .timeline-item:hover .step-num {
    color: #fff;
  }

  /* ---- Card ---- */
  .step-card {
    width: 43%;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.75rem 2rem;
    position: relative;
    overflow: hidden;
    transition: var(--transition);
    box-shadow: var(--shadow-sm);
  }

  .timeline-item:hover .step-card {
    border-color: var(--primary-border);
    background: var(--bg-card-hover);
    box-shadow: var(--shadow-card);
  }

  /* Large decorative number in background */
  .step-bg-num {
    position: absolute;
    top: -0.5rem;
    right: 1rem;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 6rem;
    color: rgba(230, 48, 0, 0.04);
    line-height: 1;
    user-select: none;
    pointer-events: none;
    transition: color 0.3s;
  }

  .timeline-item:hover .step-bg-num {
    color: rgba(230, 48, 0, 0.07);
  }

  .step-tag-label {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.10em;
    color: var(--primary-light);
    margin-bottom: 0.5rem;
    position: relative;
  }

  .step-title {
    font-size: 1.12rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 0.6rem;
    position: relative;
    letter-spacing: -0.01em;
  }

  .step-desc {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.65;
    position: relative;
  }

  /* ---- CTA ---- */
  .timeline-cta {
    text-align: center;
  }

  /* ---- Responsive ---- */
  @media (max-width: 768px) {
    .timeline-track {
      left: 28px;
    }

    .timeline-steps {
      gap: 2rem;
    }

    .timeline-item,
    .timeline-item.left,
    .timeline-item.right {
      flex-direction: row;
      justify-content: flex-start;
      padding-left: 72px;
    }

    .step-node {
      left: 28px;
      width: 52px;
      height: 52px;
    }

    .step-card {
      width: 100%;
    }
  }
</style>
