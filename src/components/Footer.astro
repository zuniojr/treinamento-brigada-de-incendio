---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <!-- Top Grid Section (5 Columns) -->
    <div class="footer-grid">
      <!-- Col 1: Brand Info -->
      <div class="footer-brand-col">
        <a href="/" class="footer-logo" aria-label="Página Inicial">
          <div class="logo-fallback" style="display:flex; align-items:center; gap:0.5rem;">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="var(--primary)">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
            <span class="logo-fallback-text" style="font-family:'Bebas Neue', sans-serif; font-size:1.5rem; color:var(--text-main); letter-spacing:0.05em;">BRIGADA<span style="color:var(--primary);">FIRE</span></span>
          </div>
        </a>

        <p class="footer-desc">
          Treinamentos corporativos de formação e reciclagem de Brigada de Incêndio de alta performance e excelência técnica conforme a NR-23.
        </p>
      </div>

      <!-- Col 2: Navegação -->
      <div class="footer-col">
        <h3 class="col-title">Navegação</h3>
        <ul class="footer-links">
          <li><a href="/">Início</a></li>
          <li><a href="/#sobre">Sobre Nós</a></li>
          <li><a href="/diferenciais">Nossos Diferenciais</a></li>
          <li><a href="/#treinamentos">Treinamentos</a></li>
          <li><a href="/blog">Blog</a></li>
        </ul>
      </div>

      <!-- Col 3: Serviços -->
      <div class="footer-col">
        <h3 class="col-title">Serviços</h3>
        <ul class="footer-links">
          <li><a href="/formacao-de-brigada">Formação de Brigada (NR-23)</a></li>
          <li><a href="/#treinamentos">Reciclagem e Atualização</a></li>
          <li><a href="/simulados-de-emergencia">Simulados de Emergência</a></li>
          <li><a href="/plano-de-abandono-de-area">Plano de Abandono de Área</a></li>
          <li><a href="/primeiros-socorros">Primeiros Socorros Corporativos</a></li>
        </ul>
      </div>

      <!-- Col 4: Atendimento -->
      <div class="footer-col">
        <h3 class="col-title">Atendimento</h3>
        <ul class="footer-links">
          <li><a href="/treinamento-in-company">Treinamento In-Company</a></li>
          <li><a href="/modulos-personalizados">Módulos Personalizados</a></li>
          <li><a href="/consultoria-tecnica">Consultoria Técnica</a></li>
          <li><a href="https://wa.me/5511999999999" target="_blank" rel="noopener noreferrer">Suporte Dedicado</a></li>
        </ul>
      </div>

      <!-- Col 5: Institucional -->
      <div class="footer-col">
        <h3 class="col-title">Institucional</h3>
        <ul class="footer-links">
          <li><a href="/termos-de-uso">Termos de Uso</a></li>
          <li><a href="/politica-de-privacidade">Política de Privacidade</a></li>
          <li><a href="/consideracoes-importantes">Considerações Importantes</a></li>
          <li><a href="/trabalhe-conosco">Trabalhe Conosco</a></li>
          <li><a href="/contato">Contato</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar Section -->
    <div class="footer-bottom">
      <p class="copyright-text">
        © {currentYear} BrigadaFire. Todos os direitos reservados.
      </p>

      <div class="footer-social-links">
        <a href="https://instagram.com" target="_blank" rel="noopener noreferrer">Instagram</a>
        <a href="https://facebook.com" target="_blank" rel="noopener noreferrer">Facebook</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: #080C14;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding: 5rem 0 2.5rem 0;
    color: var(--text-muted);
    font-family: 'Plus Jakarta Sans', sans-serif;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.8fr 1fr 1fr 1fr 1fr;
    gap: 3rem;
    padding-bottom: 4rem;
  }

  /* Coluna Brand */
  .footer-brand-col {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    padding-right: 1.5rem;
  }

  .footer-logo {
    display: inline-block;
  }

  .footer-desc {
    font-size: 0.9rem;
    line-height: 1.6;
    color: #94A3B8;
  }

  /* Colunas de Links */
  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .col-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: #FFFFFF;
    letter-spacing: -0.01em;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 0;
    margin: 0;
  }

  .footer-links a {
    font-size: 0.88rem;
    color: #94A3B8;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-links a:hover {
    color: #FFFFFF;
  }

  /* Footer Bottom */
  .footer-bottom {
    padding-top: 2.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.85rem;
  }

  .copyright-text {
    color: #94A3B8;
  }

  .footer-social-links {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .footer-social-links a {
    color: #94A3B8;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .footer-social-links a:hover {
    color: #FFFFFF;
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr 1fr;
      gap: 2.5rem;
    }
    .footer-brand-col {
      grid-column: span 3;
      padding-right: 0;
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
    .footer-brand-col {
      grid-column: span 1;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 1.25rem;
      align-items: flex-start;
    }
  }
</style>
