---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Col 1: Brand Info -->
      <div class="footer-brand">
        <a href="#" class="footer-logo">
          <div class="logo-icon" style="width: 36px; height: 36px;">
            <svg viewBox="0 0 512 512" fill="none" class="shield-svg">
              <path d="M256 32L64 96V240C64 360 148 448 256 480C364 448 448 360 448 240V96L256 32Z" fill="url(#ftr-shield)" stroke="#38BDF8" stroke-width="14"/>
              <path d="M256 140C256 140 290 190 290 230C290 255 275 275 256 275C237 275 222 255 222 230C222 190 256 140 256 140Z" fill="#F59E0B"/>
              <defs>
                <linearGradient id="ftr-shield" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#0EA5E9"/>
                  <stop offset="100%" stop-color="#1E3A8A"/>
                </linearGradient>
              </defs>
            </svg>
          </div>
          <span class="brand-title">TREINAMENTO <span style="color:var(--primary);">BRIGADA DE INCÊNDIO</span></span>
        </a>

        <p class="footer-desc">
          Referência em treinamentos corporativos de prevenção e combate a incêndio, formação de brigadistas e primeiros socorros em conformidade com as normas NR-23 e NBR 14276.
        </p>

        <div class="footer-socials">
          <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn corporativo">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
          </a>
          <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Instagram da empresa">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          </a>
          <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" aria-label="Facebook da empresa">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
          </a>
        </div>
      </div>

      <!-- Col 2: Quick Links -->
      <div class="footer-col">
        <h3 class="col-title">Links Rápidos</h3>
        <ul class="footer-links">
          <li><a href="#diferenciais">Diferenciais</a></li>
          <li><a href="#por-que-investir">Por que Investir</a></li>
          <li><a href="#treinamentos">Cursos e Módulos</a></li>
          <li><a href="#como-funciona">Como Funciona</a></li>
          <li><a href="#faq">Dúvidas Frequentes</a></li>
        </ul>
      </div>

      <!-- Col 3: Services -->
      <div class="footer-col">
        <h3 class="col-title">Treinamentos</h3>
        <ul class="footer-links">
          <li><a href="#treinamentos">Formação de Brigada (NR-23)</a></li>
          <li><a href="#treinamentos">Atualização / Reciclagem Anual</a></li>
          <li><a href="#treinamentos">Simulados de Emergência</a></li>
          <li><a href="#treinamentos">Plano de Abandono de Edificações</a></li>
          <li><a href="#treinamentos">Primeiros Socorros Corporativos</a></li>
        </ul>
      </div>

      <!-- Col 4: Contact -->
      <div class="footer-col">
        <h3 class="col-title">Atendimento Corporativo</h3>
        <ul class="contact-list">
          <li>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            <span>Central 0800: <strong>0800 999 8888</strong></span>
          </li>
          <li>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#25D366" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
            <span>WhatsApp: <strong>(11) 99999-9999</strong></span>
          </li>
          <li>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            <span>E-mail: contato@treinamentobrigadadeincendio.com.br</span>
          </li>
          <li>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2"><path d="M21 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            <span>Atendimento em todo o Brasil (In-Company e Centros Homologados)</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {currentYear} Treinamento de Brigada de Incêndio Corporativo. Todos os direitos reservados.</p>
      <p class="footer-legal">Conformidade total com a Norma Regulamentadora NR-23 e ABNT NBR 14276.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: #070B14;
    border-top: 1px solid var(--border);
    padding: 5rem 0 2rem 0;
    color: var(--text-muted);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.5fr;
    gap: 3rem;
    margin-bottom: 4rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .footer-desc {
    font-size: 0.9rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .footer-socials {
    display: flex;
    gap: 1rem;
  }

  .footer-socials a {
    width: 38px;
    height: 38px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-main);
    transition: var(--transition);
  }

  .footer-socials a:hover {
    background: var(--primary);
    color: #FFFFFF;
    border-color: var(--primary);
  }

  .col-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 1.25rem;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-links a {
    font-size: 0.9rem;
    transition: var(--transition);
  }

  .footer-links a:hover {
    color: var(--primary);
    padding-left: 4px;
  }

  .contact-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.88rem;
    line-height: 1.4;
  }

  .contact-list strong {
    color: var(--text-main);
  }

  .footer-bottom {
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.85rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-legal {
    color: var(--text-subtle);
    font-size: 0.8rem;
  }

  @media (max-width: 992px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 576px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .footer-bottom {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
