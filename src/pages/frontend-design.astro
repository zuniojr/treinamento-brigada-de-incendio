---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import QuoteModal from '../components/QuoteModal.astro';
---

<Layout 
  title="Frontend & UI Design System | Treinamento de Brigada de Incêndio"
  description="Conheça as diretrizes de design de interface, tipografia, paleta de cores corporativas de segurança e princípios de experiência do usuário aplicados nesta plataforma."
>
  <Header />

  <main id="main-content" class="design-system-page">
    <!-- Hero Section -->
    <section class="ds-hero">
      <div class="ds-hero-bg">
        <div class="ds-glow-orb ds-glow-left"></div>
        <div class="ds-glow-orb ds-glow-right"></div>
        <div class="ds-grid-pattern"></div>
      </div>

      <div class="container ds-hero-content" data-animate>
        <div class="ds-badge">
          <span class="ds-badge-dot"></span>
          <span>Guia de Estilo & Frontend Design System</span>
        </div>
        
        <h1 class="font-display ds-title">
          EXCELÊNCIA VISUAL & <span class="text-gradient">ENGENHARIA UI</span>
        </h1>
        
        <p class="ds-subtitle">
          Uma arquitetura de design intencional desenvolvida para transmitir autoridade, urgência e precisão em treinamentos de Brigada de Incêndio e segurança do trabalho.
        </p>

        <div class="ds-quick-stats">
          <div class="ds-stat-card">
            <span class="ds-stat-num">AA+</span>
            <span class="ds-stat-label">Acessibilidade WCAG</span>
          </div>
          <div class="ds-stat-card">
            <span class="ds-stat-num">100%</span>
            <span class="ds-stat-label">Modo Escuro Premium</span>
          </div>
          <div class="ds-stat-card">
            <span class="ds-stat-num">60FPS</span>
            <span class="ds-stat-label">Micro-interações Fluidas</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Color Tokens Section -->
    <section class="section-padding ds-section">
      <div class="container">
        <div class="ds-section-header" data-animate>
          <span class="ds-section-eyebrow">01 / PALETA DE CORES</span>
          <h2>Cores com Propósito de Segurança & Urgência</h2>
          <p>Nossa paleta elimina a genérica neutralidade e adota tons vibrantes baseados nos elementos reais de combate ao fogo e sinalização de emergência.</p>
        </div>

        <div class="ds-color-grid" data-animate>
          <!-- Primary Fire -->
          <div class="ds-color-card">
            <div class="ds-color-swatch" style="background: var(--primary);">
              <span class="ds-swatch-hex">#E63000</span>
            </div>
            <div class="ds-color-info">
              <h3>Fire Orange Primary</h3>
              <p>Cor primária de ação, botão de emergência e elementos de maior hierarquia visual.</p>
              <code>var(--primary)</code>
            </div>
          </div>

          <!-- Secondary Deep -->
          <div class="ds-color-card">
            <div class="ds-color-swatch" style="background: var(--secondary);">
              <span class="ds-swatch-hex">#A82200</span>
            </div>
            <div class="ds-color-info">
              <h3>Deep Crimson</h3>
              <p>Usado para gradientes profundos, sombras incandescentes e elementos complementares.</p>
              <code>var(--secondary)</code>
            </div>
          </div>

          <!-- Alert Gold -->
          <div class="ds-color-card">
            <div class="ds-color-swatch" style="background: var(--accent-alert);">
              <span class="ds-swatch-hex">#F59E0B</span>
            </div>
            <div class="ds-color-info">
              <h3>Amber Alert Signal</h3>
              <p>Destaques normativos (NR-23, NBR 14276) e selos de homologação oficial.</p>
              <code>var(--accent-alert)</code>
            </div>
          </div>

          <!-- Dark Canvas -->
          <div class="ds-color-card">
            <div class="ds-color-swatch" style="background: var(--bg-main); border: 1px solid var(--border-light);">
              <span class="ds-swatch-hex">#0A0A0A</span>
            </div>
            <div class="ds-color-info">
              <h3>Obsidian Canvas</h3>
              <p>Fundo escuro profundo para contraste máximo com chamas e elementos iluminados.</p>
              <code>var(--bg-main)</code>
            </div>
          </div>

          <!-- Surface Card -->
          <div class="ds-color-card">
            <div class="ds-color-swatch" style="background: var(--bg-card); border: 1px solid var(--border-light);">
              <span class="ds-swatch-hex">#141414</span>
            </div>
            <div class="ds-color-info">
              <h3>Elevated Card Surface</h3>
              <p>Superfície para módulos práticos, simuladores e cartões de depoimento.</p>
              <code>var(--bg-card)</code>
            </div>
          </div>

          <!-- Glass Backdrop -->
          <div class="ds-color-card">
            <div class="ds-color-swatch" style="background: rgba(10, 10, 10, 0.9); backdrop-filter: blur(12px); border: 1px solid var(--border-light);">
              <span class="ds-swatch-hex">Glassmorphism</span>
            </div>
            <div class="ds-color-info">
              <h3>Frosted Glass Filter</h3>
              <p>Usado no Header fixo e modais interativos para fluidez na rolagem.</p>
              <code>var(--bg-glass)</code>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Typography Section -->
    <section class="section-padding ds-section ds-alt-bg">
      <div class="container">
        <div class="ds-section-header" data-animate>
          <span class="ds-section-eyebrow">02 / TIPOGRAFIA</span>
          <h2>Hierarquia Visual & Dupla de Fontes</h2>
          <p>Combinamos o impacto industrial de <strong>Bebas Neue</strong> para chamadas de alto impacto com a precisão contemporânea da <strong>Plus Jakarta Sans</strong>.</p>
        </div>

        <div class="ds-type-showcase" data-animate>
          <!-- Display Font -->
          <div class="ds-type-block">
            <span class="ds-type-tag">Display / Headlines — Bebas Neue</span>
            <div class="ds-display-preview font-display">
              TREINAMENTO TÁTICO & COMBATE A INCÊNDIO
            </div>
            <p class="ds-type-meta">Projetado em caixa alta com letter-spacing levemente expandido para transmitir robustez técnica e autoridade instantânea.</p>
          </div>

          <!-- Body Font Scale -->
          <div class="ds-type-block">
            <span class="ds-type-tag">Body & UI — Plus Jakarta Sans</span>
            <div class="ds-body-samples">
              <div class="ds-type-sample">
                <span class="ds-sample-label">Heading 2 (700)</span>
                <span class="ds-sample-text h2-size">Treinamento em Conformidade com NR-23 e NBR 14276</span>
              </div>
              <div class="ds-type-sample">
                <span class="ds-sample-label">Body Large (500)</span>
                <span class="ds-sample-text body-lg">Capacitamos a equipe da sua empresa para agir com rapidez, mantendo o pânico sob controle em situações críticas.</span>
              </div>
              <div class="ds-type-sample">
                <span class="ds-sample-label">Caption & Badges (600 Uppercase)</span>
                <span class="ds-sample-text caption-text">NORMA REGULAMENTADORA APROVADA PELO CORPO DE BOMBEIROS</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- UI Components Showcase -->
    <section class="section-padding ds-section">
      <div class="container">
        <div class="ds-section-header" data-animate>
          <span class="ds-section-eyebrow">03 / COMPONENTES DE INTERFACE</span>
          <h2>Micro-interações e Elementos Interativos</h2>
          <p>Todos os elementos da interface possuem estados focados em usabilidade e feedback imediato ao usuário.</p>
        </div>

        <div class="ds-components-grid" data-animate>
          <!-- Buttons Card -->
          <div class="ds-comp-card">
            <h3>Botões & Ações Principais</h3>
            <div class="ds-comp-row">
              <button class="btn btn-primary">
                <span>Solicitar Orçamento</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </button>

              <button class="btn btn-secondary">
                <span>Ver Grade de Módulos</span>
              </button>
            </div>
          </div>

          <!-- Badges & Tags -->
          <div class="ds-comp-card">
            <h3>Sinalizadores & Tags</h3>
            <div class="ds-comp-row">
              <span class="ds-demo-badge alert">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                Certificação Válida
              </span>
              <span class="ds-demo-badge fire">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
                Prática com Fogo Real
              </span>
            </div>
          </div>

          <!-- Feature Card Interactive Demo -->
          <div class="ds-comp-card full-width">
            <h3>Card de Módulo Com Efeito Hover Glowing</h3>
            <div class="ds-interactive-card-preview">
              <div class="ds-feature-box">
                <div class="ds-feature-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><circle cx="12" cy="12" r="3"/></svg>
                </div>
                <h4>Simulação de Abandono de Área</h4>
                <p>Treinamento prático e imersivo com rotas de fuga, sinalização de pânico e evacuação ordenada de edifícios corporativos e plantas industriais.</p>
                <div class="ds-feature-footer">
                  <span>Carga Horária: 8h a 24h</span>
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Design Principles & Signature -->
    <section class="section-padding ds-section ds-alt-bg">
      <div class="container">
        <div class="ds-section-header" data-animate>
          <span class="ds-section-eyebrow">04 / DIRETRIZES & SIGNATURE</span>
          <h2>Princípios da Assinatura Visual</h2>
        </div>

        <div class="ds-principles-grid" data-animate>
          <div class="ds-principle-card">
            <div class="ds-principle-num">01</div>
            <h3>Contraste de Alta Densidade</h3>
            <p>O ambiente escuro profundo com acentos luminosos garante clareza visual mesmo sob baixa luminosidade ou telas industriais.</p>
          </div>

          <div class="ds-principle-card">
            <div class="ds-principle-num">02</div>
            <h3>Micro-Animação Não Intrusiva</h3>
            <p>As transições de brilho (glowing gradients) e parallax suave direcionam a atenção aos botões de orçamentos e certificações sem poluição visual.</p>
          </div>

          <div class="ds-principle-card">
            <div class="ds-principle-num">03</div>
            <h3>Semântica & Foco em Segurança</h3>
            <p>Uso estrito do amarelo para normas/alertas e vermelho para ação/combate, reforçando o código visual de segurança do trabalho.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Call to action inside system -->
    <section class="ds-bottom-cta">
      <div class="container" data-animate>
        <div class="ds-cta-box">
          <h2 class="font-display">PRONTO PARA ADEQUAR SUA EMPRESA?</h2>
          <p>Solicite uma proposta personalizada para formação ou reciclagem da Brigada de Incêndio corporativa.</p>
          <button onclick="openQuoteModal()" class="btn btn-primary btn-lg">
            <span>Solicitar Orçamento Agora</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </button>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppButton />
  <QuoteModal />
</Layout>

<style>
  /* Page Layout */
  .design-system-page {
    padding-top: 5rem;
  }

  /* Hero Section */
  .ds-hero {
    position: relative;
    padding: 7rem 0 5rem 0;
    overflow: hidden;
    background: radial-gradient(circle at 50% 0%, #1A0500 0%, var(--bg-main) 75%);
    border-bottom: 1px solid var(--border);
  }

  .ds-hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .ds-glow-orb {
    position: absolute;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.25;
  }

  .ds-glow-left {
    top: -100px;
    left: -100px;
    background: var(--primary);
  }

  .ds-glow-right {
    top: 50px;
    right: -100px;
    background: var(--accent-alert);
  }

  .ds-grid-pattern {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(ellipse at center, black 40%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 40%, transparent 80%);
  }

  .ds-hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 900px;
  }

  .ds-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 1rem;
    border-radius: var(--radius-full);
    background: rgba(230, 48, 0, 0.12);
    border: 1px solid var(--primary-border);
    color: var(--primary-light);
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    letter-spacing: 0.03em;
  }

  .ds-badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--primary-light);
    box-shadow: 0 0 10px var(--primary);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.3); }
  }

  .ds-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    letter-spacing: 0.02em;
    margin-bottom: 1.2rem;
    line-height: 1.05;
  }

  .text-gradient {
    background: linear-gradient(135deg, #FFFFFF 0%, var(--primary-light) 60%, var(--accent-alert) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .ds-subtitle {
    font-size: 1.2rem;
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 750px;
    margin: 0 auto 3rem auto;
  }

  .ds-quick-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    max-width: 750px;
    margin: 0 auto;
  }

  .ds-stat-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .ds-stat-num {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2rem;
    color: var(--primary-light);
    line-height: 1;
  }

  .ds-stat-label {
    font-size: 0.82rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  /* Sections general */
  .ds-section {
    position: relative;
    border-bottom: 1px solid var(--border);
  }

  .ds-alt-bg {
    background-color: var(--bg-elevated);
  }

  .ds-section-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 3.5rem auto;
  }

  .ds-section-eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--primary-light);
    letter-spacing: 0.15em;
    margin-bottom: 0.75rem;
  }

  .ds-section-header h2 {
    font-size: 2.2rem;
    margin-bottom: 1rem;
  }

  .ds-section-header p {
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  /* Color Grid */
  .ds-color-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.75rem;
  }

  .ds-color-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: var(--transition);
  }

  .ds-color-card:hover {
    border-color: var(--border-light);
    transform: translateY(-4px);
    box-shadow: var(--shadow-card);
  }

  .ds-color-swatch {
    height: 120px;
    position: relative;
    display: flex;
    align-items: flex-end;
    padding: 0.75rem;
  }

  .ds-swatch-hex {
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(8px);
    color: #FFF;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-xs);
    font-size: 0.78rem;
    font-family: monospace;
    font-weight: 600;
  }

  .ds-color-info {
    padding: 1.25rem;
  }

  .ds-color-info h3 {
    font-size: 1.1rem;
    margin-bottom: 0.4rem;
  }

  .ds-color-info p {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
    line-height: 1.4;
  }

  .ds-color-info code {
    font-size: 0.75rem;
    background: rgba(255, 255, 255, 0.06);
    color: var(--accent-alert-light);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-xs);
  }

  /* Typography Showcase */
  .ds-type-showcase {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .ds-type-block {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 2rem;
  }

  .ds-type-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent-alert);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }

  .ds-display-preview {
    font-size: clamp(2rem, 4vw, 3.2rem);
    color: var(--text-main);
    letter-spacing: 0.02em;
    margin-bottom: 1rem;
  }

  .ds-type-meta {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .ds-body-samples {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .ds-type-sample {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .ds-sample-label {
    font-size: 0.78rem;
    color: var(--text-subtle);
    font-weight: 600;
  }

  .h2-size {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .body-lg {
    font-size: 1.1rem;
    color: var(--text-muted);
  }

  .caption-text {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--primary-light);
    letter-spacing: 0.08em;
  }

  /* Components Showcase */
  .ds-components-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .ds-comp-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .ds-comp-card.full-width {
    grid-column: span 2;
  }

  .ds-comp-card h3 {
    font-size: 1.1rem;
    color: var(--text-main);
  }

  .ds-comp-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .ds-demo-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-full);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .ds-demo-badge.alert {
    background: rgba(245, 158, 11, 0.12);
    border: 1px solid var(--border-alert);
    color: var(--accent-alert-light);
  }

  .ds-demo-badge.fire {
    background: var(--primary-dim);
    border: 1px solid var(--primary-border);
    color: var(--primary-light);
  }

  .ds-feature-box {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 2rem;
    position: relative;
    overflow: hidden;
    transition: var(--transition);
  }

  .ds-feature-box:hover {
    border-color: var(--primary-border);
    box-shadow: var(--shadow-glow);
    transform: translateY(-2px);
  }

  .ds-feature-icon {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-md);
    background: var(--primary-dim);
    border: 1px solid var(--primary-border);
    color: var(--primary-light);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .ds-feature-box h4 {
    font-size: 1.3rem;
    margin-bottom: 0.6rem;
  }

  .ds-feature-box p {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }

  .ds-feature-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--primary-light);
    border-top: 1px solid var(--border);
    padding-top: 1rem;
  }

  /* Principles Grid */
