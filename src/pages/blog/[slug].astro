---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';

import { allPosts } from '../../data/blogPosts';

export function getStaticPaths() {
  return allPosts.map(post => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;

// Get up to 3 related posts (same category first, then others, excluding current)
const relatedPosts = [
  ...allPosts.filter(p => p.slug !== post.slug && p.category === post.category),
  ...allPosts.filter(p => p.slug !== post.slug && p.category !== post.category),
].slice(0, 3);
---

<Layout
  title={`${post.title} | Blog Brigada de Incêndio`}
  description={post.excerpt}
  image={post.image}
>
  <Header />

  <!-- Signature Element: Reading Progress Bar -->
  <div class="reading-progress-bar" id="reading-progress" role="progressbar" aria-label="Progresso de leitura" aria-valuenow={0} aria-valuemin={0} aria-valuemax={100}></div>

  <main class="post-page" id="main-content">

    <!-- Breadcrumb Navigation -->
    <div class="breadcrumb-bar">
      <div class="container">
        <nav class="breadcrumb" aria-label="Trilha de navegação">
          <a href="/">Início</a>
          <span class="bc-sep" aria-hidden="true">›</span>
          <a href="/blog">Blog</a>
          <span class="bc-sep" aria-hidden="true">›</span>
          <span class="bc-current">{post.category}</span>
        </nav>
      </div>
    </div>

    <!-- Post Hero Header -->
    <section class="post-hero">
      <div class="container">
        <div class="post-hero-content" data-animate="fade-up">
          <div class="post-meta-row">
            <span class="post-category-badge">{post.category}</span>
            <span class="meta-dot" aria-hidden="true">·</span>
            <span class="post-meta-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
              {post.date}
            </span>
            <span class="meta-dot" aria-hidden="true">·</span>
            <span class="post-meta-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              {post.readTime}
            </span>
          </div>

          <h1 class="post-title">{post.title}</h1>
          <p class="post-excerpt">{post.excerpt}</p>

          <div class="post-author-mini">
            <div class="author-avatar-sm" aria-hidden="true">{post.author.charAt(0)}</div>
            <div>
              <strong>{post.author}</strong>
              <span>{post.authorRole}</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Full-width Hero Image -->
    <div class="post-hero-image-wrapper">
      <div class="container">
        <figure class="post-hero-figure" data-animate="fade-up">
          <img src={post.image} alt={post.title} class="post-hero-img" loading="eager" />
          {post.imageCaption && <figcaption class="post-img-caption">{post.imageCaption}</figcaption>}
        </figure>
      </div>
    </div>

    <!-- Article Body + Sticky Sidebar -->
    <div class="post-body-layout">
      <div class="container">
        <div class="post-layout-grid">

          <!-- Main Article Content -->
          <article class="post-article" id="post-article">
            <div class="article-body" set:html={post.content} />

            <!-- Article Tags -->
            <div class="post-tags-row">
              <span class="tags-label">Tags:</span>
              <div class="post-tags-list">
                {post.tags.map(tag => (
                  <span class="post-tag-pill">{tag}</span>
                ))}
              </div>
            </div>

            <!-- Social Share -->
            <div class="post-share-row">
              <span class="share-label">Compartilhar:</span>
              <div class="share-buttons">
                <a
                  href={`https://wa.me/?text=${encodeURIComponent(post.title)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="share-btn share-wa"
                  aria-label="Compartilhar no WhatsApp"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                  WhatsApp
                </a>
                <a
                  href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent('https://treinamentobrigadadeincendio.com.br/blog/' + post.slug)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="share-btn share-li"
                  aria-label="Compartilhar no LinkedIn"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
                  LinkedIn
                </a>
              </div>
            </div>

            <!-- Author Box -->
            <div class="author-box glass-card">
              <div class="author-avatar-lg" aria-hidden="true">{post.author.charAt(0)}</div>
              <div class="author-box-body">
                <span class="author-box-label">Escrito por</span>
                <strong class="author-box-name">{post.author}</strong>
                <span class="author-box-role">{post.authorRole}</span>
                <p class="author-box-bio">{post.authorBio}</p>
              </div>
            </div>
          </article>

          <!-- Sticky Sidebar -->
          <aside class="post-sidebar" id="post-sidebar" aria-label="Barra lateral do artigo">

            <!-- Table of Contents -->
            <div class="sidebar-toc glass-card">
              <h2 class="toc-title">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                Neste artigo
              </h2>
              <nav class="toc-nav" id="toc-nav" aria-label="Sumário do artigo">
                {post.sections.map(section => (
                  <a href={`#${section.id}`} class="toc-link" data-target={section.id}>
                    {section.title}
                  </a>
                ))}
              </nav>
            </div>

            <!-- CTA Card -->
            <div class="sidebar-cta glass-card">
              <div class="sidebar-cta-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="var(--primary)"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              </div>
              <h3 class="sidebar-cta-title">Regularize a Brigada da sua Empresa</h3>
              <p class="sidebar-cta-desc">Treinamento In-Company, conformidade com a NR-23 e certificação válida. Atendemos em todo o Brasil.</p>
              <button onclick="openQuoteModal()" class="btn btn-primary sidebar-cta-btn" id="sidebar-orcamento-btn">
                Solicitar Orçamento
              </button>
            </div>

            <!-- Reading Progress Widget -->
            <div class="sidebar-progress glass-card">
              <div class="progress-header">
                <span class="progress-label">Progresso de leitura</span>
                <span class="progress-pct" id="progress-pct">0%</span>
              </div>
              <div class="progress-track">
                <div class="progress-fill" id="progress-fill"></div>
              </div>
            </div>

          </aside>
        </div>
      </div>
    </div>

    <!-- Related Posts -->
    {relatedPosts.length > 0 && (
      <section class="related-section section-padding" aria-labelledby="related-heading">
        <div class="container">
          <div class="related-header" data-animate="fade-up">
            <span class="eyebrow">Continue Aprendendo</span>
            <h2 class="related-title font-display" id="related-heading">ARTIGOS RELACIONADOS</h2>
          </div>

          <div class="related-grid">
            {relatedPosts.map((related, i) => (
              <a href={`/blog/${related.slug}`} class="related-card glass-card" data-animate="fade-up" data-delay={String(i * 100)} aria-label={`Ler artigo: ${related.title}`}>
                <div class="related-img-wrapper">
                  <img src={related.image} alt="" class="related-img" loading="lazy" aria-hidden="true" />
                  <span class="related-tag">{related.category}</span>
                </div>
                <div class="related-body">
                  <span class="related-date">{related.date} · {related.readTime}</span>
                  <h3 class="related-post-title">{related.title}</h3>
                  <span class="related-read-more" aria-hidden="true">
                    Ler artigo
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Bottom CTA Banner -->
    <section class="post-cta-section" aria-labelledby="post-cta-heading">
      <div class="container">
        <div class="post-cta-banner glass-card" data-animate="fade-up">
          <div class="post-cta-content">
            <span class="eyebrow">Treinamento & Conformidade</span>
            <h2 class="post-cta-title font-display" id="post-cta-heading">SUA EMPRESA ESTÁ PREPARADA PARA UMA EMERGÊNCIA?</h2>
            <p class="post-cta-desc">Não espere uma vistoria ou um sinistro. Nossos especialistas desenvolvem um programa de treinamento personalizado para o porte e o risco da sua operação.</p>
          </div>
          <div class="post-cta-actions">
            <button onclick="openQuoteModal()" class="btn btn-primary btn-lg" id="post-cta-orcamento-btn">
              Solicitar Orçamento Grátis
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </button>
            <a href="/blog" class="btn btn-outline" id="back-to-blog-btn">
              ← Voltar ao Blog
            </a>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
  <WhatsAppButton />

  <script>
    document.addEventListener('DOMContentLoaded', () => {

      // ── Reading Progress Bar + Sidebar Widget ──────────────────
      const progressBar   = document.getElementById('reading-progress') as HTMLElement;
      const progressFill  = document.getElementById('progress-fill') as HTMLElement;
      const progressPct   = document.getElementById('progress-pct') as HTMLElement;
      const article       = document.getElementById('post-article') as HTMLElement;

      function updateProgress() {
        if (!article) return;
        const articleTop    = article.offsetTop;
        const articleHeight = article.offsetHeight;
        const scrolled      = window.scrollY;
        const winH          = window.innerHeight;
        const raw           = (scrolled - articleTop + winH * 0.5) / articleHeight;
        const pct           = Math.round(Math.min(Math.max(raw, 0), 1) * 100);

        if (progressBar)  { progressBar.style.width = `${pct}%`; progressBar.setAttribute('aria-valuenow', String(pct)); }
        if (progressFill) progressFill.style.width  = `${pct}%`;
        if (progressPct)  progressPct.textContent   = `${pct}%`;
      }

      window.addEventListener('scroll', updateProgress, { passive: true });
      updateProgress();

      // ── Table of Contents Active Heading ──────────────────────
      const tocLinks         = document.querySelectorAll('.toc-link') as NodeListOf<HTMLAnchorElement>;
      const sectionHeadings  = document.querySelectorAll('.post-article h2[id]') as NodeListOf<HTMLElement>;

      if (sectionHeadings.length > 0) {
        const headingObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                const id = entry.target.getAttribute('id');
                tocLinks.forEach(link => {
                  link.classList.toggle('active', link.getAttribute('data-target') === id);
                });
              }
            });
          },
          { rootMargin: '-15% 0px -70% 0px', threshold: 0 }
        );
        sectionHeadings.forEach(h => headingObserver.observe(h));
      }
    });
  </script>

  <style>
    /* ── Reading Progress Bar (Signature Element) ── */
    .reading-progress-bar {
      position: fixed;
      top: 0;
      left: 0;
      height: 3px;
      width: 0%;
      background: linear-gradient(90deg, var(--primary) 0%, var(--primary-light) 60%, #FF8A65 100%);
      z-index: 2000;
      transition: width 0.12s linear;
      box-shadow: 0 0 14px var(--primary-glow);
    }

    /* ── Page Base ── */
    .post-page {
      padding-top: 5.5rem;
    }

    /* ── Breadcrumb ── */
    .breadcrumb-bar {
      padding: 1rem 0;
      border-bottom: 1px solid var(--border);
      background: var(--bg-elevated);
    }

    .breadcrumb {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.82rem;
      color: var(--text-subtle);
      flex-wrap: wrap;
    }

    .breadcrumb a {
      color: var(--text-subtle);
      transition: color 0.2s;
    }

    .breadcrumb a:hover { color: var(--primary-light); }

    .bc-sep { color: var(--border-light); }

    .bc-current {
      color: var(--primary-light);
      font-weight: 600;
    }

    /* ── Post Hero ── */
    .post-hero {
      padding: 4.5rem 0 3rem 0;
      border-bottom: 1px solid var(--border);
      background: radial-gradient(circle at 65% 0%, rgba(230, 48, 0, 0.09) 0%, transparent 55%);
    }

    .post-hero-content { max-width: 820px; }

    .post-meta-row {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 0.82rem;
      color: var(--text-subtle);
      margin-bottom: 1.5rem;
      flex-wrap: wrap;
    }

    .post-category-badge {
      background: var(--primary-dim);
      border: 1px solid var(--primary-border);
      color: var(--primary-light);
      padding: 0.3rem 0.85rem;
      border-radius: var(--radius-full);
      font-size: 0.73rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .meta-dot { color: var(--border-light); }

    .post-meta-item {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
    }

    .post-title {
      font-size: clamp(2rem, 4vw, 3rem);
      font-weight: 800;
      line-height: 1.2;
      letter-spacing: -0.025em;
      color: var(--text-main);
      margin-bottom: 1.25rem;
    }

    .post-excerpt {
      font-size: 1.18rem;
      color: var(--text-muted);
      line-height: 1.7;
      margin-bottom: 2rem;
      max-width: 700px;
    }

    .post-author-mini {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }

    .author-avatar-sm {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      background: var(--gradient-fire);
      color: #fff;
      font-weight: 800;
      font-size: 1.1rem;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .post-author-mini strong {
      display: block;
      font-size: 0.9rem;
      color: var(--text-main);
    }

    .post-author-mini span {
      font-size: 0.78rem;
      color: var(--text-subtle);
    }

    /* ── Hero Image ── */
    .post-hero-image-wrapper { padding: 3rem 0 0 0; }

    .post-hero-figure { margin: 0; }

    .post-hero-img {
      width: 100%;
      height: 480px;
      object-fit: cover;
      border-radius: var(--radius-lg);
      border: 1px solid var(--border);
    }

    .post-img-caption {
      font-size: 0.82rem;
      color: var(--text-subtle);
      text-align: center;
      margin-top: 0.75rem;
      font-style: italic;
    }

    /* ── Article + Sidebar Grid ── */
    .post-body-layout { padding: 5rem 0; }

    .post-layout-grid {
      display: grid;
      grid-template-columns: 1fr 340px;
      gap: 4rem;
      align-items: start;
    }

    /* ── Article Body ── */
    .post-article { min-width: 0; }

    .article-body h2 {
      font-size: clamp(1.45rem, 2.5vw, 1.9rem);
      font-weight: 800;
      color: var(--text-main);
      margin: 3rem 0 1.1rem 0;
      padding-top: 1rem;
      letter-spacing: -0.02em;
      border-top: 1px solid var(--border);
      scroll-margin-top: 6.5rem;
    }

    .article-body h2:first-child {
      margin-top: 0;
      padding-top: 0;
      border-top: none;
    }

    .article-body p {
      font-size: 1.06rem;
      line-height: 1.82;
      color: var(--text-muted);
      margin-bottom: 1.35rem;
    }

    .article-body p strong { color: var(--text-main); font-weight: 700; }

    .article-body ul,
    .article-body ol {
      padding-left: 1.5rem;
      margin-bottom: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
    }

    .article-body li {
      font-size: 1.04rem;
      line-height: 1.7;
      color: var(--text-muted);
    }

    .article-body li strong { color: var(--text-main); }

    .article-body ul li::marker { color: var(--primary); }

    /* Pull-quote: the risk element */
    .article-body blockquote.pull-quote {
      position: relative;
      margin: 2.5rem 0;
      padding: 2rem 2rem 2rem 2.5rem;
      background: linear-gradient(var(--bg-card), var(--bg-card)) padding-box,
                  linear-gradient(180deg, var(--primary-light), var(--primary)) border-box;
      border: 0 solid transparent;
      border-left-width: 4px;
      border-radius: 0 var(--radius-md) var(--radius-md) 0;
      overflow: hidden;
    }

    .article-body blockquote.pull-quote::before {
      content: '\201C';
      font-family: 'Bebas Neue', sans-serif;
      font-size: 9rem;
      line-height: 0.75;
      color: rgba(230, 48, 0, 0.13);
      position: absolute;
      top: 0.75rem;
      left: 0.75rem;
      pointer-events: none;
      user-select: none;
    }

    .article-body blockquote.pull-quote p {
      position: relative;
      font-size: 1.16rem;
      font-weight: 600;
      color: var(--text-main);
      line-height: 1.6;
      font-style: italic;
      margin-bottom: 0.7rem;
    }

    .article-body blockquote.pull-quote cite {
      position: relative;
      display: block;
      font-size: 0.82rem;
      color: var(--primary-light);
      font-style: normal;
      font-weight: 700;
      letter-spacing: 0.04em;
    }

    /* ── Tags ── */
    .post-tags-row {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      padding: 2rem 0;
      border-top: 1px solid var(--border);
      margin-top: 3rem;
      flex-wrap: wrap;
    }

    .tags-label {
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--text-subtle);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      flex-shrink: 0;
    }

    .post-tags-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .post-tag-pill {
      padding: 0.35rem 0.9rem;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-full);
      font-size: 0.8rem;
      color: var(--text-muted);
      font-weight: 600;
      transition: var(--transition);
      cursor: default;
    }

    .post-tag-pill:hover {
      border-color: var(--primary-border);
      color: var(--primary-light);
    }

    /* ── Share Row ── */
    .post-share-row {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 1.5rem 0;
      border-bottom: 1px solid var(--border);
      flex-wrap: wrap;
    }

    .share-label {
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--text-subtle);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .share-buttons { display: flex; gap: 0.75rem; }

    .share-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.55rem 1.1rem;
      border-radius: var(--radius-md);
      font-size: 0.85rem;
      font-weight: 700;
      border: 1px solid var(--border);
      background: var(--bg-card);
      color: var(--text-muted);
