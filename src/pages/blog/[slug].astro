---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';

import { allPosts } from '../../data/blogPosts';

export function getStaticPaths() {
  return allPosts.map(post => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;

// Get up to 3 related posts (same category first, then others, excluding current)
const relatedPosts = [
  ...allPosts.filter(p => p.slug !== post.slug && p.category === post.category),
  ...allPosts.filter(p => p.slug !== post.slug && p.category !== post.category),
].slice(0, 3);

const postUrl = `https://treinamentobrigadadeincendio.com.br/blog/${post.slug}`;
---

<Layout
  title={`${post.title} | Blog Brigada de Incêndio`}
  description={post.excerpt}
  image={post.image}
>
  <Header />

  <!-- Reading Progress Bar (topo da página) -->
  <div class="reading-progress-bar" id="reading-progress" role="progressbar" aria-label="Progresso de leitura" aria-valuenow={0} aria-valuemin={0} aria-valuemax={100}></div>

  <main class="post-page" id="main-content">

    <!-- ═══════════════════════════════════════════
         HERO — Imagem de fundo + overlay escuro
         ═══════════════════════════════════════════ -->
    <section class="sp-hero">
      <!-- Imagem de fundo -->
      <div class="sp-hero-bg">
        <img
          src={post.image || "/hero-firefighters-poster.jpg"}
          alt={post.title}
          loading="eager"
          onerror="this.onerror=null; this.src='/hero-firefighters-poster.jpg';"
        />
        <div class="sp-hero-overlay"></div>
      </div>

      <!-- Conteúdo sobreposto -->
      <div class="sp-hero-content container">
        <!-- Badge de categoria -->
        <div class="sp-hero-badge">
          <span class="sp-badge-dot"></span>
          {post.category.toUpperCase()}
        </div>

        <h1 class="sp-hero-title">{post.title}</h1>

        <!-- Meta: tempo de leitura -->
        <div class="sp-hero-meta">
          <span class="sp-meta-read">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            {post.readTime}
          </span>
          <span class="sp-meta-sep" aria-hidden="true">·</span>
          <span class="sp-meta-read">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            {post.date}
          </span>
        </div>

        <!-- Breadcrumb dentro do hero -->
        <nav class="sp-breadcrumb" aria-label="Trilha de navegação">
          <a href="/">Início</a>
          <span class="sp-breadcrumb-sep" aria-hidden="true">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </span>
          <a href="/blog">Blog</a>
          <span class="sp-breadcrumb-sep" aria-hidden="true">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </span>
          <span class="sp-breadcrumb-current">{post.category}</span>
        </nav>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         CORPO — Artigo (2/3) + Sidebar (1/3)
         ═══════════════════════════════════════════ -->
    <section class="sp-body">
      <div class="sp-body-accent-line"></div>
      <div class="container">
        <div class="sp-layout">

          <!-- Artigo Principal -->
          <article class="sp-article" id="post-article">

            <!-- Imagem de capa no topo do artigo -->
            <div class="sp-article-cover">
              <img
                src={post.image || "/hero-firefighters-poster.jpg"}
                alt={post.title}
                loading="eager"
                onerror="this.onerror=null; this.src='/hero-firefighters-poster.jpg';"
              />
              {post.imageCaption && <figcaption class="sp-article-caption">{post.imageCaption}</figcaption>}
            </div>

            <!-- Corpo do artigo -->
            <div class="article-body" set:html={post.content} />

            <!-- Tags + Compartilhar -->
            <div class="sp-article-footer">
              <div class="sp-tags">
                <span class="sp-tag-label">Tags:</span>
                {post.tags.map(tag => (
                  <span class="sp-tag">{tag}</span>
                ))}
              </div>

              <div class="sp-share">
                <span class="sp-share-label">Compartilhar:</span>
                <a
                  href={`https://wa.me/?text=${encodeURIComponent(post.title + ' - ' + postUrl)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="sp-share-btn"
                  aria-label="Compartilhar no WhatsApp"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                  </svg>
                </a>
                <a
                  href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(postUrl)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="sp-share-btn"
                  aria-label="Compartilhar no LinkedIn"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                </a>
              </div>
            </div>

            <!-- Box do Autor -->
            <div class="sp-author-box">
              <div class="sp-author-avatar" aria-hidden="true">{post.author.charAt(0)}</div>
              <div class="sp-author-body">
                <span class="sp-author-label">Escrito por</span>
                <strong class="sp-author-name">{post.author}</strong>
                <span class="sp-author-role">{post.authorRole}</span>
                <p class="sp-author-bio">{post.authorBio}</p>
              </div>
            </div>

          </article>

          <!-- Sidebar -->
          <aside class="sp-sidebar" aria-label="Informações adicionais">

            <!-- Card: Sobre -->
            <div class="sp-sidebar-card">
              <h4 class="sp-sidebar-title">Sobre nosso treinamento</h4>
              <p>Empresa especializada em treinamento corporativo de brigada de incêndio. Atendemos com conformidade à NR-23, instrutores qualificados e certificação válida em todo o Brasil.</p>
              <a href="/sobre" class="sp-sidebar-link">Conheça nossa metodologia →</a>
            </div>

            <!-- Card: CTA -->
            <div class="sp-sidebar-card sp-sidebar-cta">
              <span class="sp-sidebar-cta-icon" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
              </span>
              <h4>Sua empresa está regularizada?</h4>
              <p>Fale com nossos especialistas e receba uma proposta personalizada para o porte e risco da sua operação.</p>
              <button onclick="openQuoteModal()" class="sp-sidebar-btn" id="sidebar-cta-btn">
                <span>Solicitar Orçamento</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </button>
            </div>

            <!-- Card: Progresso de leitura -->
            <div class="sp-sidebar-card sp-sidebar-progress">
              <div class="sp-progress-header">
                <span class="sp-progress-label">Progresso de leitura</span>
                <span class="sp-progress-pct" id="progress-pct">0%</span>
              </div>
              <div class="sp-progress-track">
                <div class="sp-progress-fill" id="progress-fill"></div>
              </div>
            </div>

          </aside>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         ARTIGOS RELACIONADOS
         ═══════════════════════════════════════════ -->
    {relatedPosts.length > 0 && (
      <section class="sp-related" aria-labelledby="sp-related-heading">
        <div class="container">
          <div class="sp-related-header">
            <span class="sp-eyebrow">CONTINUE LENDO</span>
            <h2 class="sp-related-title" id="sp-related-heading">
              Artigos <em>relacionados</em>
            </h2>
          </div>

          <div class="sp-related-grid">
            {relatedPosts.map((related, i) => (
              <a
                href={`/blog/${related.slug}`}
                class="sp-related-card"
                data-animate="fade-up"
                data-delay={String(i * 100)}
                aria-label={`Ler artigo: ${related.title}`}
              >
                <div class="sp-related-card-img">
                  <img
                    src={related.image || "/hero-firefighters-poster.jpg"}
                    alt={related.title}
                    loading="lazy"
                    onerror="this.onerror=null; this.src='/hero-firefighters-poster.jpg';"
                  />
                </div>
                <div class="sp-related-card-content">
                  <div class="sp-related-meta">
                    <span class="sp-related-tag">{related.category}</span>
                  </div>
                  <h3>{related.title}</h3>
                  <span class="sp-related-card-link">Ler artigo →</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ═══════════════════════════════════════════
         CTA FINAL
         ═══════════════════════════════════════════ -->
    <section class="sp-cta-section" aria-labelledby="sp-cta-heading">
      <div class="container">
        <div class="sp-cta-banner" data-animate="fade-up">
          <div class="sp-cta-content">
            <span class="sp-eyebrow">TREINAMENTO &amp; CONFORMIDADE</span>
            <h2 class="sp-cta-title" id="sp-cta-heading">SUA EMPRESA ESTÁ PREPARADA PARA UMA EMERGÊNCIA?</h2>
            <p class="sp-cta-desc">Não espere uma vistoria ou um sinistro. Nossos especialistas desenvolvem um programa de treinamento personalizado para o porte e o risco da sua operação.</p>
          </div>
          <div class="sp-cta-actions">
            <button onclick="openQuoteModal()" class="btn btn-primary btn-lg" id="post-cta-orcamento-btn">
              Solicitar Orçamento Grátis
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </button>
            <a href="/blog" class="btn btn-outline" id="back-to-blog-btn">
              ← Voltar ao Blog
            </a>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
  <WhatsAppButton />

  <script>
    document.addEventListener('DOMContentLoaded', () => {

      // ── Reading Progress Bar ──────────────────────────────────
      const progressBar  = document.getElementById('reading-progress') as HTMLElement;
      const progressFill = document.getElementById('progress-fill') as HTMLElement;
      const progressPct  = document.getElementById('progress-pct') as HTMLElement;
      const article      = document.getElementById('post-article') as HTMLElement;

      function updateProgress() {
        if (!article) return;
        const articleTop    = article.offsetTop;
        const articleHeight = article.offsetHeight;
        const scrolled      = window.scrollY;
        const winH          = window.innerHeight;
        const raw           = (scrolled - articleTop + winH * 0.5) / articleHeight;
        const pct           = Math.round(Math.min(Math.max(raw, 0), 1) * 100);

        if (progressBar)  { progressBar.style.width = `${pct}%`; progressBar.setAttribute('aria-valuenow', String(pct)); }
        if (progressFill) progressFill.style.width  = `${pct}%`;
        if (progressPct)  progressPct.textContent   = `${pct}%`;
      }

      window.addEventListener('scroll', updateProgress, { passive: true });
      updateProgress();
    });
  </script>

  <style>
    /* ═══════════════════════════════════════════════════════════
       READING PROGRESS BAR
       ═══════════════════════════════════════════════════════════ */
    .reading-progress-bar {
      position: fixed;
      top: 0;
      left: 0;
      height: 3px;
      width: 0%;
      background: linear-gradient(90deg, var(--primary) 0%, var(--primary-light) 60%, #FF8A65 100%);
      z-index: 2000;
      transition: width 0.12s linear;
      box-shadow: 0 0 14px var(--primary-glow);
    }

    /* ═══════════════════════════════════════════════════════════
       PAGE BASE
       ═══════════════════════════════════════════════════════════ */
    .post-page {
      padding-top: 5.5rem; /* espaço do header fixo */
    }

    /* ═══════════════════════════════════════════════════════════
       HERO — Imagem de fundo + overlay
       ═══════════════════════════════════════════════════════════ */
    .sp-hero {
      position: relative;
      min-height: 520px;
      display: flex;
      align-items: flex-end;
      padding-bottom: 4rem;
      overflow: hidden;
    }

    .sp-hero-bg {
      position: absolute;
      inset: 0;
    }

    .sp-hero-bg img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }

    /* Overlay duplo: escurece a imagem com gradiente direcional */
    .sp-hero-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        160deg,
        rgba(5, 5, 5, 0.97) 0%,
        rgba(10, 10, 10, 0.88) 40%,
        rgba(10, 10, 10, 0.60) 100%
      );
    }

    .sp-hero-content {
      position: relative;
      z-index: 2;
      padding-top: 5rem;
    }

    /* Badge de categoria */
    .sp-hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--primary-light);
      border: 1px solid var(--primary-border);
      background: rgba(230, 48, 0, 0.12);
      backdrop-filter: blur(8px);
      padding: 0.4rem 1rem;
      border-radius: var(--radius-full);
      margin-bottom: 1.5rem;
    }

    .sp-badge-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--primary-light);
      flex-shrink: 0;
      animation: sp-pulse 2s ease-in-out infinite;
    }

    @keyframes sp-pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50%       { opacity: 0.5; transform: scale(0.75); }
    }

    /* Título do hero */
    .sp-hero-title {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: clamp(1.9rem, 4.5vw, 3.2rem);
      font-weight: 800;
      line-height: 1.15;
      letter-spacing: -0.025em;
      color: #fff;
      max-width: 820px;
      margin-bottom: 1.5rem;
    }

    /* Meta (tempo de leitura + data) */
    .sp-hero-meta {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 2rem;
      flex-wrap: wrap;
    }

    .sp-meta-read {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      font-size: 0.85rem;
      color: rgba(255, 255, 255, 0.65);
    }

    .sp-meta-sep {
      color: rgba(255, 255, 255, 0.3);
    }

    /* Breadcrumb dentro do hero */
    .sp-breadcrumb {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.8rem;
    }

    .sp-breadcrumb a {
      color: rgba(255, 255, 255, 0.55);
      transition: color 0.2s;
    }

    .sp-breadcrumb a:hover { color: var(--primary-light); }

    .sp-breadcrumb-sep {
      color: rgba(255, 255, 255, 0.3);
      display: flex;
      align-items: center;
    }

    .sp-breadcrumb-current {
      color: var(--primary-light);
      font-weight: 600;
    }

    /* ═══════════════════════════════════════════════════════════
       CORPO — Layout 2 colunas
       ═══════════════════════════════════════════════════════════ */
    .sp-body {
      position: relative;
      padding: 4.5rem 0 5rem;
    }

    /* Linha decorativa colorida no topo do corpo */
    .sp-body-accent-line {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--primary) 0%, var(--primary-light) 40%, transparent 80%);
    }

    .sp-layout {
      display: grid;
      grid-template-columns: 1fr 340px;
      gap: 4rem;
      align-items: start;
    }

    /* ── Artigo ────────────────────────────────── */
    .sp-article { min-width: 0; }

    /* Imagem de capa no topo do artigo */
    .sp-article-cover {
      margin-bottom: 2.5rem;
      border-radius: var(--radius-lg);
      overflow: hidden;
      border: 1px solid var(--border);
    }

    .sp-article-cover img {
      width: 100%;
      height: 420px;
      object-fit: cover;
      display: block;
      transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .sp-article-cover:hover img { transform: scale(1.03); }

    .sp-article-caption {
      display: block;
      font-size: 0.82rem;
      color: var(--text-subtle);
      text-align: center;
      padding: 0.7rem 1rem;
      background: var(--bg-elevated);
      font-style: italic;
    }

    /* Corpo do artigo — tipografia */
    .article-body h2 {
      font-size: clamp(1.4rem, 2.5vw, 1.85rem);
      font-weight: 800;
      color: var(--text-main);
      margin: 3rem 0 1.1rem;
      padding-top: 1rem;
      letter-spacing: -0.02em;
      border-top: 1px solid var(--border);
      scroll-margin-top: 7rem;
      position: relative;
      padding-left: 1.2rem;
    }

    /* Linha vertical decorativa antes dos h2 */
    .article-body h2::before {
      content: '';
      position: absolute;
      left: 0;
      top: 1.2rem;
      bottom: 0;
      width: 3px;
      background: linear-gradient(180deg, var(--primary) 0%, var(--primary-light) 100%);
      border-radius: 4px;
    }

    .article-body h2:first-child {
      margin-top: 0;
      padding-top: 0;
      border-top: none;
    }

    .article-body h2:first-child::before {
      top: 0;
    }

    .article-body p {
      font-size: 1.06rem;
      line-height: 1.85;
      color: var(--text-muted);
      margin-bottom: 1.35rem;
    }

    .article-body p strong { color: var(--text-main); font-weight: 700; }

    .article-body ul,
    .article-body ol {
      padding-left: 1.5rem;
      margin-bottom: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
    }

    .article-body li {
      font-size: 1.04rem;
      line-height: 1.72;
      color: var(--text-muted);
    }

    .article-body li strong { color: var(--text-main); }
    .article-body ul li::marker { color: var(--primary); }

    /* Pull-quote estilizado */
    .article-body blockquote.pull-quote {
      position: relative;
      margin: 2.5rem 0;
      padding: 2rem 2rem 2rem 2.5rem;
      background: linear-gradient(var(--bg-card), var(--bg-card)) padding-box,
                  linear-gradient(180deg, var(--primary-light), var(--primary)) border-box;
      border: 0 solid transparent;
      border-left-width: 4px;
      border-radius: 0 var(--radius-md) var(--radius-md) 0;
      overflow: hidden;
    }

    .article-body blockquote.pull-quote::before {
      content: '\201C';
      font-family: 'Bebas Neue', sans-serif;
      font-size: 9rem;
      line-height: 0.75;
      color: rgba(230, 48, 0, 0.13);
      position: absolute;
      top: 0.75rem;
      left: 0.75rem;
      pointer-events: none;
      user-select: none;
    }

    .article-body blockquote.pull-quote p {
      position: relative;
      font-size: 1.16rem;
      font-weight: 600;
      color: var(--text-main);
      line-height: 1.6;
      font-style: italic;
      margin-bottom: 0.7rem;
    }

    .article-body blockquote.pull-quote cite {
      position: relative;
      display: block;
      font-size: 0.82rem;
      color: var(--primary-light);
      font-style: normal;
      font-weight: 700;
      letter-spacing: 0.04em;
    }

    /* Tags + Compartilhar */
    .sp-article-footer {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1.5rem;
      padding: 2rem 0;
      border-top: 1px solid var(--border);
      margin-top: 3rem;
      flex-wrap: wrap;
    }

    .sp-tags {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      flex-wrap: wrap;
    }

    .sp-tag-label {
      font-size: 0.78rem;
      font-weight: 700;
      color: var(--text-subtle);
      text-transform: uppercase;
      letter-spacing: 0.07em;
      flex-shrink: 0;
    }

    .sp-tag {
      padding: 0.3rem 0.85rem;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-full);
      font-size: 0.78rem;
      color: var(--text-muted);
      font-weight: 600;
      transition: var(--transition);
    }

    .sp-tag:hover {
      border-color: var(--primary-border);
      color: var(--primary-light);
    }

    .sp-share {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      flex-shrink: 0;
    }

    .sp-share-label {
      font-size: 0.78rem;
      font-weight: 700;
      color: var(--text-subtle);
      text-transform: uppercase;
      letter-spacing: 0.07em;
    }

    .sp-share-btn {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: var(--bg-card);
      border: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-muted);
      transition: var(--transition);
    }

    .sp-share-btn:hover {
      transform: translateY(-2px);
      border-color: var(--primary-border);
      color: var(--primary-light);
      background: var(--primary-dim);
    }

    /* Box do Autor */
    .sp-author-box {
      display: flex;
      gap: 1.5rem;
      margin-top: 2rem;
      padding: 2rem;
      background: linear-gradient(135deg, var(--bg-card) 0%, rgba(230, 48, 0, 0.06) 100%);
      border: 1px solid var(--primary-border);
      border-radius: var(--radius-lg);
    }

    .sp-author-avatar {
      width: 60px;
      height: 60px;
      border-radius: 50%;
      background: var(--gradient-fire);
      color: #fff;
      font-weight: 800;
      font-size: 1.4rem;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      box-shadow: 0 0 20px var(--primary-glow);
    }

    .sp-author-body { display: flex; flex-direction: column; gap: 0.2rem; }

    .sp-author-label {
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--primary-light);
    }

    .sp-author-name {
      font-size: 1.02rem;
      color: var(--text-main);
    }

    .sp-author-role {
      font-size: 0.8rem;
      color: var(--text-subtle);
      margin-bottom: 0.4rem;
    }

    .sp-author-bio {
      font-size: 0.9rem;
      color: var(--text-muted);
      line-height: 1.6;
    }

    /* ── Sidebar ──────────────────────────────── */
    .sp-sidebar {
      position: sticky;
      top: 7rem;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .sp-sidebar-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 1.75rem;
    }

    .sp-sidebar-card p {
      font-size: 0.88rem;
      color: var(--text-muted);
      line-height: 1.6;
      margin-top: 0.75rem;
    }

    .sp-sidebar-title {
      font-size: 1rem;
      font-weight: 800;
      color: var(--text-main);
      padding-bottom: 0.75rem;
      border-bottom: 2px solid var(--primary);
      display: inline-block;
    }

    .sp-sidebar-link {
      display: inline-block;
      margin-top: 1.1rem;
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--primary-light);
      transition: gap 0.2s, color 0.2s;
    }

    .sp-sidebar-link:hover { color: var(--primary); }

    /* CTA Card */
    .sp-sidebar-cta {
      background: linear-gradient(135deg, rgba(230, 48, 0, 0.15) 0%, var(--bg-card) 100%);
      border-color: var(--primary-border);
      text-align: center;
    }

    .sp-sidebar-cta-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 52px;
      height: 52px;
      border-radius: 50%;
      background: var(--gradient-fire);
      color: #fff;
      margin-bottom: 1rem;
      box-shadow: 0 0 20px var(--primary-glow);
    }

    .sp-sidebar-cta h4 {
      font-size: 1rem;
      font-weight: 800;
      color: var(--text-main);
      margin-bottom: 0.6rem;
      line-height: 1.3;
    }

    .sp-sidebar-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      margin-top: 1.1rem;
      width: 100%;
      padding: 0.85rem 1.2rem;
      background: var(--gradient-fire);
      color: #fff;
      font-size: 0.9rem;
      font-weight: 700;
      border: none;
      border-radius: var(--radius-md);
      cursor: pointer;
      transition: var(--transition);
      box-shadow: 0 4px 16px var(--primary-glow);
    }

    .sp-sidebar-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px var(--primary-glow);
    }

    /* Progress card */
    .sp-sidebar-progress { padding: 1.25rem 1.75rem; }

    .sp-progress-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.75rem;
    }

    .sp-progress-label {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-subtle);
    }

    .sp-progress-pct {
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--primary-light);
    }

    .sp-progress-track {
      height: 6px;
      background: rgba(255, 255, 255, 0.06);
      border-radius: 999px;
      overflow: hidden;
    }

    .sp-progress-fill {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, var(--primary) 0%, var(--primary-light) 100%);
      border-radius: 999px;
      transition: width 0.15s linear;
    }

    /* ═══════════════════════════════════════════════════════════
       ARTIGOS RELACIONADOS
       ═══════════════════════════════════════════════════════════ */
    .sp-related {
      border-top: 1px solid var(--border);
      background: var(--bg-elevated);
      padding: 5rem 0;
    }

    .sp-related-header { margin-bottom: 3rem; }

    .sp-eyebrow {
      display: block;
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--primary-light);
      margin-bottom: 0.6rem;
    }

    .sp-related-title {
      font-size: clamp(1.8rem, 3.5vw, 2.6rem);
      font-weight: 800;
      color: var(--text-main);
      letter-spacing: -0.02em;
    }

    .sp-related-title em {
      font-style: italic;
      font-family: Georgia, 'Times New Roman', serif;
      font-weight: 400;
      color: var(--primary-light);
    }

    .sp-related-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }

    .sp-related-card {
      display: flex;
      flex-direction: column;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      overflow: hidden;
      transition: var(--transition);
    }

    .sp-related-card:hover {
      transform: translateY(-6px);
      border-color: var(--primary-border);
      box-shadow: 0 20px 50px -12px rgba(0, 0, 0, 0.55);
    }

    .sp-related-card-img {
      position: relative;
      height: 200px;
      overflow: hidden;
    }

    .sp-related-card-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), filter 0.5s ease;
      filter: brightness(0.85);
    }

    .sp-related-card:hover .sp-related-card-img img {
      transform: scale(1.07);
      filter: brightness(0.7);
    }

    .sp-related-card-content {
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
      flex-grow: 1;
    }

    .sp-related-meta { display: flex; align-items: center; gap: 0.5rem; }

    .sp-related-tag {
      display: inline-block;
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--primary-light);
      border: 1px solid var(--primary-border);
      background: var(--primary-dim);
      padding: 0.25rem 0.65rem;
      border-radius: var(--radius-full);
    }

    .sp-related-card-content h3 {
      font-size: 1rem;
      font-weight: 700;
      color: var(--text-main);
      line-height: 1.4;
      transition: color 0.2s;
    }

    .sp-related-card:hover .sp-related-card-content h3 { color: var(--primary-light); }

    .sp-related-card-link {
      display: inline-block;
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--primary-light);
      margin-top: auto;
      padding-top: 0.5rem;
      transition: letter-spacing 0.2s;
    }

    .sp-related-card:hover .sp-related-card-link { letter-spacing: 0.03em; }

    /* ═══════════════════════════════════════════════════════════
       CTA FINAL
       ═══════════════════════════════════════════════════════════ */
    .sp-cta-section { padding: 5rem 0; }

    .sp-cta-banner {
      padding: 4rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 3rem;
      background: linear-gradient(135deg, rgba(230, 48, 0, 0.14) 0%, var(--bg-card) 55%);
      border: 1px solid var(--primary-border);
      border-radius: var(--radius-xl);
      position: relative;
      overflow: hidden;
    }

    .sp-cta-banner::after {
      content: '';
      position: absolute;
      right: -60px;
      top: 50%;
      transform: translateY(-50%);
      width: 320px;
      height: 320px;
      background: radial-gradient(circle, rgba(230, 48, 0, 0.18) 0%, transparent 65%);
      pointer-events: none;
    }

    .sp-cta-content { max-width: 600px; position: relative; z-index: 1; }

    .sp-cta-content .sp-eyebrow { margin-bottom: 0.75rem; }

    .sp-cta-title {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(2rem, 3.5vw, 2.8rem);
      font-weight: 400;
      letter-spacing: 0.05em;
      color: #fff;
      margin-bottom: 0.85rem;
    }

    .sp-cta-desc {
      font-size: 1rem;
      color: var(--text-muted);
      line-height: 1.65;
    }

    .sp-cta-actions {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
      flex-shrink: 0;
      position: relative;
      z-index: 1;
    }

    /* Botões herdados do global */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.55rem;
      padding: 0.8rem 1.75rem;
      border-radius: var(--radius-md);
      font-weight: 700;
      font-size: 0.95rem;
      cursor: pointer;
      border: none;
      transition: var(--transition);
      text-decoration: none;
      white-space: nowrap;
    }

    .btn-primary {
      background: var(--gradient-fire);
      color: #fff;
      box-shadow: 0 4px 20px var(--primary-glow);
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 30px var(--primary-glow);
    }

    .btn-outline {
      background: transparent;
      color: var(--text-muted);
      border: 1px solid var(--border-light);
    }

    .btn-outline:hover {
      border-color: var(--primary-border);
      color: var(--primary-light);
    }

    .btn-lg { padding: 1.1rem 2.2rem; font-size: 1rem; }

    /* ═══════════════════════════════════════════════════════════
       RESPONSIVE
       ═══════════════════════════════════════════════════════════ */
    @media (max-width: 1100px) {
      .sp-layout { grid-template-columns: 1fr 300px; gap: 3rem; }
    }

    @media (max-width: 900px) {
      .sp-hero { min-height: 420px; }

      .sp-layout { grid-template-columns: 1fr; }

      .sp-sidebar {
        position: static;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
      }

      .sp-sidebar-progress { grid-column: span 2; }

      .sp-related-grid { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 768px) {
      .sp-hero { min-height: 380px; padding-bottom: 3rem; }

      .sp-hero-title { font-size: clamp(1.6rem, 6vw, 2.2rem); }

      .sp-article-cover img { height: 240px; }

      .sp-sidebar { grid-template-columns: 1fr; }

      .sp-sidebar-progress { grid-column: span 1; }

      .sp-related-grid { grid-template-columns: 1fr; }

      .sp-cta-banner {
        flex-direction: column;
        text-align: center;
        padding: 2.5rem 1.75rem;
      }

      .sp-cta-actions { width: 100%; align-items: center; }

      .sp-article-footer {
        flex-direction: column;
        gap: 1.25rem;
      }

      .sp-author-box {
        flex-direction: column;
        align-items: center;
        text-align: center;
      }
    }

    @media (max-width: 480px) {
      .sp-hero-title { font-size: clamp(1.45rem, 7vw, 1.9rem); }
    }

    /* Reduced motion */
    @media (prefers-reduced-motion: reduce) {
      .reading-progress-bar,
      .sp-progress-fill {
        transition: none;
      }
      .sp-badge-dot { animation: none; }
    }
  </style>
</Layout>
