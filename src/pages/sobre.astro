---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import QuoteModal from '../components/QuoteModal.astro';
import StatsSection from '../components/StatsSection.astro';
import CTASection from '../components/CTASection.astro';
---

<Layout 
  title="Sobre Nós | Especialistas em Treinamento de Brigada de Incêndio"
  description="Conheça nossa trajetória, missão, valores e metodologia prática. Somos referência na capacitação de brigadas de incêndio e consultoria em segurança do trabalho."
>
  <Header />
  
  <main id="main-content" class="sobre-page">
    <!-- ═══════════════════════════════════════════════
         HERO SECTION — ALTA PERFORMANCE & ELEGÂNCIA CORPORATIVA
         ═══════════════════════════════════════════════ -->
    <section class="sobre-hero">
      <!-- Fundo Tecnológico de Altíssima Performance (Zero Network Delay / Pure CSS + SVG) -->
      <div class="sobre-hero-bg" aria-hidden="true">
        <div class="hero-bg-deep"></div>
        <div class="hero-glow-main"></div>
        <div class="hero-glow-secondary"></div>
        <div class="hero-diagonal-sheen"></div>
        <div class="hero-grid-pattern"></div>
        <div class="hero-ember hero-ember-1"></div>
        <div class="hero-ember hero-ember-2"></div>
        <div class="hero-ember hero-ember-3"></div>
      </div>

      <div class="container sobre-hero-container">
        <div class="sobre-hero-grid">
          <!-- Coluna Esquerda: Mensagem Institucional -->
          <div class="sobre-hero-main">
            <div class="sobre-hero-badge">
              <span class="badge-dot"></span>SOBRE NÓS · AUTORIDADE EM PREVENÇÃO
            </div>
            
            <h1 class="sobre-hero-title">
              <span class="title-line">FORMAÇÃO COM</span>
              <span class="title-line title-accent">PROPÓSITO</span>
              <span class="title-line title-stroke">REAL.</span>
            </h1>
            
            <p class="sobre-hero-sub">
              Capacitamos brigadistas e equipes corporativas com excelência técnica, simulações hiper-realistas e compromisso inabalável com a preservação de vidas e do patrimônio.
            </p>

            <!-- Mini destaques de conformidade imediata -->
            <div class="sobre-hero-highlights">
              <div class="hero-highlight-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="highlight-icon">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  <path d="m9 12 2 2 4-4"/>
                </svg>
                <span>100% NR-23 & NBR 14276</span>
              </div>
              <div class="hero-highlight-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="highlight-icon">
                  <circle cx="12" cy="12" r="10"/>
                  <path d="m9 12 2 2 4-4"/>
                </svg>
                <span>Certificado e Laudo AVCB</span>
              </div>
            </div>

            <nav class="sobre-breadcrumb" aria-label="Breadcrumb">
              <a href="/">Início</a>
              <span class="breadcrumb-sep" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </span>
              <span class="breadcrumb-current">Sobre Nós</span>
            </nav>
          </div>

          <!-- Coluna Direita: Card de Excelência Institucional (Glassmorphism de alta autoridade) -->
          <div class="sobre-hero-card-col">
            <div class="hero-authority-card">
              <div class="card-glow-edge"></div>
              
              <div class="card-header">
                <div class="card-header-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>
                  </svg>
                </div>
                <div>
                  <span class="card-tag">PADRÃO TÉCNICO DE EXCELÊNCIA</span>
                  <h3 class="card-title">Por que confiar na nossa formação?</h3>
                </div>
              </div>

              <div class="card-pillars">
                <div class="pillar-item">
                  <div class="pillar-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                  </div>
                  <div class="pillar-content">
                    <strong>Corpo Docente Especializado</strong>
                    <p>Engenheiros de segurança e bombeiros com vivência real em atendimento a emergências.</p>
                  </div>
                </div>

                <div class="pillar-item">
                  <div class="pillar-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m13 2-2 2.5V8l-3 4 5 10 7-9-2-5.5V2z"/><path d="M10.5 8.5 7 12"/>
                    </svg>
                  </div>
                  <div class="pillar-content">
                    <strong>Metodologia Prática & Segura</strong>
                    <p>Simulações com fogo controlado, combate rápido a princípios e abandono de área.</p>
                  </div>
                </div>

                <div class="pillar-item">
                  <div class="pillar-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect width="18" height="18" x="3" y="3" rx="2"/><path d="m9 12 2 2 4-4"/>
                    </svg>
                  </div>
                  <div class="pillar-content">
                    <strong>Conformidade Jurídica Total</strong>
                    <p>Certificados com rastreabilidade nacional e laudos prontos para auditorias e bombeiros.</p>
                  </div>
                </div>
              </div>

              <div class="card-footer">
                <span class="status-live-dot"></span>
                <span>Atendimento In-Company & Reciclagem Anual</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════
         NOSSA HISTÓRIA (ABOUT SECTION - FUNDO BRANCO CLEAN)
         ═══════════════════════════════════════════════ -->
    <section class="sobre-about section-padding">
      <div class="container">
        <div class="sobre-about-grid">
          <!-- Coluna Imagem -->
          <div class="sobre-about-img-col">
            <div class="img-frame">
              <img 
                src="https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&w=1000&q=80" 
                alt="Equipe técnica em treinamento de segurança contra incêndio" 
                loading="lazy"
              />
            </div>
            <div class="sobre-exp-badge">
              <span class="exp-badge-num">+10</span>
              <span class="exp-badge-text">Anos de<br/>Excelência</span>
            </div>
          </div>

          <!-- Coluna Texto -->
          <div class="sobre-about-text-col">
            <span class="eyebrow">NOSSA HISTÓRIA</span>
            <h2 class="section-title">
              Da paixão por salvar vidas<br/>
              <em>à referência em prevenção.</em>
            </h2>
            <div class="title-underline"></div>

            <p class="about-lead">
              Nascemos com um propósito inegociável: transformar a capacitação em emergências em uma experiência dinâmica, prática e 100% aplicável ao dia a dia das empresas.
            </p>

            <p class="about-body">
              Constatamos que grande parte dos treinamentos tradicionais de brigada se limitavam a apostilas teóricas desconectadas dos riscos reais das instalações. Decidimos revolucionar essa abordagem, integrando instrutores de campo de elite — <strong>engenheiros de segurança do trabalho, bombeiros e especialistas em resgate</strong>.
            </p>

            <p class="about-body">
              Hoje, somos parceiros estratégicos de indústrias, comércios e edifícios corporativos em todo o país. Nossos programas atendem rigorosamente às exigências da <strong>NR-23</strong>, <strong>NBR 14276</strong> e instruções técnicas do Corpo de Bombeiros, garantindo aprovação ágil de <strong>AVCB/CLCB</strong> e a máxima tranquilidade para a gestão da sua empresa.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════
         MÉTRICAS / ESTATÍSTICAS
         ═══════════════════════════════════════════════ -->
    <StatsSection />

    <!-- ═══════════════════════════════════════════════
         MISSÃO, VISÃO & VALORES (FUNDO CINZA SUAVE PREMIUM)
         ═══════════════════════════════════════════════ -->
    <section class="sobre-mvv section-padding">
      <div class="container">
        <div class="mvv-header">
          <span class="eyebrow">PRINCÍPIOS</span>
          <h2 class="section-title">
            Missão, Visão &<br/>
            <em>Valores</em>
          </h2>
          <div class="title-underline center-underline"></div>
        </div>

        <div class="sobre-mvv-grid">
          <!-- Card Missão (Destaque) -->
          <div class="mvv-card mvv-card-featured">
            <div class="mvv-icon">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
                <path d="M2 12h20"></path>
              </svg>
            </div>
            <h3>Missão</h3>
            <p>
              Capacitar colaboradores para agir com liderança, confiança e técnica precisa em situações de emergência, protegendo vidas e preservando patrimônios com metodologia transformadora.
            </p>
          </div>

          <!-- Card Visão -->
          <div class="mvv-card">
            <div class="mvv-icon">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
            </div>
            <h3>Visão</h3>
            <p>
              Ser a maior e mais respeitada autoridade em treinamentos de combate a incêndio e consultoria preventiva do Brasil, reconhecida pela excelência pedagógica e conformidade jurídica total.
            </p>
          </div>

          <!-- Card Valores -->
          <div class="mvv-card">
            <div class="mvv-icon">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
            </div>
            <h3>Valores</h3>
            <p>
              A vida humana em primeiro lugar. Rigor absoluto com normas técnicas (NR-23/NBR 14276). Ética e transparência em laudos. Didática humanizada e compromisso com o resultado.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════
         DIFERENCIAIS (FUNDO BRANCO CLEAN - GRID 01 A 06)
         ═══════════════════════════════════════════════ -->
    <section class="sobre-diff section-padding">
      <div class="container">
        <div class="sobre-diff-header">
          <span class="eyebrow">POR QUE NOS ESCOLHER</span>
          <h2 class="section-title">
            Nossos<br/>
            <em>Diferenciais</em>
          </h2>
          <div class="title-underline"></div>
        </div>

        <div class="sobre-diff-grid">
          <!-- Item 01 -->
          <div class="diff-item">
            <div class="diff-num">01</div>
            <div class="diff-content">
              <h3>Instrutores Especialistas</h3>
              <p>Corpo docente formado por engenheiros de segurança, bombeiros civis e socorristas com anos de atuação em sinistros reais.</p>
            </div>
          </div>

          <!-- Item 02 -->
          <div class="diff-item">
            <div class="diff-num">02</div>
            <div class="diff-content">
              <h3>Simulações Hiper-Realistas</h3>
              <p>Prática efetiva com fogo real, extintores de todas as classes, linhas de hidrantes e evacuação orientada para a sua planta.</p>
            </div>
          </div>

          <!-- Item 03 -->
          <div class="diff-item">
            <div class="diff-num">03</div>
            <div class="diff-content">
              <h3>Conformidade Legal 100%</h3>
              <p>Certificados com rastreabilidade e laudos técnicos prontos para auditorias do trabalho e vistorias de AVCB/CLCB dos Bombeiros.</p>
            </div>
          </div>

          <!-- Item 04 -->
          <div class="diff-item">
            <div class="diff-num">04</div>
            <div class="diff-content">
              <h3>Treinamento In-Company</h3>
              <p>Flexibilidade total de datas e turnos. Levamos todo o equipamento necessário até as instalações da sua organização.</p>
            </div>
          </div>

          <!-- Item 05 -->
          <div class="diff-item">
            <div class="diff-num">05</div>
            <div class="diff-content">
              <h3>Dimensionamento Sob Medida</h3>
              <p>Cálculo normativo exato do efetivo de brigadistas por turno segundo a NBR 14276, evitando custos e contingências desnecessárias.</p>
            </div>
          </div>

          <!-- Item 06 -->
          <div class="diff-item">
            <div class="diff-num">06</div>
            <div class="diff-content">
              <h3>Gestão de Reciclagem</h3>
              <p>Acompanhamento preventivo dos prazos de validade das credenciais da brigada, com alertas automáticos para reciclagem anual.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════
         CTA FINAL
         ═══════════════════════════════════════════════ -->
    <CTASection />
  </main>

  <Footer />
  <WhatsAppButton />
  <QuoteModal />
</Layout>

<style>
  /* ═══════════════════════════════════════════
     ESTILOS BASE E DESIGN SYSTEM (LIGHT / BRANCO CLEAN)
     ═══════════════════════════════════════════ */
  .sobre-page {
    background-color: #FFFFFF;
    color: #1E293B;
    overflow-x: hidden;
    font-family: 'Plus Jakarta Sans', sans-serif;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    width: 100%;
    box-sizing: border-box;
  }

  .section-padding {
    padding: 6.5rem 0;
  }

  /* ── Tipografia Corporativa & Hierarquia ── */
  .eyebrow {
    display: inline-block;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--primary, #E63000);
    margin-bottom: 0.85rem;
  }

  .eyebrow::before {
    display: none;
  }

  .section-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(2.1rem, 4.2vw, 3.2rem);
    font-weight: 800;
    line-height: 1.15;
    color: #0F172A;
    -webkit-text-fill-color: #0F172A;
    background: none;
    background-clip: initial;
    letter-spacing: -0.025em;
    margin-bottom: 1.25rem;
  }

  .section-title em {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-weight: 500;
    color: var(--primary, #E63000);
  }

  .title-underline {
    width: 54px;
    height: 3px;
    background: linear-gradient(90deg, var(--primary, #E63000) 0%, #FF6B4A 100%);
    border-radius: 4px;
    margin-bottom: 2.25rem;
  }

  .center-underline {
    margin-left: auto;
    margin-right: auto;
  }

  /* ═══════════════════════════════════════════
     HERO SECTION — Alta Performance & Elegância Corporativa
     ═══════════════════════════════════════════ */
  .sobre-hero {
    position: relative;
    padding: 6rem 1.5rem 5.5rem;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: 480px;
    background-color: #070A12;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* Camadas de Fundo (Zero Network Delay / Pure CSS + SVG) */
  .sobre-hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 1;
  }

  .hero-bg-deep {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 65% 25%, #0F172A 0%, #090E1A 55%, #05070D 100%);
  }

  .hero-glow-main {
    position: absolute;
    top: -12%;
    right: 5%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(230, 48, 0, 0.22) 0%, rgba(230, 48, 0, 0.06) 45%, transparent 70%);
    filter: blur(55px);
    pointer-events: none;
  }

  .hero-glow-secondary {
    position: absolute;
    bottom: -15%;
    left: -5%;
    width: 480px;
    height: 480px;
    background: radial-gradient(circle, rgba(255, 107, 74, 0.12) 0%, transparent 65%);
    filter: blur(60px);
    pointer-events: none;
  }

  .hero-diagonal-sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      115deg,
      transparent 15%,
      rgba(230, 48, 0, 0.07) 32%,
      rgba(255, 107, 74, 0.03) 48%,
      transparent 65%
    );
    pointer-events: none;
  }

  .hero-grid-pattern {
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M40 0H0v40' fill='none' stroke='rgba(255,255,255,0.035)' stroke-width='1'/%3E%3Ccircle cx='40' cy='0' r='1.2' fill='rgba(255,107,74,0.22)'/%3E%3C/svg%3E");
    mask-image: radial-gradient(ellipse at 60% 40%, rgba(0, 0, 0, 0.9) 20%, rgba(0, 0, 0, 0.3) 60%, transparent 85%);
    -webkit-mask-image: radial-gradient(ellipse at 60% 40%, rgba(0, 0, 0, 0.9) 20%, rgba(0, 0, 0, 0.3) 60%, transparent 85%);
    pointer-events: none;
  }

  /* Micro-partículas em CSS puro */
  .hero-ember {
    position: absolute;
    border-radius: 50%;
    background: #FF6B4A;
    pointer-events: none;
    opacity: 0;
    filter: blur(1px);
    animation: ember-float 7s infinite ease-in-out;
  }

  .hero-ember-1 {
    width: 4px;
    height: 4px;
    left: 20%;
    bottom: 20%;
    animation-delay: 0s;
  }

  .hero-ember-2 {
    width: 3px;
    height: 3px;
    left: 60%;
    bottom: 15%;
    animation-delay: 2.5s;
  }

  .hero-ember-3 {
    width: 5px;
    height: 5px;
    left: 82%;
    bottom: 28%;
    animation-delay: 4.8s;
  }

  @keyframes ember-float {
    0% {
      transform: translateY(0) scale(0.8);
      opacity: 0;
    }
    30% {
      opacity: 0.65;
    }
    70% {
      opacity: 0.4;
      transform: translateY(-45px) scale(1.1);
    }
    100% {
      transform: translateY(-85px) scale(0.6);
      opacity: 0;
    }
  }

  /* Conteúdo e Grid do Hero */
  .sobre-hero-container {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .sobre-hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3.5rem;
    align-items: center;
  }

  .sobre-hero-main {
    width: 100%;
  }

  .sobre-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 1rem;
    border: 1px solid rgba(255, 107, 74, 0.35);
    border-radius: var(--radius-full, 9999px);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #FF6B4A;
    background: rgba(230, 48, 0, 0.15);
    backdrop-filter: blur(8px);
    margin-bottom: 1.5rem;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #FF6B4A;
    display: inline-block;
    animation: pulse-dot 2s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.75); }
  }

  .sobre-hero-title {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-bottom: 1.5rem;
  }

  .title-line {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(2.8rem, 6vw, 5rem);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: #FFFFFF;
    text-transform: uppercase;
  }

  .title-accent {
    color: #FF6B4A;
    background: linear-gradient(135deg, #FF6B4A 0%, #FF3D1F 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .title-stroke {
    -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.75);
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  .sobre-hero-sub {
    font-size: 1.12rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.85);
    max-width: 640px;
    margin-bottom: 1.75rem;
  }

  /* Micro-destaques em linha */
  .sobre-hero-highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-bottom: 2rem;
  }

  .hero-highlight-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.42rem 0.9rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-sm, 8px);
    font-size: 0.82rem;
    font-weight: 600;
    color: #F1F5F9;
    backdrop-filter: blur(8px);
  }

  .highlight-icon {
    color: #FF6B4A;
    flex-shrink: 0;
  }

