---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import QuoteModal from '../components/QuoteModal.astro';

import { allPosts } from '../data/blogPosts';

const featuredPost = allPosts[0];
const otherPosts = allPosts.slice(1);
---

<Layout
  title="Blog & Guias Técnicos | Treinamento de Brigada de Incêndio"
  description="Artigos especializados sobre normas de segurança do trabalho (NR-23, NBR 14276), formação de brigadistas, combate a incêndio e conformidade corporativa."
>
  <Header />

  <main class="blog-page" id="main-content">
    <!-- Hero Header -->
    <section class="blog-hero">
      <div class="container">
        <div class="blog-hero-content">
          <span class="blog-badge">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
            CENTRO DE CONHECIMENTO TÉCNICO ({allPosts.length} Artigos)
          </span>
          <h1 class="font-display blog-title">BLOG & GUIA DE SEGURANÇA CONTRA INCÊNDIO</h1>
          <p class="blog-subtitle">
            Orientações práticas, análise de normas regulamentadoras (NR-23, NBR 14276) e estratégias para manter a sua empresa 100% segura e em conformidade legal.
          </p>
        </div>
      </div>
    </section>

    <!-- Featured Post Section -->
    {featuredPost && (
      <section class="featured-section">
        <div class="container">
          <article class="featured-card">
            <div class="featured-image-wrapper">
              <img src={featuredPost.image} alt={featuredPost.title} loading="eager" width="1200" height="675" />
              <span class="featured-badge">Artigo em Destaque</span>
            </div>

            <div class="featured-content">
              <div class="post-meta">
                <span class="category-tag">{featuredPost.category}</span>
                <span class="meta-dot">•</span>
                <span class="meta-date">{featuredPost.date}</span>
                <span class="meta-dot">•</span>
                <span class="meta-time">{featuredPost.readTime}</span>
              </div>

              <h2 class="featured-title">
                <a href={`/blog/${featuredPost.slug}`}>{featuredPost.title}</a>
              </h2>

              <p class="featured-excerpt">{featuredPost.excerpt}</p>

              <div class="featured-footer">
                <div class="author-info">
                  <span class="author-name">{featuredPost.author}</span>
                  <span class="author-role">{featuredPost.authorRole}</span>
                </div>
                <a href={`/blog/${featuredPost.slug}`} class="read-more-btn">
                  <span>Ler Artigo Completo</span>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                </a>
              </div>
            </div>
          </article>
        </div>
      </section>
    )}

    <!-- Blog Posts Grid -->
    <section class="posts-section section-padding">
      <div class="container">
        <div class="posts-grid">
          {otherPosts.map((post) => (
            <article class="post-card">
              <div class="post-card-image">
                <img src={post.image} alt={post.title} loading="lazy" width="600" height="338" />
                <span class="card-category">{post.category}</span>
              </div>
              <div class="post-card-body">
                <div class="card-meta">
                  <span>{post.date}</span>
                  <span class="meta-dot">•</span>
                  <span>{post.readTime}</span>
                </div>
                <h3 class="card-title">
                  <a href={`/blog/${post.slug}`}>{post.title}</a>
                </h3>
                <p class="card-excerpt">{post.excerpt}</p>
                <a href={`/blog/${post.slug}`} class="card-link">
                  <span>Ler artigo</span>
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppButton />
  <QuoteModal />
</Layout>

<style>
  .blog-page {
    padding-top: 5rem;
    background-color: var(--bg-main);
    color: var(--text-main);
    min-height: 100vh;
  }
  .blog-hero {
    background: radial-gradient(circle at 50% 0%, rgba(230, 48, 0, 0.1) 0%, var(--bg-main) 75%);
    padding: 5rem 0 3rem 0;
    text-align: center;
    border-bottom: 1px solid var(--border);
  }
  .blog-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.9rem;
    background: rgba(230, 48, 0, 0.12);
    border: 1px solid var(--border-fire);
    color: var(--primary-light);
    border-radius: var(--radius-full, 9999px);
    font-size: 0.8rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
  }
  .blog-title {
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    margin-bottom: 1rem;
    color: #FFFFFF;
  }
  .blog-subtitle {
    color: var(--text-muted);
    font-size: 1.1rem;
    max-width: 750px;
    margin: 0 auto;
  }
  .featured-section {
    padding: 3rem 0;
  }
  .featured-card {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 2rem;
    background: rgba(20, 20, 20, 0.7);
    border: 1px solid var(--border-fire);
    border-radius: var(--radius-lg, 20px);
    overflow: hidden;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.4);
  }
  .featured-image-wrapper {
    position: relative;
    height: 100%;
    min-height: 350px;
  }
  .featured-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .featured-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: var(--primary);
    color: #FFF;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.3rem 0.75rem;
    border-radius: 4px;
  }
  .featured-content {
    padding: 2.5rem 2rem 2.5rem 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .post-meta, .card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-subtle);
    margin-bottom: 1rem;
  }
  .category-tag, .card-category {
    color: var(--primary-light);
    font-weight: 700;
  }
  .featured-title {
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 1rem;
  }
  .featured-title a {
    color: #FFFFFF;
    text-decoration: none;
    transition: color 0.2s;
  }
  .featured-title a:hover {
    color: var(--primary-light);
  }
  .featured-excerpt {
    color: var(--text-muted);
    font-size: 0.975rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }
  .featured-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
  .author-info {
    display: flex;
    flex-direction: column;
  }
  .author-name {
    font-size: 0.9rem;
    font-weight: 700;
    color: #FFFFFF;
  }
  .author-role {
    font-size: 0.75rem;
    color: var(--text-subtle);
  }
  .read-more-btn, .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--primary-light);
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
    transition: gap 0.2s;
  }
  .read-more-btn:hover, .card-link:hover {
    gap: 0.75rem;
  }
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2rem;
  }
  .post-card {
    background: rgba(17, 17, 17, 0.8);
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 16px);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s, border-color 0.2s;
  }
  .post-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-fire);
  }
  .post-card-image {
    position: relative;
    height: 200px;
  }
  .post-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .card-category {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(4px);
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
    font-size: 0.75rem;
  }
  .post-card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .card-title {
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.4;
    margin-bottom: 0.75rem;
  }
  .card-title a {
    color: #FFFFFF;
    text-decoration: none;
    transition: color 0.2s;
  }
  .card-title a:hover {
    color: var(--primary-light);
  }
  .card-excerpt {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-link {
    margin-top: auto;
  }

  @media (max-width: 992px) {
    .featured-card {
      grid-template-columns: 1fr;
    }
    .featured-content {
      padding: 1.5rem 1.5rem 2rem;
    }
    .featured-image-wrapper {
      min-height: 250px;
    }
  }
</style>
