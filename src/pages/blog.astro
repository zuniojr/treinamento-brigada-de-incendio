---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

// Expanded list of post items with rich metadata
const featuredPost = {
  id: "reciclagem-anual-nr23",
  title: "A Importância Vital da Reciclagem Anual da Brigada de Incêndio (NR-23)",
  excerpt: "Manter a equipe treinada anualmente não é apenas uma obrigação legal perante o Corpo de Bombeiros e o Ministério do Trabalho: é o divisor de águas entre um incidente controlado e uma tragédia corporativa.",
  category: "Legislação & Normas",
  date: "12 de Agosto, 2024",
  readTime: "6 min de leitura",
  author: "Eng. Roberto Silva",
  authorRole: "Especialista em Proteção Contra Incêndio",
  image: "https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?auto=format&fit=crop&w=1200&q=80",
  badge: "Destaque da Semana"
};

const posts = [
  {
    id: "processo-emissao-renovacao-avcb",
    title: "Como Funciona o Processo de Emissão e Renovação do AVCB em 2024",
    excerpt: "Guia completo com o passo a passo exigido pelo Corpo de Bombeiros para garantir a regularização da edificação e evitar multas e interdições.",
    category: "Guia Prático",
    date: "05 de Agosto, 2024",
    readTime: "8 min de leitura",
    author: "Cap. Carlos Eduardo",
    image: "https://images.unsplash.com/photo-1582213782179-e0d53f98f2ca?auto=format&fit=crop&w=600&q=80"
  },
  {
    id: "equipamentos-essenciais-combate-incendio",
    title: "Os 5 Equipamentos Obrigatórios de Combate a Incêndio na Indústria",
    excerpt: "Extintores, hidrantes, sinalização e alarmes: entenda como dimensionar corretamente a infraestrutura de segurança conforme a carga de incêndio.",
    category: "Segurança",
    date: "28 de Julho, 2024",
    readTime: "5 min de leitura",
    author: "Téc. Mariana Costa",
    image: "https://images.unsplash.com/photo-1563245372-f21724e3856d?auto=format&fit=crop&w=600&q=80"
  },
  {
    id: "primeiros-socorros-ambiente-corporativo",
    title: "Primeiros Socorros no Trabalho: O Procedimento Passo a Passo",
    excerpt: "Além do combate às chamas, a brigada deve dominar o Atendimento Pré-Hospitalar (APH). Saiba como agir em casos de parada cardiorrespiratória e queimaduras.",
    category: "Saúde & Vida",
    date: "15 de Julho, 2024",
    readTime: "7 min de leitura",
    author: "Dra. Beatriz Santos",
    image: "https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?auto=format&fit=crop&w=600&q=80"
  },
  {
    id: "brigada-voluntaria-vs-bombeiro-civil",
    title: "Brigada Voluntária vs. Bombeiro Civil: Qual a Diferença Legal?",
    excerpt: "Esclareça as diferenças de formação, atuação e dimensionamento exigidos por lei para escolher o modelo ideal para seu estabelecimento.",
    category: "Legislação & Normas",
    date: "02 de Julho, 2024",
    readTime: "4 min de leitura",
    author: "Eng. Roberto Silva",
    image: "https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=600&q=80"
  },
  {
    id: "prevencao-perdas-patrimoniais",
    title: "O Impacto Financeiro da Brigada de Incêndio na Prevenção de Perdas",
    excerpt: "Treinar colaboradores reduz significativamente sinistros e atua diretamente na diminuição da apólice do seguro patrimonial da sua empresa.",
    category: "Gestão de Risco",
    date: "20 de Junho, 2024",
    readTime: "6 min de leitura",
    author: "Fernando Alcantara",
    image: "https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=600&q=80"
  },
  {
    id: "simulado-evacuacao-plano-abandono",
    title: "Como Organizar um Simulado de Evacuação Rápido e Sem Pânico",
    excerpt: "Dicas de planejamento para simular rotas de fuga em edifícios comerciais e plantas industriais em total conformidade com a NBR 14276.",
    category: "Guia Prático",
    date: "10 de Junho, 2024",
    readTime: "5 min de leitura",
    author: "Cap. Carlos Eduardo",
    image: "https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?auto=format&fit=crop&w=600&q=80"
  }
];

const categories = ["Todos", "Legislação & Normas", "Guia Prático", "Segurança", "Saúde & Vida", "Gestão de Risco"];
---

<Layout 
  title="Blog & Central de Conhecimento | Treinamento de Brigada de Incêndio"
  description="Artigos especializados sobre normas regulamentadoras (NR-23, NBR 14276), prevenção de incêndios, renovação de AVCB e gestão de emergências corporativas."
>
  <Header />

  <main class="blog-page">
    <!-- Hero / Header Section -->
    <section class="blog-hero">
      <div class="blog-hero-glow"></div>
      <div class="container">
        <div class="blog-hero-content" data-animate="fade-up">
          <div class="badge-alert">
            <span class="dot"></span>
            CENTRO DE INTELIGÊNCIA & REGULAMENTAÇÃO NR-23
          </div>
          
          <h1 class="blog-hero-title font-display">
            INSIGHTS SOBRE SEGURANÇA,<br />
            <span class="text-gradient-fire">PREVENÇÃO E CONFORMIDADE</span>
          </h1>
          
          <p class="blog-hero-desc">
            Acompanhe artigos técnicos, orientações de conformidade legal, treinamentos práticos e boas práticas de prevenção de acidentes para proteger vidas e o patrimônio da sua empresa.
          </p>

          <!-- Search & Filter Controls -->
          <div class="blog-search-box">
            <div class="search-input-wrapper">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="search-icon"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
              <input type="text" id="blog-search" placeholder="Pesquisar por assunto (ex: AVCB, NR-23, Primeiros Socorros)..." aria-label="Pesquisar artigos do blog" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Content Container -->
    <section class="section-padding blog-content-section">
      <div class="container">
        
        <!-- Category Filter Pills -->
        <div class="category-bar" data-animate="fade-up">
          <span class="filter-label">Filtrar por:</span>
          <div class="filter-pills" id="category-pills">
            {categories.map((cat, idx) => (
              <button 
                class={`category-btn ${idx === 0 ? 'active' : ''}`} 
                data-category={cat}
              >
                {cat}
              </button>
            ))}
          </div>
        </div>

        <!-- Featured Spotlight Card -->
        <div class="featured-wrapper" data-animate="fade-up" id="featured-card">
          <article class="featured-card glass-card">
            <div class="featured-image-col">
              <img src={featuredPost.image} alt={featuredPost.title} class="featured-img" loading="eager" />
              <div class="featured-badge">{featuredPost.badge}</div>
            </div>
            
            <div class="featured-body-col">
              <div class="post-meta">
                <span class="post-tag">{featuredPost.category}</span>
                <span class="meta-divider">•</span>
                <span class="post-date">{featuredPost.date}</span>
                <span class="meta-divider">•</span>
                <span class="post-readtime">{featuredPost.readTime}</span>
              </div>

              <h2 class="featured-title">{featuredPost.title}</h2>
              <p class="featured-excerpt">{featuredPost.excerpt}</p>

              <div class="featured-footer">
                <div class="author-info">
                  <div class="author-avatar">{featuredPost.author.charAt(0)}</div>
                  <div>
                    <strong class="author-name">{featuredPost.author}</strong>
                    <span class="author-role">{featuredPost.authorRole}</span>
                  </div>
                </div>

                <a href="#" class="btn btn-primary btn-read">
                  <span>Ler Artigo Completo</span>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                </a>
              </div>
            </div>
          </article>
        </div>

        <!-- Section Title for Grid -->
        <div class="grid-header-row" data-animate="fade-up">
          <h3 class="grid-section-title font-display">Todos os Artigos</h3>
          <span class="results-count" id="results-count">{posts.length} publicações disponíveis</span>
        </div>

        <!-- Posts Grid -->
        <div class="blog-grid" id="posts-grid">
          {posts.map((post, i) => (
            <article 
              class="blog-card glass-card" 
              data-category={post.category}
              data-title={post.title.toLowerCase()}
              data-excerpt={post.excerpt.toLowerCase()}
              data-animate="fade-up" 
              data-delay={String((i % 3) * 100)}
            >
              <div class="blog-img-wrapper">
                <img src={post.image} alt={post.title} class="blog-img" loading="lazy" />
                <div class="blog-tag">{post.category}</div>
                <div class="card-number font-display">0{i + 1}</div>
              </div>

              <div class="blog-content">
                <div class="blog-meta">
                  <span class="meta-item">
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    {post.date}
                  </span>
                  <span class="meta-divider">•</span>
                  <span class="meta-item">
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    {post.readTime}
                  </span>
                </div>

                <h3 class="blog-post-title">{post.title}</h3>
                <p class="blog-post-excerpt">{post.excerpt}</p>

                <div class="card-footer">
                  <span class="post-author-small">Por {post.author}</span>
                  <a href="#" class="blog-read-more" aria-label={`Ler artigo: ${post.title}`}>
                    <span>Ler mais</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>

        <!-- Empty State -->
        <div id="no-results" class="no-results-box glass-card" style="display: none;">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--primary-light)" stroke-width="1.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
          <h4>Nenhum artigo encontrado</h4>
          <p>Tente refinar sua busca por palavras-chave diferentes ou selecione outra categoria.</p>
          <button id="reset-filters-btn" class="btn btn-outline" style="margin-top: 1rem;">Limpar Filtros</button>
        </div>

        <!-- CTA Newsletter Banner -->
        <div class="blog-cta-banner glass-card" data-animate="fade-up">
          <div class="cta-content">
            <span class="eyebrow">Treinamento & Regularização</span>
            <h3 class="cta-title font-display">SUA EMPRESA ESTÁ COM O AVCB E A BRIGADA EM DIA?</h3>
            <p class="cta-desc">
              Não espere uma fiscalização ou emergência para agir. Oferecemos treinamento in-company customizado para a realidade da sua empresa em todo o Brasil.
            </p>
          </div>
          <div class="cta-action">
            <button onclick="openQuoteModal()" class="btn btn-primary btn-lg">
              <span>Solicitar Orçamento de Treinamento</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </button>
          </div>
        </div>

      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppButton />

  <script>
    // Filtering and Search Logic
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('blog-search') as HTMLInputElement;
      const categoryBtns = document.querySelectorAll('.category-btn');
      const postCards = document.querySelectorAll('.blog-card') as NodeListOf<HTMLElement>;
      const featuredCard = document.getElementById('featured-card') as HTMLElement;
      const noResultsBox = document.getElementById('no-results') as HTMLElement;
      const resetBtn = document.getElementById('reset-filters-btn') as HTMLButtonElement;
      const resultsCount = document.getElementById('results-count') as HTMLElement;

      let currentCategory = 'Todos';
      let currentQuery = '';

      function filterPosts() {
        let visibleCount = 0;

        postCards.forEach(card => {
          const cardCat = card.getAttribute('data-category') || '';
          const cardTitle = card.getAttribute('data-title') || '';
          const cardExcerpt = card.getAttribute('data-excerpt') || '';

          const matchesCategory = currentCategory === 'Todos' || cardCat === currentCategory;
          const matchesSearch = !currentQuery || cardTitle.includes(currentQuery) || cardExcerpt.includes(currentQuery);

          if (matchesCategory && matchesSearch) {
            card.style.display = 'flex';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        // Handle featured card visibility on category filter
        if (featuredCard) {
          if (currentCategory === 'Todos' && !currentQuery) {
            featuredCard.style.display = 'block';
          } else {
            featuredCard.style.display = 'none';
          }
        }

        // Update results counter
        if (resultsCount) {
          resultsCount.textContent = `${visibleCount} ${visibleCount === 1 ? 'publicação encontrada' : 'publicações encontradas'}`;
        }

        // Toggle No Results Message
        if (noResultsBox) {
          noResultsBox.style.display = (visibleCount === 0 && (currentCategory !== 'Todos' || currentQuery !== '')) ? 'block' : 'none';
        }
      }

      // Category Pill Click
      categoryBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          categoryBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          currentCategory = btn.getAttribute('data-category') || 'Todos';
          filterPosts();
        });
      });

      // Search Input Change
      searchInput?.addEventListener('input', (e) => {
        currentQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
        filterPosts();
      });

      // Reset Filters
      resetBtn?.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        currentQuery = '';
        currentCategory = 'Todos';
        categoryBtns.forEach(b => b.classList.remove('active'));
        categoryBtns[0]?.classList.add('active');
        filterPosts();
      });
    });
  </script>

  <style>
    .blog-page {
      padding-top: 5rem;
    }

    /* ---- Blog Hero Header ---- */
    .blog-hero {
      padding: 5rem 0 3.5rem 0;
      text-align: center;
      position: relative;
      overflow: hidden;
      border-bottom: 1px solid var(--border);
      background: radial-gradient(circle at 50% 20%, rgba(20, 20, 20, 0.8) 0%, var(--bg-main) 100%);
    }

    .blog-hero-glow {
      position: absolute;
      top: 30%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 700px;
      height: 350px;
      background: radial-gradient(ellipse, rgba(230, 48, 0, 0.15) 0%, transparent 70%);
      filter: blur(80px);
      pointer-events: none;
    }

    .blog-hero-content {
      max-width: 840px;
      margin: 0 auto;
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .blog-hero-title {
      font-size: clamp(2.8rem, 5.5vw, 4.2rem);
      margin: 1.25rem 0;
      color: #fff;
      letter-spacing: 0.02em;
    }

    .blog-hero-desc {
      font-size: 1.12rem;
      color: var(--text-muted);
      line-height: 1.7;
      max-width: 720px;
      margin: 0 auto 2.5rem auto;
    }

    /* ---- Search Bar ---- */
    .blog-search-box {
      width: 100%;
      max-width: 580px;
      margin: 0 auto;
    }

    .search-input-wrapper {
      position: relative;
      display: flex;
      align-items: center;
    }

    .search-icon {
      position: absolute;
      left: 1.25rem;
      color: var(--text-subtle);
      pointer-events: none;
      transition: color 0.2s;
    }

    .search-input-wrapper input {
      width: 100%;
      padding: 1.1rem 1.25rem 1.1rem 3.2rem;
      background: rgba(20, 20, 20, 0.85);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-full);
      color: var(--text-main);
      font-size: 0.95rem;
      backdrop-filter: blur(12px);
      transition: var(--transition);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    }

    .search-input-wrapper input:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 25px var(--primary-glow);
      background: rgba(26, 26, 26, 0.95);
    }

    .search-input-wrapper input:focus + .search-icon {
      color: var(--primary-light);
    }

    /* ---- Category Bar ---- */
    .category-bar {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      margin-bottom: 3rem;
      flex-wrap: wrap;
    }

    .filter-label {
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--text-subtle);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .filter-pills {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      flex-wrap: wrap;
    }

    .category-btn {
      padding: 0.5rem 1.15rem;
      font-size: 0.85rem;
      font-weight: 600;
      border-radius: var(--radius-full);
      background: var(--bg-card);
      border: 1px solid var(--border);
      color: var(--text-muted);
      transition: var(--transition);
      cursor: pointer;
    }

    .category-btn:hover {
      background: var(--bg-card-hover);
      color: var(--text-main);
      border-color: var(--border-light);
    }

    .category-btn.active {
      background: var(--primary);
      color: #ffffff;
      border-color: var(--primary);
      box-shadow: 0 0 16px var(--primary-glow);
    }

    /* ---- Featured Spotlight Card ---- */
    .featured-wrapper {
      margin-bottom: 4rem;
    }

    .featured-card {
      padding: 0;
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      overflow: hidden;
      border: 1px solid var(--primary-border);
      background: linear-gradient(135deg, rgba(20, 20, 20, 0.9) 0%, rgba(15, 15, 15, 0.95) 100%);
    }

    .featured-image-col {
      position: relative;
      min-height: 380px;
      overflow: hidden;
    }

    .featured-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .featured-card:hover .featured-img {
      transform: scale(1.05);
    }

    .featured-badge {
      position: absolute;
      top: 1.5rem;
      left: 1.5rem;
      background: var(--primary);
      color: #fff;
      font-size: 0.75rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      padding: 0.4rem 1rem;
      border-radius: var(--radius-full);
      box-shadow: 0 4px 14px var(--primary-glow);
    }

    .featured-body-col {
      padding: 3rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .post-meta {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 0.82rem;
      color: var(--text-subtle);
      margin-bottom: 1.25rem;
      flex-wrap: wrap;
    }

    .post-tag {
      color: var(--primary-light);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .meta-divider {
      color: var(--border-light);
    }

    .featured-title {
      font-size: clamp(1.6rem, 2.5vw, 2.1rem);
      font-weight: 800;
      line-height: 1.3;
      margin-bottom: 1.1rem;
      color: #fff;
      letter-spacing: -0.02em;
    }

    .featured-excerpt {
      font-size: 0.98rem;
      color: var(--text-muted);
      line-height: 1.7;
      margin-bottom: 2rem;
    }

    .featured-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--border);
    }

    .author-info {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .author-avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: var(--gradient-fire);
      color: #fff;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1rem;
    }

    .author-name {
      display: block;
      font-size: 0.88rem;
      color: var(--text-main);
    }

    .author-role {
      display: block;
      font-size: 0.76rem;
      color: var(--text-subtle);
    }

    .btn-read {
      padding: 0.75rem 1.4rem;
      font-size: 0.88rem;
    }

    /* ---- Grid Header ---- */
    .grid-header-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 2rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--border);
    }

    .grid-section-title {
      font-size: 2rem;
      letter-spacing: 0.04em;
    }

    .results-count {
      font-size: 0.85rem;
      color: var(--text-subtle);
      font-weight: 600;
    }

    /* ---- Blog Grid ---- */
    .blog-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
      margin-bottom: 5rem;
    }

    /* ---- Blog Cards ---- */
    .blog-card {
      padding: 0;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      position: relative;
    }

    .blog-img-wrapper {
      position: relative;
      width: 100%;
      height: 230px;
      overflow: hidden;
    }

    .blog-img {
      width: 100%;
      height: 100%;
