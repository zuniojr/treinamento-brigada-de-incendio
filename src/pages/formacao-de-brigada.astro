---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import QuoteModal from '../components/QuoteModal.astro';
import Hero from '../components/Hero.astro';
---

<Layout 
  title="Formação de Brigada de Incêndio (NR-23) | BrigadaFire"
  description="Treinamento completo de formação de brigada de incêndio conforme NR-23 e NBR 14276. Certificação reconhecida pelo Corpo de Bombeiros. Atendemos indústrias, comércio e condomínios em Santa Catarina."
>
  <Header />

  <main id="main-content" class="formacao-page">

    <Hero 
      badge="CERTIFICAÇÃO NR-23 | NBR 14276"
      titleSolid="FORMAÇÃO DE"
      titleStroke="BRIGADA DE INCÊNDIO"
      subtitle="Treinamento técnico completo para capacitação de brigadistas conforme as exigências da NR-23 e NBR 14276. Certificado com validade legal reconhecido pelo Corpo de Bombeiros Militar."
      primaryCtaText="Solicitar Proposta Comercial"
      secondaryCtaText="Tirar Dúvidas no WhatsApp"
      secondaryCtaLink="https://wa.me/5511999999999"
      showStats={false}
      image="https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?auto=format&fit=crop&w=1920&q=85"
    />

    <!-- O que é / Obrigatoriedade -->
    <section class="obligation-section container">
      <div class="obligation-grid">
        <div class="obligation-text">
          <span class="eyebrow">OBRIGATORIEDADE LEGAL</span>
          <h2 class="font-display">SUA EMPRESA <span class="text-fire">É OBRIGADA</span> A TER BRIGADA?</h2>
          <p>Sim. A <strong>NR-23 do Ministério do Trabalho e Emprego</strong> determina que toda empresa deve possuir sistemas de proteção contra incêndio e brigada treinada. O não cumprimento sujeita o empregador a:</p>
          <ul class="penalty-list">
            <li>
              <div class="penalty-dot"></div>
              <span>Autuação e embargo do estabelecimento pelo Ministério do Trabalho</span>
            </li>
            <li>
              <div class="penalty-dot"></div>
              <span>Não aprovação na vistoria do Corpo de Bombeiros (AVCB / CLCB)</span>
            </li>
            <li>
              <div class="penalty-dot"></div>
              <span>Responsabilização civil e criminal em caso de sinistro</span>
            </li>
            <li>
              <div class="penalty-dot"></div>
              <span>Multas trabalhistas por descumprimento de norma regulamentadora</span>
            </li>
          </ul>
        </div>
        <div class="norms-box">
          <h3>Normas que regem o treinamento</h3>
          <div class="norm-item">
            <div class="norm-tag">NR-23</div>
            <div>
              <strong>Proteção Contra Incêndios</strong>
              <p>Norma do MTE que estabelece a obrigatoriedade de equipe de brigada treinada em todas as empresas.</p>
            </div>
          </div>
          <div class="norm-item">
            <div class="norm-tag">NBR 14276</div>
            <div>
              <strong>Programa de Brigada de Incêndio</strong>
              <p>Define os critérios de formação, dimensionamento, treinamento e reciclagem dos brigadistas.</p>
            </div>
          </div>
          <div class="norm-item">
            <div class="norm-tag">IT / CB</div>
            <div>
              <strong>Instruções Técnicas do CBMSC</strong>
              <p>Determinam requisitos específicos para vistorias e emissão do atestado de brigada em Santa Catarina.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Conteúdo Programático -->
    <section class="curriculum-section">
      <div class="container">
        <div class="section-header text-center">
          <h2 class="section-title font-display">CONTEÚDO <span class="text-fire">PROGRAMÁTICO</span></h2>
          <p class="section-desc">Módulos técnicos que compõem o curso de formação de brigada conforme a NBR 14276.</p>
        </div>
        <div class="curriculum-grid">
          <div class="curriculum-card">
            <div class="curriculum-number">01</div>
            <div class="curriculum-content">
              <h3>Fundamentos de Combate a Incêndio</h3>
              <ul>
                <li>Triângulo e tetraedro do fogo</li>
                <li>Classes de incêndio (A, B, C, D e K)</li>
                <li>Métodos de extinção</li>
                <li>Agentes extintores e suas aplicações</li>
                <li>Uso correto de extintores portáteis</li>
              </ul>
            </div>
          </div>

          <div class="curriculum-card">
            <div class="curriculum-number">02</div>
            <div class="curriculum-content">
              <h3>Sistemas de Proteção Predial</h3>
              <ul>
                <li>Hidrantes e mangotinhos</li>
                <li>Sprinklers e chuveiros automáticos</li>
                <li>Sistemas de detecção e alarme</li>
                <li>Sinalização de emergência fotoluminescente</li>
                <li>Portas e saídas de emergência</li>
              </ul>
            </div>
          </div>

          <div class="curriculum-card">
            <div class="curriculum-number">03</div>
            <div class="curriculum-content">
              <h3>Abandono de Área e Evacuação</h3>
              <ul>
                <li>Plano de ação de emergência (PAE)</li>
                <li>Técnicas de abandono por pavimento</li>
                <li>Liderança de equipes em emergências</li>
                <li>Ponto de encontro e triagem</li>
                <li>Comunicação com Bombeiros</li>
              </ul>
            </div>
          </div>

          <div class="curriculum-card">
            <div class="curriculum-number">04</div>
            <div class="curriculum-content">
              <h3>Primeiros Socorros Básicos</h3>
              <ul>
                <li>Suporte Básico de Vida (SBV)</li>
                <li>RCP e uso do DEA</li>
                <li>Hemorragias e choque</li>
                <li>Queimaduras e intoxicações</li>
                <li>Posição lateral de segurança</li>
              </ul>
            </div>
          </div>

          <div class="curriculum-card">
            <div class="curriculum-number">05</div>
            <div class="curriculum-content">
              <h3>Prática com Extintores (Campo)</h3>
              <ul>
                <li>Simulação real com fogo controlado</li>
                <li>Técnica PASS (pino, alça, aponte, aperte)</li>
                <li>Segurança durante o combate</li>
                <li>Reconhecimento dos limites de atuação</li>
                <li>Ativação do sistema de hidrante</li>
              </ul>
            </div>
          </div>

          <div class="curriculum-card">
            <div class="curriculum-number">06</div>
            <div class="curriculum-content">
              <h3>Avaliação e Certificação</h3>
              <ul>
                <li>Prova teórica escrita (mínimo 70%)</li>
                <li>Avaliação prática supervisionada</li>
                <li>Registro fotográfico e documental</li>
                <li>Emissão do certificado individual</li>
                <li>Atestado de brigada para o CBMSC</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Carga Horária e Modalidades -->
    <section class="modalities-section container">
      <div class="section-header text-center">
        <h2 class="section-title font-display">CARGA HORÁRIA E <span class="text-fire">MODALIDADES</span></h2>
        <p class="section-desc">A carga horária varia conforme o grau de risco da edificação definido na NBR 14276.</p>
      </div>
      <div class="modalities-grid">
        <div class="modality-card">
          <div class="modality-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M12 6v6l4 2"></path>
            </svg>
          </div>
          <h3>Grau de Risco Baixo</h3>
          <div class="modality-hours">4h</div>
          <p>Escritórios, comércio varejista e edificações de baixa carga de incêndio. Conteúdo teórico e demonstração prática.</p>
        </div>

        <div class="modality-card featured">
          <div class="featured-tag">Mais Contratado</div>
          <div class="modality-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M12 6v6l4 2"></path>
            </svg>
          </div>
          <h3>Grau de Risco Médio</h3>
          <div class="modality-hours">16h</div>
          <p>Indústrias, shopping centers, hospitais e condomínios de grande porte. Teoria + prática com fogo real controlado.</p>
        </div>

        <div class="modality-card">
          <div class="modality-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M12 6v6l4 2"></path>
            </svg>
          </div>
          <h3>Grau de Risco Alto</h3>
          <div class="modality-hours">24h</div>
          <p>Plantas químicas, petroquímicas, gases inflamáveis e edificações de alto risco. Módulo avançado de combate.</p>
        </div>
      </div>
    </section>

    <!-- Diferenciais -->
    <section class="differentials-section">
      <div class="container">
        <div class="differentials-grid">
          <div class="diff-text">
            <h2 class="font-display">POR QUE ESCOLHER A <span class="text-fire">BRIGADAFIRE?</span></h2>
            <p>Somos especialistas exclusivos em segurança contra incêndio com equipe técnica qualificada e estrutura de treinamento própria.</p>
          </div>
          <div class="diff-items">
            <div class="diff-item">
              <div class="diff-icon">🎓</div>
              <div>
                <h4>Instrutores Certificados</h4>
                <p>Equipe formada por bombeiros civis, técnicos em segurança do trabalho e engenheiros de segurança com ART.</p>
              </div>
            </div>
            <div class="diff-item">
              <div class="diff-icon">🏭</div>
              <div>
                <h4>Treinamento In-Company</h4>
                <p>Realizamos o treinamento diretamente nas instalações da sua empresa, sem deslocamento da equipe.</p>
              </div>
            </div>
            <div class="diff-item">
              <div class="diff-icon">📋</div>
              <div>
                <h4>Documentação Completa</h4>
                <p>Certificados individuais, lista de presença, relatório fotográfico e atestado de brigada para o Corpo de Bombeiros.</p>
              </div>
            </div>
            <div class="diff-item">
              <div class="diff-icon">🔁</div>
              <div>
                <h4>Reciclagem Anual Incluída</h4>
                <p>Planos de fidelidade com reciclagem anual garantida e acompanhamento técnico contínuo da brigada.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq-section container">
      <div class="section-header text-center">
        <h2 class="section-title font-display">PERGUNTAS <span class="text-fire">FREQUENTES</span></h2>
      </div>
      <div class="faq-list">
        <details class="faq-item">
          <summary>Quantos brigadistas minha empresa precisa ter?</summary>
          <p>O número de brigadistas é calculado conforme a NBR 14276, levando em conta o número de funcionários por turno, o grau de risco da atividade, a área construída e o número de pavimentos. Nossa equipe realiza o dimensionamento gratuito na proposta.</p>
        </details>
        <details class="faq-item">
          <summary>O certificado tem validade? Quando precisa renovar?</summary>
          <p>Sim. A NBR 14276 estabelece que brigadistas de risco baixo devem realizar reciclagem a cada 2 anos, enquanto os de risco médio e alto devem renovar anualmente. O simulado de evacuação também deve ser realizado ao menos uma vez por ano.</p>
        </details>
        <details class="faq-item">
          <summary>O treinamento pode ser feito na minha empresa?</summary>
          <p>Sim, e essa é nossa principal modalidade. Realizamos o treinamento in-company com toda a estrutura didática e de campo (extintores de treinamento, fogo controlado, materiais didáticos). Sua equipe não precisa se deslocar.</p>
        </details>
        <details class="faq-item">
          <summary>Qualquer funcionário pode ser brigadista?</summary>
          <p>Sim, desde que seja voluntário ou designado pelo empregador, tenha aptidão física atestada, e não pertença a grupos de risco (gestantes, PCDs em certos casos). A empresa deve garantir que o brigadista esteja disponível durante o turno de trabalho.</p>
        </details>
        <details class="faq-item">
          <summary>O treinamento serve para qualquer tipo de empresa?</summary>
          <p>Sim. Atendemos indústrias, comércio, condomínios residenciais e comerciais, hospitais, escolas e qualquer segmento que precise cumprir a NR-23. Adaptamos o conteúdo aos riscos específicos de cada atividade.</p>
        </details>
      </div>
    </section>

    <!-- CTA Final -->
    <section class="cta-banner-section container">
      <div class="cta-banner-box">
        <div class="cta-content">
          <h2 class="font-display">REGULARIZE SUA EMPRESA <span class="text-fire">HOJE MESMO</span></h2>
          <p>Solicite uma proposta personalizada para o treinamento da sua brigada. Atendimento rápido e orçamento sem compromisso.</p>
        </div>
        <div class="cta-actions">
          <button type="button" onclick="openQuoteModal()" class="btn-primary-action">Solicitar Proposta Agora</button>
          <a href="/contato" class="btn-secondary-action">Falar com a Equipe</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
  <WhatsAppButton />
  <QuoteModal />
</Layout>

<style>
  .formacao-page {
    background-color: var(--bg-main);
    min-height: 100vh;
    color: var(--text-main);
  }

  /* ── Obligation ── */
  .obligation-section {
    padding: 6rem 0;
  }

  .obligation-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .eyebrow {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--primary);
    margin-bottom: 1rem;
  }

  .obligation-text h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    margin-bottom: 1.25rem;
  }

  .obligation-text > p {
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 1.75rem;
  }

  .penalty-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .penalty-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .penalty-dot {
    width: 8px;
    height: 8px;
    background: var(--primary);
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: 0.45rem;
  }

  .norms-box {
    background: rgba(20,20,22,0.7);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .norms-box h3 {
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.25rem;
  }

  .norm-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .norm-tag {
    background: rgba(230,48,0,0.12);
    border: 1px solid rgba(230,48,0,0.25);
    color: var(--primary);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.3rem 0.6rem;
    border-radius: 4px;
    white-space: nowrap;
    letter-spacing: 0.03em;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .norm-item strong {
    display: block;
    font-size: 0.95rem;
    color: #fff;
    margin-bottom: 0.3rem;
  }

  .norm-item p {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* ── Curriculum ── */
  .curriculum-section {
    background: rgba(10,10,12,0.6);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 6rem 0;
  }

  .section-header { margin-bottom: 4rem; }

  .section-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin-bottom: 1rem;
  }

  .section-desc {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 700px;
    margin: 0 auto;
  }

  .curriculum-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .curriculum-card {
    background: rgba(20,20,22,0.7);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 2rem;
    display: flex;
    gap: 1.25rem;
    transition: all 0.3s ease;
  }

  .curriculum-card:hover {
    border-color: rgba(230,48,0,0.3);
    transform: translateY(-4px);
  }

  .curriculum-number {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2.5rem;
    color: rgba(230,48,0,0.25);
    line-height: 1;
    flex-shrink: 0;
  }

  .curriculum-content h3 {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.85rem;
    color: #fff;
  }

  .curriculum-content ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .curriculum-content li {
    font-size: 0.85rem;
    color: var(--text-muted);
    padding-left: 1rem;
    position: relative;
  }

  .curriculum-content li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--primary);
    font-size: 0.75rem;
  }

  /* ── Modalities ── */
  .modalities-section {
    padding: 6rem 0;
  }

  .modalities-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .modality-card {
    background: rgba(20,20,22,0.6);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 2.5rem 2rem;
    text-align: center;
    transition: all 0.3s ease;
    position: relative;
  }

  .modality-card.featured {
    background: rgba(30,12,5,0.8);
    border-color: rgba(230,48,0,0.4);
    box-shadow: 0 0 40px rgba(230,48,0,0.1);
  }

  .featured-tag {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--primary);
    color: white;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.3rem 1rem;
    border-radius: 20px;
    white-space: nowrap;
  }

  .modality-card:hover {
    transform: translateY(-5px);
  }

  .modality-icon {
    width: 60px;
    height: 60px;
    background: rgba(230,48,0,0.1);
    border: 1px solid rgba(230,48,0,0.2);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.25rem;
  }

  .modality-card h3 {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .modality-hours {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 4rem;
    color: var(--primary);
    line-height: 1;
    margin-bottom: 1rem;
  }

  .modality-card p {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  /* ── Differentials ── */
  .differentials-section {
    background: rgba(10,10,12,0.6);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 6rem 0;
  }

  .differentials-grid {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 5rem;
    align-items: center;
  }

  .diff-text h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    margin-bottom: 1.25rem;
  }

  .diff-text p {
    color: var(--text-muted);
    line-height: 1.7;
  }

  .diff-items {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .diff-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    background: rgba(20,20,22,0.6);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.5rem;
    transition: all 0.3s ease;
  }

  .diff-item:hover {
    border-color: rgba(230,48,0,0.25);
  }

  .diff-icon {
    font-size: 1.75rem;
    flex-shrink: 0;
  }

  .diff-item h4 {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.4rem;
    color: #fff;
  }

  .diff-item p {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* ── FAQ ── */
  .faq-section {
    padding: 6rem 0;
    max-width: 900px;
    margin: 0 auto;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .faq-item {
    background: rgba(20,20,22,0.6);
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    transition: border-color 0.3s ease;
  }

  .faq-item[open] {
    border-color: rgba(230,48,0,0.3);
  }

  .faq-item summary {
    font-size: 1rem;
    font-weight: 600;
    color: #fff;
    padding: 1.25rem 1.5rem;
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    user-select: none;
  }

  .faq-item summary::-webkit-details-marker { display: none; }

  .faq-item summary::after {
    content: '+';
    font-size: 1.5rem;
    color: var(--primary);
