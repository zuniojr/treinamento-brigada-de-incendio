---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import QuoteModal from '../components/QuoteModal.astro';
---

<Layout 
  title="Contato e Atendimento Corporativo | BrigadaFire"
  description="Entre em contato com a equipe técnica e comercial da BrigadaFire. Orçamentos para treinamentos in-company de Brigada de Incêndio (NR-23), consultoria e suporte."
>
  <Header />

  <main id="main-content" class="contact-page">
    <!-- Hero Banner -->
    <section class="contact-hero">
      <div class="contact-hero-bg">
        <div class="contact-glow"></div>
      </div>
      <div class="container contact-hero-container">
        <div class="contact-badge">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          <span>ATENDIMENTO ESPECIALIZADO</span>
        </div>
        <h1 class="font-display">FALE COM NOSSOS <span class="text-fire">ESPECIALISTAS</span></h1>
        <p class="hero-subtitle">
          Estamos prontos para atender sua empresa, agendar treinamentos *in-company*, esclarecer dúvidas sobre a NR-23 e dimensionar sua equipe de brigadistas.
        </p>
      </div>
    </section>

    <!-- Cards de Canais de Atendimento Rápido -->
    <section class="channels-section container">
      <div class="channels-grid">
        <!-- WhatsApp -->
        <a href="https://wa.me/5511999999999" target="_blank" rel="noopener noreferrer" class="channel-card highlight-wa">
          <div class="channel-icon wa-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
          </div>
          <div class="channel-info">
            <span class="channel-label">Atendimento Imediato</span>
            <h3>WhatsApp Comercial</h3>
            <p>Fale direto com nossa equipe via chat para orçamentos rápidos.</p>
            <span class="channel-link-text">Iniciar Conversa &rarr;</span>
          </div>
        </a>

        <!-- Telefone / Ligação -->
        <div class="channel-card">
          <div class="channel-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
          </div>
          <div class="channel-info">
            <span class="channel-label">Central Telefônica</span>
            <h3>0800 / Telefone Fixo</h3>
            <p>Segunda a Sexta, das 08h às 18h</p>
            <span class="channel-link-text">(47) 3000-0000</span>
          </div>
        </div>

        <!-- E-mail -->
        <a href="mailto:contato@brigadafire.com.br" class="channel-card">
          <div class="channel-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </div>
          <div class="channel-info">
            <span class="channel-label">Propostas e Contratos</span>
            <h3>E-mail Oficial</h3>
            <p>Envie sua solicitação técnica ou edital</p>
            <span class="channel-link-text">contato@brigadafire.com.br</span>
          </div>
        </a>
      </div>
    </section>

    <!-- Seção Principal de Formulário e Mapa/Localização -->
    <section class="main-contact-section container">
      <div class="contact-grid">
        <!-- Coluna Esquerda: Formulário de Mensagem Direta -->
        <div class="contact-form-box">
          <div class="form-title-group">
            <h2 class="font-display">ENVIE UMA <span class="text-fire">MENSAGEM</span></h2>
            <p>Preencha os campos abaixo e responderemos em até 2 horas úteis.</p>
          </div>

          <form class="contact-form" onsubmit="event.preventDefault(); alert('Mensagem enviada com sucesso! Nossa equipe entrará em contato em breve.');">
            <div class="input-row">
              <div class="input-group">
                <label for="contact-name">Seu Nome *</label>
                <input type="text" id="contact-name" required placeholder="Ex: Carlos Silva" />
              </div>
              <div class="input-group">
                <label for="contact-company">Empresa / Condomínio *</label>
                <input type="text" id="contact-company" required placeholder="Nome da empresa" />
              </div>
            </div>

            <div class="input-row">
              <div class="input-group">
                <label for="contact-email">E-mail Corporativo *</label>
                <input type="email" id="contact-email" required placeholder="carlos@empresa.com.br" />
              </div>
              <div class="input-group">
                <label for="contact-phone">Telefone / WhatsApp *</label>
                <input type="tel" id="contact-phone" required placeholder="(00) 90000-0000" />
              </div>
            </div>

            <div class="input-group">
              <label for="contact-subject">Assunto Principal *</label>
              <select id="contact-subject" required>
                <option value="" disabled selected>Selecione o assunto</option>
                <option value="orcamento">Solicitar Orçamento de Treinamento (NR-23)</option>
                <option value="duvida-tecnica">Dúvida Técnica sobre Dimensionamento / Carga Horária</option>
                <option value="certificados">Validação ou Reimpressão de Certificado</option>
                <option value="parcerias">Parcerias e Vistorias Prediais</option>
                <option value="outros">Outros Assuntos</option>
              </select>
            </div>

            <div class="input-group">
              <label for="contact-message">Sua Mensagem *</label>
              <textarea id="contact-message" rows="5" required placeholder="Descreva a quantidade aproximada de colaboradores, localização da empresa ou sua dúvida técnica..."></textarea>
            </div>

            <button type="submit" class="btn-submit-contact">Enviar Mensagem</button>
          </form>
        </div>

        <!-- Coluna Direita: Informações de Atendimento e FAQ Rápido -->
        <div class="contact-info-box">
          <div class="info-card">
            <h3>Horário de Atendimento</h3>
            <p>Nossa equipe técnica comercial está disponível nos seguintes horários:</p>
            <ul class="info-list">
              <li><strong>Segunda a Sexta:</strong> 08:00 às 18:00</li>
              <li><strong>Sábados:</strong> 08:00 às 12:00 (Plantão de Treinamentos In-Company)</li>
              <li><strong>Domingos e Feriados:</strong> Fechado (Atendimento WhatsApp em plantão)</li>
            </ul>
          </div>

          <div class="info-card">
            <h3>Região de Atendimento</h3>
            <p>Atendemos presencialmente em todo o estado de <strong>Santa Catarina</strong> com estrutura móvel para simulações in-company:</p>
            <div class="regions-badges">
              <span>Barra Velha</span>
              <span>Itajaí</span>
              <span>Balneário Camboriú</span>
              <span>Joinville</span>
              <span>Navegantes</span>
              <span>Blumenau</span>
              <span>Penha</span>
              <span>Jaraguá do Sul</span>
            </div>
          </div>

          <div class="info-card cta-modal-card">
            <h4>Prefere simular um orçamento online?</h4>
            <p>Utilize nossa ferramenta rápida de cotação interativa.</p>
            <button type="button" onclick="openQuoteModal()" class="btn-modal-trigger">Abrir Simulador de Orçamento</button>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppButton />
  <QuoteModal />
</Layout>

<style>
  /* Base Styles */
  .contact-page {
    background-color: var(--bg-main);
    padding-top: var(--nav-height, 80px);
    min-height: 100vh;
    color: var(--text-main);
  }

  /* Hero Section */
  .contact-hero {
    position: relative;
    padding: 5rem 0 3.5rem;
    overflow: hidden;
    border-bottom: 1px solid var(--border, rgba(255, 255, 255, 0.07));
    background: radial-gradient(circle at 50% 0%, rgba(230, 48, 0, 0.08) 0%, transparent 70%);
  }

  .contact-hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .contact-glow {
    position: absolute;
    top: -30%;
    left: 50%;
    transform: translateX(-50%);
    width: 650px;
    height: 650px;
    background: radial-gradient(circle, var(--primary-glow) 0%, transparent 65%);
    filter: blur(40px);
  }

  .contact-hero-container {
    position: relative;
    z-index: 1;
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
    padding: 0 1.5rem;
  }

  .contact-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(230, 48, 0, 0.12);
    border: 1px solid var(--border-fire, rgba(230, 48, 0, 0.35));
    color: var(--primary-light, #FF4A1A);
    padding: 0.4rem 1rem;
    border-radius: var(--radius-full, 9999px);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }

  .contact-hero h1 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(2.75rem, 6vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: 0.02em;
    margin-bottom: 1.25rem;
    color: #FFFFFF;
  }

  .text-fire {
    color: var(--primary);
    background: linear-gradient(135deg, #FF4A1A 0%, var(--primary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 1.125rem;
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 760px;
    margin: 0 auto;
  }

  /* Channels Section */
  .channels-section {
    max-width: 1100px;
    margin: 3.5rem auto 0;
    padding: 0 1.5rem;
  }

  .channels-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.75rem;
  }

  .channel-card {
    background: rgba(20, 20, 20, 0.7);
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 16px);
    padding: 1.75rem;
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    text-decoration: none;
    color: inherit;
    transition: var(--transition-fast);
  }

  .channel-card:hover {
    border-color: var(--border-fire);
    transform: translateY(-4px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }

  .channel-card.highlight-wa {
    background: linear-gradient(135deg, rgba(20, 35, 25, 0.8) 0%, rgba(15, 25, 20, 0.8) 100%);
    border-color: rgba(37, 211, 102, 0.3);
  }

  .channel-card.highlight-wa:hover {
    border-color: #25D366;
    box-shadow: 0 10px 30px rgba(37, 211, 102, 0.2);
  }

  .channel-icon {
    background: rgba(230, 48, 0, 0.12);
    width: 52px;
    height: 52px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .wa-icon {
    background: rgba(37, 211, 102, 0.15);
    color: #25D366;
  }

  .channel-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-subtle);
    margin-bottom: 0.25rem;
    display: block;
  }

  .channel-info h3 {
    font-size: 1.15rem;
    color: #FFFFFF;
    margin-bottom: 0.35rem;
    font-weight: 700;
  }

  .channel-info p {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
    line-height: 1.5;
  }

  .channel-link-text {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--primary-light, #FF4A1A);
  }

  .highlight-wa .channel-link-text {
    color: #25D366;
  }

  /* Main Contact Form & Info Grid */
  .main-contact-section {
    max-width: 1100px;
    margin: 4rem auto 6rem;
    padding: 0 1.5rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 3rem;
  }

  .contact-form-box {
    background: rgba(17, 17, 17, 0.85);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg, 20px);
    padding: 2.5rem;
    backdrop-filter: blur(10px);
  }

  .form-title-group {
    margin-bottom: 2rem;
  }

  .form-title-group h2 {
    font-size: 2rem;
    color: #FFFFFF;
    margin-bottom: 0.4rem;
  }

  .form-title-group p {
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .input-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .input-group label {
    font-size: 0.85rem;
    font-weight: 600;
    color: #E2E8F0;
  }

  .input-group input,
  .input-group select,
  .input-group textarea {
    background: rgba(10, 10, 10, 0.8);
    border: 1px solid var(--border-light, rgba(255, 255, 255, 0.15));
    border-radius: var(--radius-sm, 8px);
    padding: 0.8rem 1rem;
    color: #FFFFFF;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.95rem;
    outline: none;
    transition: var(--transition-fast);
  }

  .input-group input:focus,
  .input-group select:focus,
  .input-group textarea:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(230, 48, 0, 0.2);
  }

  .input-group select option {
    background: #111;
    color: #FFF;
  }

  .btn-submit-contact {
    background: var(--gradient-fire, linear-gradient(135deg, #E63000 0%, #A82200 100%));
    color: #FFFFFF;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 700;
    font-size: 1rem;
    padding: 1rem;
    border: none;
    border-radius: var(--radius-sm, 8px);
    cursor: pointer;
    transition: var(--transition-fast);
    box-shadow: 0 4px 15px rgba(230, 48, 0, 0.3);
    margin-top: 0.5rem;
  }

  .btn-submit-contact:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(230, 48, 0, 0.45);
  }

  /* Info Column Right */
  .contact-info-box {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .info-card {
    background: rgba(20, 20, 20, 0.6);
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 16px);
    padding: 1.75rem;
  }

  .info-card h3 {
    font-size: 1.15rem;
    color: #FFFFFF;
    margin-bottom: 0.75rem;
    font-weight: 700;
  }

  .info-card p {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .info-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .info-list li strong {
    color: #FFFFFF;
  }

  .regions-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .regions-badges span {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #E2E8F0;
    font-size: 0.8rem;
    padding: 0.3rem 0.65rem;
    border-radius: 6px;
  }

  .cta-modal-card {
    background: linear-gradient(135deg, rgba(30, 15, 15, 0.9) 0%, rgba(20, 20, 20, 0.9) 100%);
    border-color: var(--border-fire);
  }

  .cta-modal-card h4 {
    font-size: 1.1rem;
    color: #FFFFFF;
    margin-bottom: 0.4rem;
  }

  .btn-modal-trigger {
    width: 100%;
    background: rgba(230, 48, 0, 0.15);
    border: 1px solid var(--border-fire);
    color: #FFFFFF;
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm, 8px);
    cursor: pointer;
    transition: var(--transition-fast);
    margin-top: 0.5rem;
  }

  .btn-modal-trigger:hover {
    background: var(--primary);
    border-color: var(--primary);
  }

  /* Responsive Design */
  @media (max-width: 992px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 640px) {
    .input-row {
      grid-template-columns: 1fr;
    }
    .contact-form-box {
      padding: 1.75rem 1.25rem;
    }
  }
</style>
