---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import QuoteModal from '../components/QuoteModal.astro';
---

<Layout 
  title="Módulos Personalizados de Brigada por Setor | BrigadaFire"
  description="Treinamentos de Brigada de Incêndio (NR-23) customizados sob medida para a área de atuação, matriz de risco e ambiente operacional da sua empresa."
>
  <Header />

  <main id="main-content" class="custom-modules-page">
    <!-- Hero Banner -->
    <section class="modules-hero">
      <div class="modules-hero-bg">
        <div class="modules-glow"></div>
      </div>
      <div class="container modules-hero-container">
        <div class="modules-badge">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
          </svg>
          <span>100% SOB MEDIDA PARA O SEU SEGMENTO</span>
        </div>
        <h1 class="font-display">MÓDULOS <span class="text-fire">PERSONALIZADOS</span></h1>
        <p class="hero-subtitle">
          Cada setor possui riscos específicos. Desenvolvemos programas de treinamento de Brigada de Incêndio focados na matriz de risco, área de atuação e rotina operacional da sua empresa.
        </p>
        <div class="hero-cta-group">
          <button type="button" onclick="openQuoteModal()" class="btn-hero-primary">Montar Módulo para Minha Empresa</button>
          <a href="https://bitlybr.net/TreinamentoBrigada" target="_blank" class="btn-hero-secondary">Consultar Engenheiro no WhatsApp</a>
        </div>
      </div>
    </section>

    <!-- Por que Personalizar (Pilares de Risco) -->
    <section class="pillars-section container">
      <div class="section-header text-center">
        <h2 class="section-title font-display">POR QUE O TREINAMENTO PADRÃO <span class="text-fire">NÃO BASTA?</span></h2>
        <p class="section-desc">Uma indústria química não possui os mesmos riscos que um hospital ou condomínio logístico. Nossos módulos adaptam o conteúdo teórico e prático para o cenário real enfrentado pelos seus brigadistas.</p>
      </div>

      <div class="pillars-grid">
        <div class="pillar-card">
          <div class="pillar-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2">
              <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
              <line x1="12" y1="9" x2="12" y2="13"/>
              <line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
          </div>
          <h3>Análise da Matriz de Risco</h3>
          <p>Identificamos as cargas de incêndio da sua planta (combustíveis, produtos químicos, alta tensão, poeira orgânica) para direcionar o agente extintor correto.</p>
        </div>

        <div class="pillar-card">
          <div class="pillar-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
          <h3>Perfil dos Colaboradores</h3>
          <p>Treinamentos adaptados para equipes administrativas, operacionais de fábrica, brigadas de campo ou equipes de vigilância noturna.</p>
        </div>

        <div class="pillar-card">
          <div class="pillar-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
              <line x1="8" y1="21" x2="16" y2="21"/>
              <line x1="12" y1="17" x2="12" y2="21"/>
            </svg>
          </div>
          <h3>Integração com PAM e Plano de Emergência</h3>
          <p>Alinhamento dos simulados práticos ao Plano de Ação de Emergência (PAE) e aos Planos de Auxílio Mútuo (PAM) da sua região industrial.</p>
        </div>
      </div>
    </section>

    <!-- Módulos Específicos por Setor (Grid de Segmentos) -->
    <section class="sectors-section container">
      <div class="section-header">
        <h2 class="section-title font-display">MÓDULOS ESPECÍFICOS POR <span class="text-fire">SEGMENTO</span></h2>
        <p class="section-desc">Conheça alguns dos programas customizados mais solicitados por nossos clientes corporativos:</p>
      </div>

      <div class="sectors-grid">
        <!-- Setor 1: Indústria e Manufatura -->
        <div class="sector-card">
          <div class="sector-badge">INDÚSTRIA</div>
          <h3>Indústrias Química, Têxtil e Metalúrgica</h3>
          <p>Foco em produtos perigosos, vazamento de gases, líquidos inflamáveis (Classe B) e prevenção em máquinas de alta temperatura.</p>
          <ul class="sector-features">
            <li>Uso de LGE (Líquido Gerador de Espuma)</li>
            <li>Procedimentos de Lockout / Tagout (LOTO)</li>
            <li>Combate a incêndios em quadros elétricos energizados</li>
          </ul>
        </div>

        <!-- Setor 2: Centros Logísticos e Galpões -->
        <div class="sector-card">
          <div class="sector-badge">LOGÍSTICA</div>
          <h3>Centros de Distribuição e Galpões</h3>
          <p>Foco em estocagem verticalizada de alta densidade, operação de empilhadeiras, sprinklers de resposta rápida e evacuação de grandes áreas.</p>
          <ul class="sector-features">
            <li>Abandono de instalações com pé-direito elevado</li>
            <li>Combate com rede de hidrantes de alta vazão</li>
            <li>Primeiros socorros para traumas de prensagem</li>
          </ul>
        </div>

        <!-- Setor 3: Condomínios e Edifícios Comerciais -->
        <div class="sector-card">
          <div class="sector-badge">PREDIAL</div>
          <h3>Condomínios Residenciais e Comerciais</h3>
          <p>Capacitação de zeladores, porteiros e moradores para abandono de edificações verticais, uso de elevadores de emergência e pânico.</p>
          <ul class="sector-features">
            <li>Procedimentos de evacuação em escadas enclausuradas</li>
            <li>Resgate de pessoas presas em elevadores</li>
            <li>Manuseio da central de alarme de incêndio predial</li>
          </ul>
        </div>

        <!-- Setor 4: Saúde, Hospitais e Clínicas -->
        <div class="sector-card">
          <div class="sector-badge">SAÚDE</div>
          <h3>Hospitais, Clínicas e Laboratórios</h3>
          <p>Estratégia de remoção horizontal e vertical de pacientes acamados, controle de pânico em UTIs e contenção de vazamentos de gases medicinais.</p>
          <ul class="sector-features">
            <li>Evacuação progressiva de leitos hospitalares</li>
            <li>Uso de extintores de CO2 e Água Nebulizada</li>
            <li>Treinamento com equipe multiprofissional de saúde</li>
          </ul>
        </div>

        <!-- Setor 5: Supermercados e Varejo -->
        <div class="sector-card">
          <div class="sector-badge">VAREJO</div>
          <h3>Supermercados, Shoppings e Varejo</h3>
          <p>Orientação ao público visitante, controle de tumultos em eventos de alta circulação e combate em depósitos de embalagens plásticas e papelão.</p>
          <ul class="sector-features">
            <li>Orientação e guiamanento de clientes em emergências</li>
            <li>Combate a incêndios em praças de alimentação (gorduras)</li>
            <li>Suporte Básico de Vida (DEA) para clientes e funcionários</li>
          </ul>
        </div>

        <!-- Setor 6: Hotéis e Pousadas -->
        <div class="sector-card">
          <div class="sector-badge">TURISMO</div>
          <h3>Hoteleira, Resorts e Pousadas</h3>
          <p>Segurança de hóspedes, sinalização de rotas em múltiplos idiomas e plano de abandono noturno para equipes de recepção e governança.</p>
          <ul class="sector-features">
            <li>Primeiros socorros e afogamento (áreas de piscina)</li>
            <li>Comunicação de emergência com hóspedes</li>
            <li>Varredura e checagem de apartamentos em evacuação</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Banner de CTA Final -->
    <section class="cta-banner-section container">
      <div class="cta-banner-box">
        <div class="cta-content">
          <h2 class="font-display">QUER UM MÓDULO EXCLUSIVO PARA O <span class="text-fire">SEU RISCO?</span></h2>
          <p>Nossa engenharia de segurança elabora a ementa do treinamento sob medida para a realidade do seu negócio.</p>
        </div>
        <div class="cta-actions">
          <button type="button" onclick="openQuoteModal()" class="btn-primary-action">Solicitar Proposta Customizada</button>
          <a href="https://bitlybr.net/TreinamentoBrigada" target="_blank" class="btn-secondary-action">Falar no WhatsApp</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppButton />
  <QuoteModal />
</Layout>

<style>
  /* Base Styles */
  .custom-modules-page {
    background-color: var(--bg-main);
    padding-top: var(--nav-height, 80px);
    min-height: 100vh;
    color: var(--text-main);
  }

  /* Hero Section */
  .modules-hero {
    position: relative;
    padding: 5.5rem 0 4rem;
    overflow: hidden;
    border-bottom: 1px solid var(--border, rgba(255, 255, 255, 0.07));
    background: radial-gradient(circle at 50% 0%, rgba(230, 48, 0, 0.1) 0%, transparent 70%);
  }

  .modules-hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .modules-glow {
    position: absolute;
    top: -30%;
    left: 50%;
    transform: translateX(-50%);
    width: 700px;
    height: 700px;
    background: radial-gradient(circle, var(--primary-glow) 0%, transparent 65%);
    filter: blur(40px);
  }

  .modules-hero-container {
    position: relative;
    z-index: 1;
    max-width: 950px;
    margin: 0 auto;
    text-align: center;
    padding: 0 1.5rem;
  }

  .modules-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(230, 48, 0, 0.12);
    border: 1px solid var(--border-fire, rgba(230, 48, 0, 0.35));
    color: var(--primary-light, #FF4A1A);
    padding: 0.4rem 1.2rem;
    border-radius: var(--radius-full, 9999px);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }

  .modules-hero h1 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(2.8rem, 6.5vw, 4.75rem);
    line-height: 1.05;
    letter-spacing: 0.02em;
    margin-bottom: 1.25rem;
    color: #FFFFFF;
  }

  .text-fire {
    color: var(--primary);
    background: linear-gradient(135deg, #FF4A1A 0%, var(--primary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 1.15rem;
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 780px;
    margin: 0 auto 2.25rem;
  }

  .hero-cta-group {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .btn-hero-primary {
    background: var(--gradient-fire, linear-gradient(135deg, #E63000 0%, #A82200 100%));
    color: #FFFFFF;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 700;
    font-size: 1rem;
    padding: 1rem 2rem;
    border: none;
    border-radius: var(--radius-sm, 8px);
    cursor: pointer;
    transition: var(--transition-fast);
    box-shadow: 0 4px 20px rgba(230, 48, 0, 0.4);
  }

  .btn-hero-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 25px rgba(230, 48, 0, 0.55);
  }

  .btn-hero-secondary {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #FFFFFF;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 600;
    font-size: 1rem;
    padding: 1rem 2rem;
    border-radius: var(--radius-sm, 8px);
    text-decoration: none;
    transition: var(--transition-fast);
  }

  .btn-hero-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: #FFFFFF;
  }

  /* Pillars Section */
  .pillars-section {
    padding: 5rem 1.5rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .section-header {
    margin-bottom: 3.5rem;
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    color: #FFFFFF;
    margin-bottom: 0.75rem;
  }

  .section-desc {
    font-size: 1rem;
    color: var(--text-muted);
    max-width: 700px;
    margin: 0 auto;
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .pillar-card {
    background: rgba(20, 20, 20, 0.6);
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 16px);
    padding: 2rem;
    transition: var(--transition-fast);
  }

  .pillar-card:hover {
    border-color: var(--border-fire);
    transform: translateY(-4px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }

  .pillar-icon {
    background: rgba(230, 48, 0, 0.12);
    width: 56px;
    height: 56px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .pillar-card h3 {
    font-size: 1.2rem;
    color: #FFFFFF;
    margin-bottom: 0.6rem;
    font-weight: 700;
  }

  .pillar-card p {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* Sectors Grid */
  .sectors-section {
    padding: 2rem 1.5rem 6rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .sectors-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }

  .sector-card {
    background: rgba(17, 17, 17, 0.85);
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 16px);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    transition: var(--transition-fast);
  }

  .sector-card:hover {
    border-color: var(--border-fire);
    transform: translateY(-4px);
  }

  .sector-badge {
    align-self: flex-start;
    background: rgba(230, 48, 0, 0.12);
    border: 1px solid var(--border-fire);
    color: var(--primary-light, #FF4A1A);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    margin-bottom: 1rem;
  }

  .sector-card h3 {
    font-size: 1.25rem;
    color: #FFFFFF;
    margin-bottom: 0.6rem;
    font-weight: 700;
  }

  .sector-card p {
    font-size: 0.925rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .sector-features {
    list-style: none;
    padding: 0;
    margin: auto 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 1rem;
  }

  .sector-features li {
    font-size: 0.85rem;
    color: #CBD5E1;
    position: relative;
    padding-left: 1.25rem;
  }

  .sector-features li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--primary);
    font-weight: bold;
  }

  /* CTA Banner */
  .cta-banner-section {
    max-width: 1100px;
    margin: 0 auto 6rem;
    padding: 0 1.5rem;
  }

  .cta-banner-box {
    background: linear-gradient(135deg, rgba(25, 20, 20, 0.95) 0%, rgba(35, 20, 20, 0.95) 100%);
    border: 1px solid var(--border-fire, rgba(230, 48, 0, 0.35));
    border-radius: var(--radius-lg, 24px);
    padding: 3.5rem 3rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2.5rem;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
  }

  .cta-content h2 {
    font-size: 2.25rem;
    color: #FFFFFF;
    margin-bottom: 0.75rem;
    line-height: 1.1;
  }

  .cta-content p {
    font-size: 1rem;
    color: var(--text-muted);
    margin: 0;
    max-width: 580px;
  }

  .cta-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex-shrink: 0;
  }

  .btn-primary-action {
    background: var(--gradient-fire, linear-gradient(135deg, #E63000 0%, #A82200 100%));
    color: #FFFFFF;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 700;
    font-size: 1rem;
    padding: 1rem 1.75rem;
    border: none;
    border-radius: var(--radius-sm, 8px);
    cursor: pointer;
    transition: var(--transition-fast);
    box-shadow: 0 4px 15px rgba(230, 48, 0, 0.35);
    white-space: nowrap;
  }

  .btn-primary-action:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(230, 48, 0, 0.5);
  }

  .btn-secondary-action {
    background: transparent;
    color: #FFFFFF;
    border: 1px solid var(--border-light, rgba(255, 255, 255, 0.2));
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.85rem 1.75rem;
    border-radius: var(--radius-sm, 8px);
    text-decoration: none;
    text-align: center;
    transition: var(--transition-fast);
  }

  .btn-secondary-action:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: #FFFFFF;
  }

  /* Responsive Design */
  @media (max-width: 992px) {
    .cta-banner-box {
      flex-direction: column;
      text-align: center;
      padding: 2.5rem 2rem;
    }
    .cta-actions {
      width: 100%;
      max-width: 400px;
    }
  }

  @media (max-width: 640px) {
    .hero-cta-group {
      flex-direction: column;
    }
    .btn-hero-primary, .btn-hero-secondary {
      width: 100%;
    }
  }
</style>
