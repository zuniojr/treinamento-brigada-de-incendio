---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---

<Layout title="Página Não Encontrada | Treinamento de Brigada de Incêndio">
  <Header />
  
  <main style="min-height: 60vh; display: flex; align-items: center; justify-content: center; padding: 4.5rem 1rem 4rem 1rem;">
    <div style="text-align: center; max-width: 600px;">
      <span class="badge-alert" style="margin-bottom: 1rem;">
        <span class="dot"></span>
        <span>Erro 404</span>
      </span>
      <h1 style="font-size: 3rem; font-weight: 800; margin-bottom: 1rem;">Página Não Encontrada</h1>
      <p style="color: var(--text-muted); font-size: 1.1rem; margin-bottom: 2rem;">
        A página que você está procurando pode ter sido removida ou o endereço está incorreto.
      </p>
      <a href="/" class="btn btn-primary">
        <span>Voltar para a Página Inicial</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
      </a>
    </div>
  </main>

  <Footer />
  <WhatsAppButton />
</Layout>
