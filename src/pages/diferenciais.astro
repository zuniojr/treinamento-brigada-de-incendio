---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Differentials from '../components/Differentials.astro';
import WhyInvest from '../components/WhyInvest.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import QuoteModal from '../components/QuoteModal.astro';
---

<Layout 
  title="Diferenciais & Por Que Nos Escolher | Treinamento de Brigada de Incêndio"
  description="Conheça os diferenciais técnicos, corpo docente especializado, metodologia prática e razões estratégicas para contratar o treinamento de brigada corporativa."
>
  <Header />

  <main id="main-content" class="diferenciais-page">
    <!-- Hero da Página Diferenciais -->
    <section class="diff-page-hero">
      <div class="diff-hero-bg">
        <div class="diff-glow"></div>
        <div class="diff-pattern"></div>
      </div>

      <div class="container diff-hero-container" data-animate>
        <div class="diff-badge">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
          <span>EXCELÊNCIA & SEGURANÇA CORPORATIVA</span>
        </div>

        <h1 class="font-display diff-page-title">
          DIFERENCIAIS QUE TRANSFORMAM <span class="text-fire">RISCO EM PROTEÇÃO</span>
        </h1>

        <p class="diff-page-subtitle">
          Descubra como nossa metodologia in-company com simulação prática de combate a incêndio, homologação oficial e instrutores experientes eleva o padrão de segurança da sua organização.
        </p>
      </div>
    </section>

    <!-- Componente Principal de Diferenciais -->
    <Differentials />

    <!-- Destaque dos Pilares de Qualidade -->
    <section class="section-padding pillars-section">
      <div class="container">
        <div class="section-header" data-animate>
          <span class="section-subtitle">Padrões de Alta Performance</span>
          <h2 class="section-title">Os 4 Pilares da Nossa Formação Prática</h2>
          <p class="section-desc">Instalações, equipamentos e métodos preparados para simular cenários reais de emergência.</p>
        </div>

        <div class="pillars-grid" data-animate>
          <div class="pillar-card">
            <div class="pillar-num">01</div>
            <h3>Simulador de Fogo Real</h3>
            <p>Os brigadistas vivenciam a extinção de chamas controladas em ambiente seguro, aprendendo o manuseio exato de extintores e mangueiras.</p>
          </div>

          <div class="pillar-card">
            <div class="pillar-num">02</div>
            <h3>Engenheiros & Bombeiros</h3>
            <p>Aulas conduzidas por profissionais com vivência real em resgate, primeiros socorros e inspeção técnica de edificações.</p>
          </div>

          <div class="pillar-card">
            <div class="pillar-num">03</div>
            <h3>Conformidade NR-23 & NBR 14276</h3>
            <p>Todo o conteúdo é constantemente revisado de acordo com as normas estaduais e federais exigidas pelo Corpo de Bombeiros.</p>
          </div>

          <div class="pillar-card">
            <div class="pillar-num">04</div>
            <h3>Certificação Ágil & Válida</h3>
            <p>Emissão de certificados individuais para cada colaborador e Laudo de Brigada para o estabelecimento em prazos céleres.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Componente Por Que Investir -->
    <WhyInvest />

    <!-- Chamada para Ação -->
    <CTASection />
  </main>

  <Footer />
  <WhatsAppButton />
  <QuoteModal />
</Layout>

<style>
  .diferenciais-page {
    padding-top: 0;
  }

  .diff-page-hero {
    position: relative;
    padding: 4.5rem 0 3.5rem 0;
    background: radial-gradient(circle at 50% 0%, #1c0600 0%, var(--bg-main) 75%);
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }

  .diff-hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .diff-glow {
    position: absolute;
    top: -120px;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 400px;
    background: radial-gradient(circle, rgba(230, 48, 0, 0.22) 0%, transparent 70%);
    filter: blur(80px);
  }

  .diff-pattern {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse at center, black 40%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 40%, transparent 80%);
  }

  .diff-hero-container {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 860px;
  }

  .diff-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    background: var(--primary-dim);
    border: 1px solid var(--primary-border);
    color: var(--primary-light);
    border-radius: var(--radius-full);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    margin-bottom: 1.5rem;
  }

  .diff-page-title {
    font-size: clamp(2.5rem, 5.5vw, 4.2rem);
    line-height: 1.05;
    margin-bottom: 1.25rem;
  }

  .text-fire {
    background: linear-gradient(135deg, #FFFFFF 0%, var(--primary-light) 60%, var(--accent-alert) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .diff-page-subtitle {
    font-size: 1.15rem;
    color: var(--text-muted);
    line-height: 1.65;
    max-width: 760px;
    margin: 0 auto;
  }

  /* Pillars section */
  .pillars-section {
    background-color: var(--bg-elevated);
    border-bottom: 1px solid var(--border);
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-top: 3rem;
  }

  .pillar-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    position: relative;
    transition: var(--transition);
  }

  .pillar-card:hover {
    border-color: var(--primary-border);
    transform: translateY(-4px);
    box-shadow: var(--shadow-card);
  }

  .pillar-num {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2.2rem;
    color: var(--primary-light);
    line-height: 1;
    margin-bottom: 0.75rem;
  }

  .pillar-card h3 {
    font-size: 1.1rem;
    margin-bottom: 0.6rem;
  }

  .pillar-card p {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.55;
  }

  @media (max-width: 992px) {
    .pillars-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 576px) {
    .pillars-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
